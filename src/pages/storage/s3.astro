---
import Layout from '../../layouts/Layout.astro';
import S3Diagram from '../../components/diagrams/S3Diagram.astro';
import S3LifecycleAnimation from '../../components/diagrams/S3LifecycleAnimation.astro';
---
<Layout title="S3">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <p class="text-sm text-gray-500 mb-2"><a href="/" class="hover:text-orange-500">ホーム</a> / <a href="/storage" class="hover:text-orange-500">ストレージ</a> / S3</p>
    <h1 class="text-3xl font-bold mb-2">Amazon S3</h1>
    <p class="text-gray-500 mb-10">オブジェクトストレージ・ストレージクラス・ライフサイクル</p>

    <section class="mb-12">
      <h2 class="text-xl font-bold mb-6 pb-2 border-b border-gray-200 dark:border-gray-700">ライフサイクルアニメーション</h2>
      <S3LifecycleAnimation />
    </section>

    <section class="mb-12">
      <h2 class="text-xl font-bold mb-6 pb-2 border-b border-gray-200 dark:border-gray-700">S3 図解</h2>
      <S3Diagram />
    </section>
  </div>
</Layout>