---
import Layout from '../../layouts/Layout.astro';

const services = [
  { title: 'EC2', description: 'インスタンスタイプ・購入オプション・Auto Scaling', href: '/compute/ec2', badge: '分野2・4' },
  { title: 'Lambda', description: 'サーバーレス・イベント駆動・15分制限', href: '/compute/lambda', badge: '分野2・3' },
  { title: 'Fargate / ECS', description: 'コンテナ・サーバーレス起動タイプ', href: '/compute/fargate', badge: '分野2・3' },
  { title: 'Auto Scaling', description: 'スケーリングポリシー・最小/希望/最大', href: '/compute/autoscaling', badge: '分野2' },
];
---

<Layout title="コンピューティング">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <p class="text-sm text-gray-500 mb-2"><a href="/" class="hover:text-orange-500">ホーム</a> / コンピューティング</p>
    <h1 class="text-3xl font-bold mb-2">コンピューティング</h1>
    <p class="text-gray-500 mb-10">EC2・Lambda・Fargate・ECS・Auto Scaling</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {services.map(({ title, description, href, badge }) => (
        <a href={href} class="border border-gray-200 dark:border-gray-700 rounded-xl p-5 hover:border-orange-500 hover:scale-105 transition-all block">
          <div class="flex items-start justify-between gap-2 mb-2">
            <h2 class="font-bold text-base">{title}</h2>
            <span class="text-xs bg-yellow-50 text-yellow-700 px-2 py-0.5 rounded-full shrink-0">{badge}</span>
          </div>
          <p class="text-sm text-gray-500">{description}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>