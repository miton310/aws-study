---
import Layout from '../../layouts/Layout.astro';

const services = [
  { title: 'RDS / Aurora', description: 'マルチAZ・リードレプリカ・RDS Proxy', href: '/database/rds', badge: '分野3' },
  { title: 'DynamoDB', description: 'NoSQL・DAX・Streams・GSI・LSI', href: '/database/dynamodb', badge: '分野3' },
  { title: 'ElastiCache', description: 'Redis vs Memcached・キャッシュ戦略', href: '/database/elasticache', badge: '分野3' },
];
---

<Layout title="データベース">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <p class="text-sm text-gray-500 mb-2"><a href="/" class="hover:text-orange-500">ホーム</a> / データベース</p>
    <h1 class="text-3xl font-bold mb-2">データベース</h1>
    <p class="text-gray-500 mb-10">RDS・Aurora・DynamoDB・ElastiCache</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {services.map(({ title, description, href, badge }) => (
        <a href={href} class="border border-gray-200 dark:border-gray-700 rounded-xl p-5 hover:border-orange-500 hover:scale-105 transition-all block">
          <div class="flex items-start justify-between gap-2 mb-2">
            <h2 class="font-bold text-base">{title}</h2>
            <span class="text-xs bg-green-50 text-green-700 px-2 py-0.5 rounded-full shrink-0">{badge}</span>
          </div>
          <p class="text-sm text-gray-500">{description}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>