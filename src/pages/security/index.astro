---
import Layout from '../../layouts/Layout.astro';

const services = [
  { title: 'IAM', description: 'ユーザー・ロール・ポリシー・SCP・Cognito', href: '/security/iam', badge: '分野1（30%）' },
  { title: 'KMS', description: '暗号化キー管理・S3暗号化3種', href: '/security/kms', badge: '分野1' },
  { title: 'WAF / Shield', description: 'DDoS対策・L7フィルタリング', href: '/security/waf', badge: '分野1' },
  { title: 'GuardDuty / Inspector / Macie', description: '脅威検出・脆弱性スキャン・機密データ検出', href: '/security/guardduty', badge: '分野1' },
];
---

<Layout title="セキュリティ">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <p class="text-sm text-gray-500 mb-2"><a href="/" class="hover:text-orange-500">ホーム</a> / セキュリティ</p>
    <h1 class="text-3xl font-bold mb-2">セキュリティ</h1>
    <p class="text-gray-500 mb-10">IAM・KMS・WAF・Shield・GuardDuty</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {services.map(({ title, description, href, badge }) => (
        <a href={href} class="border border-gray-200 dark:border-gray-700 rounded-xl p-5 hover:border-orange-500 hover:scale-105 transition-all block">
          <div class="flex items-start justify-between gap-2 mb-2">
            <h2 class="font-bold text-base">{title}</h2>
            <span class="text-xs bg-red-50 text-red-700 px-2 py-0.5 rounded-full shrink-0">{badge}</span>
          </div>
          <p class="text-sm text-gray-500">{description}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>