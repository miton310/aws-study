---
import Layout from "../../../layouts/Layout.astro";
import PublicIpDiagram from "../../../components/diagrams/PublicIpDiagram.astro";
import PrivateIpDiagram from "../../../components/diagrams/PrivateIpDiagram.astro";
---

<Layout title="IPアドレス - VPC">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <p class="text-sm text-gray-500 mb-2">
      <a href="/" class="hover:text-orange-500">ホーム</a> / <a
        href="/network"
        class="hover:text-orange-500">ネットワーク</a
      > / <a href="/network/vpc" class="hover:text-orange-500">VPC</a> / IPアドレス
    </p>
    <h1 class="text-3xl font-bold mb-2">IPアドレス</h1>
    <p class="text-gray-500 mb-10">
      パブリックIP / Elastic IP / プライベートIP / CIDR
    </p>

    <section class="mb-12">
      <h2 class="heading-section">パブリックIP・Elastic IP</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-4">
        パブリックIPとElastic
        IPの違い、ライフサイクル、IGWによるアドレス変換の仕組みを確認できます。
      </p>
      <PublicIpDiagram />
    </section>

    <section class="mb-12">
      <h2 class="heading-section">プライベートIP・CIDR</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-4">
        プライベートIPの割り当て、ライフサイクル、NATアドレス変換、CIDRの計算方法を確認できます。
      </p>
      <PrivateIpDiagram />
    </section>
  </div>
</Layout>
