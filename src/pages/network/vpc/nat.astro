---
import Layout from "../../../layouts/Layout.astro";
import NatGatewayAnimation from "../../../components/diagrams/NatGatewayAnimation.astro";
import NatInstanceDiagram from "../../../components/diagrams/NatInstanceDiagram.astro";
---

<Layout title="NAT Gateway・NATインスタンス - VPC">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <p class="text-sm text-gray-500 mb-2">
      <a href="/" class="hover:text-orange-500">ホーム</a> / <a
        href="/network"
        class="hover:text-orange-500">ネットワーク</a
      > / <a href="/network/vpc" class="hover:text-orange-500">VPC</a> / NAT
    </p>
    <h1 class="text-3xl font-bold mb-2">NAT Gateway・NATインスタンス</h1>
    <p class="text-gray-500 mb-10">
      プライベートサブネットからインターネットへの接続方法
    </p>

    <section class="mb-12">
      <h2 class="heading-section">NAT Gateway</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-4">
        プライベートサブネットのEC2がインターネットにアクセスするための設定をステップごとに確認できます。
      </p>
      <NatGatewayAnimation />
    </section>

    <section class="mb-12">
      <h2 class="heading-section">NAT Gateway通信フロー</h2>
      <div class="bg-white border border-gray-200 rounded-lg p-8">
        <p class="text-center font-medium mb-4">
          NAT Gateway：プライベートサブネット→インターネット
        </p>
        <div class="flex flex-col items-center gap-0">
          <!-- インターネット -->
          <div
            class="rounded-lg bg-[#F1EFE8] border border-[#D3D1C7] px-8 py-2 text-center text-[#2C2C2A] text-sm"
          >
            インターネット
          </div>
          <div class="text-[#1D9E75] text-lg leading-none">↕</div>
          <!-- IGW -->
          <div
            class="rounded-lg bg-[#E1F5EE] border border-[#0F6E56] px-8 py-2 text-center text-[#085041] text-sm"
          >
            Internet Gateway
          </div>
          <div class="text-[#1D9E75] text-lg leading-none">↕</div>
          <!-- NAT Gateway -->
          <div
            class="rounded-lg bg-[#9FE1CB] border border-[#0F6E56] px-6 py-3 text-center"
          >
            <p class="font-medium text-[#04342C] text-sm">NAT Gateway</p>
            <p class="text-xs text-[#085041]">パブリックサブネットに配置</p>
          </div>
          <div class="text-[#854F0B] text-lg leading-none">↕</div>
          <!-- プライベートEC2 -->
          <div
            class="rounded-lg bg-[#FAEEDA] border border-[#854F0B] px-6 py-3 text-center"
          >
            <p class="font-medium text-[#412402] text-sm">プライベートEC2</p>
            <p class="text-xs text-[#633806]">
              インターネットには出られるが入れない
            </p>
          </div>
        </div>

        <!-- Egress-Only IGW -->
        <div
          class="mt-6 rounded-lg bg-[#EEEDFE] border border-[#534AB7] px-4 py-3 text-center"
        >
          <p class="font-medium text-[#3C3489] text-sm">
            Egress-Only Internet Gateway
          </p>
          <p class="text-xs text-[#534AB7]">
            IPv6専用のNAT GW的機能・アウトバウンドのみ許可（インバウンド不可）
          </p>
        </div>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="heading-section">
        NATインスタンス：ポート転送と NAT Gateway との違い
      </h2>
      <p class="text-gray-600 dark:text-gray-400 mb-4">
        NATインスタンスの特徴・ポート転送の仕組み・NAT
        Gatewayとの使い分けを確認できます。
      </p>
      <NatInstanceDiagram />
    </section>
  </div>
</Layout>
