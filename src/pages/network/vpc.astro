---
import Layout from '../../layouts/Layout.astro';
import VpcDiagram from '../../components/diagrams/VpcDiagram.astro';
import VpcAnimationDiagram from '../../components/diagrams/VpcAnimationDiagram.astro';
import NaclSgFlowAnimation from '../../components/diagrams/NaclSgFlowAnimation.astro';
import SgNaclAnimation from '../../components/diagrams/SgNaclAnimation.astro';
---
<Layout title="VPC">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <p class="text-sm text-gray-500 mb-2"><a href="/" class="hover:text-orange-500">ホーム</a> / <a href="/network" class="hover:text-orange-500">ネットワーク</a> / VPC</p>
    <h1 class="text-3xl font-bold mb-2">VPC（Virtual Private Cloud）</h1>
    <p class="text-gray-500 mb-10">サブネット・SG・NACL・NAT Gateway・VPC Endpoint</p>

    <section class="mb-12">
      <h2 class="heading-section">SG(セキュリティグループ)とNACL(Network ACL)の違い：HTTP通信を許可する設定</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-4">EC2へのHTTP(80)アクセスを許可する際の、セキュリティグループとNACLの動作の違いを確認できます。</p>
      <SgNaclAnimation />
    </section>

    <section class="mb-12">
      <h2 class="heading-section">通信フローアニメーション</h2>
      <VpcAnimationDiagram />
    </section>

    <section class="mb-12">
      <h2 class="heading-section">NACL・SG 通信フロー</h2>
      <NaclSgFlowAnimation />
    </section>

    <section class="mb-12">
      <h2 class="heading-section">VPC 図解</h2>
      <VpcDiagram />
    </section>
  </div>
</Layout>