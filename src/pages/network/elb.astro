---
import Layout from '../../layouts/Layout.astro';
import ELBDiagram from '../../components/diagrams/ELBDiagram.astro';
import ELBAnimationDiagram from '../../components/diagrams/ELBAnimationDiagram.astro';
---
<Layout title="ELB">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <p class="text-sm text-gray-500 mb-2"><a href="/" class="hover:text-orange-500">ホーム</a> / <a href="/network" class="hover:text-orange-500">ネットワーク</a> / ELB</p>
    <h1 class="text-3xl font-bold mb-2">ELB（Elastic Load Balancing）</h1>
    <p class="text-gray-500 mb-10">ALB・NLB・GWLB の使い分けと仕組み</p>

    <section class="mb-12">
      <h2 class="heading-section">通信フローアニメーション</h2>
      <ELBAnimationDiagram />
    </section>

    <section class="mb-12">
      <h2 class="heading-section">ELB 図解</h2>
      <ELBDiagram />
    </section>
  </div>
</Layout>