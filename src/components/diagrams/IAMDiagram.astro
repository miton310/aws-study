  <div id="iam-pattern" class="tab-panel">
    <h3 class="section-title">SAA頻出パターン</h3>
    <div class="note-box overflow-hidden text-lg p-0">
      <table class="w-full">
        <tbody class="divide-y divide-[#854F0B]/20">
          <tr><td class="px-4 py-2 text-[#633806]">「EC2からS3にアクセスしたい」</td><td class="px-4 py-2 font-bold text-[#412402]">→ IAMロールをEC2にアタッチ</td></tr>
          <tr><td class="px-4 py-2 text-[#633806]">「全アカウントで特定リージョン禁止」</td><td class="px-4 py-2 font-bold text-[#412402]">→ ルートにSCPを設定</td></tr>
          <tr><td class="px-4 py-2 text-[#633806]">「開発者に権限委任・上限を設けたい」</td><td class="px-4 py-2 font-bold text-[#412402]">→ 権限境界（Permission Boundary）</td></tr>
          <tr><td class="px-4 py-2 text-[#633806]">「複数アカウントをSSOで一元管理」</td><td class="px-4 py-2 font-bold text-[#412402]">→ IAM Identity Center</td></tr>
          <tr><td class="px-4 py-2 text-[#633806]">「企業ADでAWSにSSOログイン」</td><td class="px-4 py-2 font-bold text-[#412402]">→ SAML + Identity Center</td></tr>
          <tr><td class="px-4 py-2 text-[#633806]">「モバイルアプリからS3に直接アクセス」</td><td class="px-4 py-2 font-bold text-[#412402]">→ Cognito IDプール</td></tr>
          <tr><td class="px-4 py-2 text-[#633806]">「別アカウントのリソースにアクセス」</td><td class="px-4 py-2 font-bold text-[#412402]">→ クロスアカウントロール</td></tr>
          <tr><td class="px-4 py-2 text-[#633806]">「ルートユーザーを守りたい」</td><td class="px-4 py-2 font-bold text-[#412402]">→ MFA必須・アクセスキーを作らない</td></tr>
          <tr><td class="px-4 py-2 text-[#633806]">「IAMポリシーで許可しても動かない」</td><td class="px-4 py-2 font-bold text-[#412402]">→ SCPか権限境界で制限されている</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  function iamTab(t: string) {
    document.querySelectorAll('[id^="iam-"]').forEach(el => el.classList.remove('active'));
    document.getElementById('iam-' + t)?.classList.add('active');
    document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
    (event?.target as HTMLElement)?.classList.add('active');
  }
  (window as any).iamTab = iamTab;
</script>