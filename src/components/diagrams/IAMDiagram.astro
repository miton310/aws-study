---
---
<div>
  <div class="tab-btn-group">
    <button class="tab-btn active" onclick="iamTab('overview')">全体構造</button>
    <button class="tab-btn" onclick="iamTab('policy')">ポリシー評価</button>
    <button class="tab-btn" onclick="iamTab('role')">ロールの仕組み</button>
    <button class="tab-btn" onclick="iamTab('org')">Organizations・SCP</button>
    <button class="tab-btn" onclick="iamTab('role_vs_key')">ロール vs アクセスキー</button>
    <button class="tab-btn" onclick="iamTab('eval')">ポリシー評価順序</button>
    <button class="tab-btn" onclick="iamTab('pattern')">頻出パターン</button>
  </div>

  <div id="iam-overview" class="tab-panel active">
    <svg width="100%" viewBox="0 0 680 400">
      <defs><marker id="iam-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">IAM の全体構造</text>
      <rect x="30" y="44" width="620" height="340" rx="14" fill="none" stroke="#1D9E75" stroke-width="1.5" stroke-dasharray="8 4"/>
      <text x="46" y="64" font-size="12" fill="#085041">AWS アカウント</text>
      <rect x="255" y="72" width="170" height="56" rx="8" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
      <text x="340" y="96" text-anchor="middle" font-size="13" font-weight="500" fill="#791F1F">ルートユーザー</text>
      <text x="340" y="116" text-anchor="middle" font-size="11" fill="#A32D2D">全権限・通常は使わない・MFA必須</text>
      <rect x="50"  y="172" width="130" height="56" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/>
      <text x="115" y="196" text-anchor="middle" font-size="13" font-weight="500" fill="#0C447C">IAMユーザー</text>
      <text x="115" y="214" text-anchor="middle" font-size="11" fill="#185FA5">人間・長期認証情報</text>
      <rect x="210" y="172" width="130" height="56" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/>
      <text x="275" y="196" text-anchor="middle" font-size="13" font-weight="500" fill="#0C447C">IAMグループ</text>
      <text x="275" y="214" text-anchor="middle" font-size="11" fill="#185FA5">ユーザーの集合</text>
      <rect x="370" y="172" width="130" height="56" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="435" y="196" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489">IAMロール</text>
      <text x="435" y="214" text-anchor="middle" font-size="11" fill="#534AB7">一時認証情報</text>
      <rect x="520" y="172" width="110" height="56" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="575" y="196" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">ポリシー</text>
      <text x="575" y="214" text-anchor="middle" font-size="11" fill="#854F0B">権限の定義</text>
      <line x1="300" y1="128" x2="180" y2="172" stroke="#A32D2D" stroke-width="1" stroke-dasharray="4 2"/>
      <line x1="320" y1="128" x2="275" y2="172" stroke="#A32D2D" stroke-width="1" stroke-dasharray="4 2"/>
      <line x1="360" y1="128" x2="435" y2="172" stroke="#A32D2D" stroke-width="1" stroke-dasharray="4 2"/>
      <line x1="520" y1="200" x2="500" y2="200" stroke="#854F0B" stroke-width="1.5" marker-end="url(#iam-arr)"/>
      <rect x="50"  y="290" width="120" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="110" y="316" text-anchor="middle" font-size="12" fill="#085041">EC2</text>
      <rect x="200" y="290" width="120" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="260" y="316" text-anchor="middle" font-size="12" fill="#085041">Lambda</text>
      <rect x="350" y="290" width="120" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="410" y="316" text-anchor="middle" font-size="12" fill="#085041">ECS タスク</text>
      <rect x="500" y="290" width="120" height="44" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="560" y="316" text-anchor="middle" font-size="12" fill="#5F5E5A">外部ユーザー</text>
      <line x1="410" y1="228" x2="160" y2="290" stroke="#534AB7" stroke-width="1.5" stroke-dasharray="5 3" marker-end="url(#iam-arr)"/>
      <line x1="435" y1="228" x2="280" y2="290" stroke="#534AB7" stroke-width="1.5" stroke-dasharray="5 3" marker-end="url(#iam-arr)"/>
      <line x1="450" y1="228" x2="420" y2="290" stroke="#534AB7" stroke-width="1.5" stroke-dasharray="5 3" marker-end="url(#iam-arr)"/>
      <line x1="460" y1="228" x2="540" y2="290" stroke="#534AB7" stroke-width="1.5" stroke-dasharray="5 3" marker-end="url(#iam-arr)"/>
      <rect x="30" y="352" width="620" height="24" rx="6" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="368" text-anchor="middle" font-size="11" font-weight="500" fill="#633806">ベストプラクティス：ルートはMFA必須・EC2からS3アクセスは必ずIAMロール</text>
    </svg>
  </div>

  <div id="iam-policy" class="tab-panel">
    <svg width="100%" viewBox="0 0 680 380">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">ポリシー評価順序：明示的DENYが最優先</text>
      <rect x="190" y="48" width="300" height="52" rx="8" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
      <text x="340" y="70" text-anchor="middle" font-size="13" font-weight="500" fill="#791F1F">1. 明示的 DENY があるか？</text>
      <text x="340" y="90" text-anchor="middle" font-size="11" fill="#A32D2D">1つでもDenyがあれば即アクセス拒否</text>
      <line x1="340" y1="100" x2="340" y2="128" stroke="#888780" stroke-width="1.5" marker-end="url(#iam-arr2)"/>
      <rect x="190" y="130" width="300" height="52" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="340" y="152" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">2. SCPで許可されているか？</text>
      <text x="340" y="172" text-anchor="middle" font-size="11" fill="#085041">Organizationsのガードレール</text>
      <line x1="340" y1="182" x2="340" y2="210" stroke="#888780" stroke-width="1.5" marker-end="url(#iam-arr2)"/>
      <rect x="190" y="212" width="300" height="52" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="340" y="234" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">3. リソースポリシーで許可？</text>
      <text x="340" y="254" text-anchor="middle" font-size="11" fill="#085041">S3バケットポリシーなど</text>
      <line x1="340" y1="264" x2="340" y2="292" stroke="#888780" stroke-width="1.5" marker-end="url(#iam-arr2)"/>
      <rect x="190" y="294" width="300" height="52" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="340" y="316" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">4. IAMポリシーで許可？</text>
      <text x="340" y="336" text-anchor="middle" font-size="11" fill="#085041">アイデンティティポリシー</text>
      <rect x="520" y="130" width="120" height="36" rx="6" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
      <text x="580" y="152" text-anchor="middle" font-size="12" fill="#791F1F">暗黙のDENY</text>
      <line x1="490" y1="156" x2="520" y2="152" stroke="#E24B4A" stroke-width="1.5" stroke-dasharray="4 2" marker-end="url(#iam-arr2)"/>
      <line x1="490" y1="238" x2="520" y2="152" stroke="#E24B4A" stroke-width="1.5" stroke-dasharray="4 2" marker-end="url(#iam-arr2)"/>
      <line x1="490" y1="320" x2="520" y2="152" stroke="#E24B4A" stroke-width="1.5" stroke-dasharray="4 2" marker-end="url(#iam-arr2)"/>
      <defs><marker id="iam-arr2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
    </svg>
  </div>

  <div id="iam-role" class="tab-panel">
    <svg width="100%" viewBox="0 0 680 360">
      <defs><marker id="iam-arr3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">IAMロール：AssumeRoleと一時認証情報</text>
      <rect x="40"  y="60" width="140" height="56" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/>
      <text x="110" y="84" text-anchor="middle" font-size="13" font-weight="500" fill="#0C447C">アクター</text>
      <text x="110" y="102" text-anchor="middle" font-size="11" fill="#185FA5">EC2 / Lambda / 人</text>
      <line x1="180" y1="88" x2="238" y2="88" stroke="#185FA5" stroke-width="1.5" marker-end="url(#iam-arr3)"/>
      <text x="209" y="80" text-anchor="middle" font-size="11" fill="#185FA5">AssumeRole</text>
      <rect x="240" y="60" width="140" height="56" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="310" y="84" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489">AWS STS</text>
      <text x="310" y="102" text-anchor="middle" font-size="11" fill="#534AB7">一時認証情報を発行</text>
      <line x1="380" y1="88" x2="438" y2="88" stroke="#3B6D11" stroke-width="1.5" marker-end="url(#iam-arr3)"/>
      <text x="409" y="80" text-anchor="middle" font-size="11" fill="#3B6D11">発行</text>
      <rect x="440" y="60" width="140" height="56" rx="8" fill="#EAF3DE" stroke="#3B6D11" stroke-width="0.5"/>
      <text x="510" y="84" text-anchor="middle" font-size="13" font-weight="500" fill="#27500A">一時認証情報</text>
      <text x="510" y="102" text-anchor="middle" font-size="11" fill="#3B6D11">数時間で自動失効</text>
      <rect x="40"  y="180" width="270" height="100" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="175" y="206" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489">IAMロール（推奨）</text>
      <text x="175" y="230" text-anchor="middle" font-size="12" fill="#534AB7">一時認証情報・自動失効</text>
      <text x="175" y="252" text-anchor="middle" font-size="12" fill="#534AB7">キー管理不要・安全</text>
      <rect x="370" y="180" width="270" height="100" rx="8" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
      <text x="505" y="206" text-anchor="middle" font-size="13" font-weight="500" fill="#791F1F">アクセスキー（非推奨）</text>
      <text x="505" y="230" text-anchor="middle" font-size="12" fill="#A32D2D">長期認証情報・漏洩リスク</text>
      <text x="505" y="252" text-anchor="middle" font-size="12" fill="#A32D2D">定期ローテーション必要</text>
      <rect x="40" y="300" width="600" height="44" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="326" text-anchor="middle" font-size="12" font-weight="500" fill="#633806">EC2からS3にアクセスするときは必ずIAMロール（コードにアクセスキーを書かない）</text>
    </svg>
  </div>

  <div id="iam-org" class="tab-panel">
    <svg width="100%" viewBox="0 0 680 380">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">Organizations + SCP：複数アカウントのガードレール</text>
      <rect x="40" y="44" width="600" height="200" rx="14" fill="none" stroke="#993C1D" stroke-width="2" stroke-dasharray="8 4"/>
      <text x="56" y="66" font-size="12" fill="#993C1D">SCP が許可する最大範囲</text>
      <rect x="100" y="84" width="480" height="140" rx="12" fill="none" stroke="#534AB7" stroke-width="1.5" stroke-dasharray="6 3"/>
      <text x="116" y="104" font-size="12" fill="#534AB7">IAMポリシーが許可する範囲</text>
      <rect x="200" y="120" width="280" height="80" rx="10" fill="#EAF3DE" stroke="#3B6D11" stroke-width="0.5"/>
      <text x="340" y="152" text-anchor="middle" font-size="13" font-weight="500" fill="#27500A">実際に使える権限</text>
      <text x="340" y="176" text-anchor="middle" font-size="12" fill="#3B6D11">SCP と IAMポリシーの AND</text>
      <rect x="40" y="262" width="600" height="100" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="286" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">SAA頻出ポイント</text>
      <text x="60" y="310" font-size="12" fill="#633806">・SCPはガードレール：IAMで許可しても SCPで禁止なら実行不可</text>
      <text x="60" y="332" font-size="12" fill="#633806">・管理アカウント（Masterアカウント）にはSCPが適用されない</text>
      <text x="60" y="354" font-size="12" fill="#633806">・「全アカウントで東京以外を禁止」→ ルートにSCPを設定</text>
    </svg>
  </div>

  <div id="iam-role_vs_key" class="tab-panel">
    <svg width="100%" viewBox="0 0 680 440">
      <defs><marker id="iam-r-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">アクセスキー方式 vs IAMロール方式</text>

      <!-- LEFT: Access Key (Bad) -->
      <rect x="40" y="44" width="270" height="32" rx="6" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
      <text x="175" y="64" text-anchor="middle" font-size="13" font-weight="500" fill="#791F1F">❌ アクセスキー方式（非推奨）</text>

      <rect x="60" y="92" width="230" height="52" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
      <text x="175" y="114" text-anchor="middle" font-size="13" font-weight="500" fill="#712B13" dominant-baseline="central">カスタム AMI</text>
      <text x="175" y="134" text-anchor="middle" font-size="11" fill="#993C1D" dominant-baseline="central">テキストファイルにキーを格納</text>

      <line x1="175" y1="144" x2="175" y2="170" stroke="#E24B4A" stroke-width="1.5" marker-end="url(#iam-r-arr)"/>

      <rect x="60" y="172" width="230" height="52" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
      <text x="175" y="194" text-anchor="middle" font-size="13" font-weight="500" fill="#712B13" dominant-baseline="central">EC2 インスタンス</text>
      <text x="175" y="214" text-anchor="middle" font-size="11" fill="#993C1D" dominant-baseline="central">キーをファイルから読み込む</text>

      <line x1="175" y1="224" x2="175" y2="250" stroke="#E24B4A" stroke-width="1.5" marker-end="url(#iam-r-arr)"/>

      <rect x="60" y="252" width="230" height="52" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
      <text x="175" y="274" text-anchor="middle" font-size="13" font-weight="500" fill="#712B13" dominant-baseline="central">DynamoDB</text>
      <text x="175" y="294" text-anchor="middle" font-size="11" fill="#993C1D" dominant-baseline="central">アクセスキーで認証</text>

      <rect x="60" y="322" width="230" height="88" rx="8" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
      <text x="175" y="344" text-anchor="middle" font-size="12" font-weight="500" fill="#791F1F">リスク</text>
      <text x="175" y="364" text-anchor="middle" font-size="11" fill="#A32D2D">・AMI流出 → キー漏洩</text>
      <text x="175" y="382" text-anchor="middle" font-size="11" fill="#A32D2D">・キーのローテーション管理が必要</text>
      <text x="175" y="400" text-anchor="middle" font-size="11" fill="#A32D2D">・単一障害点になりやすい</text>

      <!-- RIGHT: IAM Role (Good) -->
      <rect x="370" y="44" width="270" height="32" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="505" y="64" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">✅ IAMロール方式（推奨）</text>

      <rect x="390" y="92" width="230" height="52" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="505" y="114" text-anchor="middle" font-size="13" font-weight="500" fill="#085041" dominant-baseline="central">IAM ロール</text>
      <text x="505" y="134" text-anchor="middle" font-size="11" fill="#085041" dominant-baseline="central">DynamoDB アクセス権限を付与</text>

      <line x1="505" y1="144" x2="505" y2="170" stroke="#1D9E75" stroke-width="1.5" marker-end="url(#iam-r-arr)"/>
      <text x="525" y="160" font-size="11" fill="#085041">アタッチ</text>

      <rect x="390" y="172" width="230" height="52" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="505" y="194" text-anchor="middle" font-size="13" font-weight="500" fill="#085041" dominant-baseline="central">EC2 インスタンス</text>
      <text x="505" y="214" text-anchor="middle" font-size="11" fill="#085041" dominant-baseline="central">ロールがアタッチされている</text>

      <line x1="505" y1="224" x2="505" y2="250" stroke="#1D9E75" stroke-width="1.5" marker-end="url(#iam-r-arr)"/>

      <rect x="390" y="252" width="230" height="52" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="505" y="274" text-anchor="middle" font-size="13" font-weight="500" fill="#085041" dominant-baseline="central">DynamoDB</text>
      <text x="505" y="294" text-anchor="middle" font-size="11" fill="#085041" dominant-baseline="central">一時クレデンシャルで認証</text>

      <rect x="390" y="322" width="230" height="88" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="505" y="344" text-anchor="middle" font-size="12" font-weight="500" fill="#085041">メリット</text>
      <text x="505" y="364" text-anchor="middle" font-size="11" fill="#085041">・キーの保存が不要</text>
      <text x="505" y="382" text-anchor="middle" font-size="11" fill="#085041">・漏洩リスクがゼロ</text>
      <text x="505" y="400" text-anchor="middle" font-size="11" fill="#085041">・一時クレデンシャルが自動更新</text>
    </svg>
    <div class="note-box font-bold">
      「EC2からAWSサービスにアクセスしたい」→ 必ずIAMロール
    </div>
  </div>

  <!-- ポリシー評価順序 -->
  <div id="iam-eval" class="tab-panel">
    <svg width="100%" viewBox="0 0 680 450">
      <defs><marker id="iam-e-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">ポリシー評価順序：上から順に判定される</text>

      <!-- Step 1: 明示的DENY -->
      <rect x="190" y="48" width="300" height="52" rx="8" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
      <text x="340" y="70" text-anchor="middle" font-size="13" font-weight="500" fill="#791F1F" dominant-baseline="central">1. 明示的 DENY があるか？</text>
      <text x="340" y="90" text-anchor="middle" font-size="11" fill="#A32D2D" dominant-baseline="central">どこか1つでもDenyがあれば即アクセス拒否</text>
      <line x1="340" y1="100" x2="340" y2="128" stroke="#888780" stroke-width="1.5" marker-end="url(#iam-e-arr)"/>
      <text x="372" y="118" font-size="11" fill="#A32D2D">YES → 拒否</text>

      <!-- Step 2: SCP -->
      <rect x="190" y="130" width="300" height="52" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="340" y="152" text-anchor="middle" font-size="13" font-weight="500" fill="#085041" dominant-baseline="central">2. SCP で許可されているか？</text>
      <text x="340" y="172" text-anchor="middle" font-size="11" fill="#085041" dominant-baseline="central">Organizationsのポリシー境界</text>
