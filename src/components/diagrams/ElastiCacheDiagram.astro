---
---
<div>
  <style>
    .ec-btn{cursor:pointer;font-size:12px;padding:4px 12px;border-radius:6px;border:1px solid #e5e7eb;background:#f9fafb;color:#111827;font-family:inherit;}
    .dark .ec-btn{border-color:#374151;background:#1f2937;color:#f9fafb;}
    .ec-btn.active{background:#534AB7;color:#fff;border-color:#534AB7;}
    .ec-panel{display:none;}
    .ec-panel.active{display:block;}
  </style>

  <div style="display:flex;gap:6px;margin:0 0 10px;flex-wrap:wrap">
    <button class="ec-btn active" onclick="ecTab('overview')">ElastiCacheとは</button>
    <button class="ec-btn" onclick="ecTab('compare')">Redis vs Memcached</button>
    <button class="ec-btn" onclick="ecTab('pattern')">キャッシュ戦略</button>
  </div>

  <div id="ec-overview" class="ec-panel active">
    <svg width="100%" viewBox="0 0 680 380">
      <defs><marker id="ec-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">Amazon ElastiCache：インメモリキャッシュでDBを高速化</text>
      <text x="160" y="52" text-anchor="middle" font-size="12" fill="#A32D2D">キャッシュなし（毎回DBアクセス）</text>
      <rect x="40"  y="62" width="100" height="44" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="90" y="88" text-anchor="middle" font-size="12" fill="#2C2C2A">アプリ</text>
      <line x1="140" y1="84" x2="178" y2="84" stroke="#E24B4A" stroke-width="2" marker-end="url(#ec-arr)"/>
      <text x="159" y="76" text-anchor="middle" font-size="11" fill="#A32D2D">毎回</text>
      <rect x="180" y="62" width="100" height="44" rx="6" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/><text x="230" y="88" text-anchor="middle" font-size="12" fill="#0C447C">RDS</text>
      <text x="160" y="122" text-anchor="middle" font-size="11" fill="#A32D2D">レイテンシー高・DB負荷大</text>
      <text x="510" y="52" text-anchor="middle" font-size="12" fill="#085041">キャッシュあり（高速）</text>
      <rect x="360" y="62" width="100" height="44" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="410" y="88" text-anchor="middle" font-size="12" fill="#2C2C2A">アプリ</text>
      <line x1="460" y1="76" x2="498" y2="76" stroke="#1D9E75" stroke-width="2" marker-end="url(#ec-arr)"/>
      <rect x="500" y="50" width="140" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="570" y="68" text-anchor="middle" font-size="12" fill="#085041">ElastiCache</text><text x="570" y="84" text-anchor="middle" font-size="11" fill="#085041">キャッシュヒット</text>
      <line x1="570" y1="94" x2="570" y2="118" stroke="#1D9E75" stroke-width="1.5" stroke-dasharray="4 2" marker-end="url(#ec-arr)"/>
      <rect x="500" y="120" width="140" height="44" rx="6" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/><text x="570" y="140" text-anchor="middle" font-size="12" fill="#0C447C">RDS</text><text x="570" y="156" text-anchor="middle" font-size="11" fill="#185FA5">ミスのみアクセス</text>
      <text x="510" y="184" text-anchor="middle" font-size="11" fill="#085041">ミリ秒以下・DB負荷激減</text>
      <text x="340" y="216" text-anchor="middle" font-size="13" font-weight="500" fill="currentColor">主なユースケース</text>
      <rect x="40"  y="230" width="180" height="56" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="130" y="252" text-anchor="middle" font-size="12" fill="#085041">セッション管理</text><text x="130" y="274" text-anchor="middle" font-size="11" fill="#085041">ログイン状態の保持</text>
      <rect x="250" y="230" width="180" height="56" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="340" y="252" text-anchor="middle" font-size="12" fill="#085041">DBクエリキャッシュ</text><text x="340" y="274" text-anchor="middle" font-size="11" fill="#085041">頻繁に読まれるデータ</text>
      <rect x="460" y="230" width="180" height="56" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="550" y="252" text-anchor="middle" font-size="12" fill="#085041">リアルタイムランキング</text><text x="550" y="274" text-anchor="middle" font-size="11" fill="#085041">Redis Sorted Set</text>
      <rect x="40" y="306" width="600" height="56" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="330" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">SAA頻出ポイント</text>
      <text x="60" y="352" font-size="12" fill="#633806">「DBのレイテンシーを下げたい」→ ElastiCache（Redis推奨）　「セッションをEC2間で共有」→ ElastiCache</text>
    </svg>
  </div>

  <div id="ec-compare" class="ec-panel">
    <svg width="100%" viewBox="0 0 680 360">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">Redis vs Memcached：どちらを選ぶか</text>
      <rect x="40"  y="50" width="200" height="36" rx="4" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="140" y="72" text-anchor="middle" font-size="12" font-weight="500" fill="#2C2C2A">比較項目</text>
      <rect x="250" y="50" width="180" height="36" rx="4" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/><text x="340" y="72" text-anchor="middle" font-size="12" font-weight="500" fill="#712B13">Redis</text>
      <rect x="440" y="50" width="200" height="36" rx="4" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/><text x="540" y="72" text-anchor="middle" font-size="12" font-weight="500" fill="#0C447C">Memcached</text>
      <rect x="40"  y="86" width="200" height="36" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="140" y="108" text-anchor="middle" font-size="12" fill="#5F5E5A">データ永続化</text>
      <rect x="250" y="86" width="180" height="36" fill="#FAECE7" stroke="#F5C4B3" stroke-width="0.5"/><text x="340" y="108" text-anchor="middle" font-size="12" fill="#712B13">✅ あり</text>
      <rect x="440" y="86" width="200" height="36" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="540" y="108" text-anchor="middle" font-size="12" fill="#A32D2D">✕ なし</text>
      <rect x="40"  y="122" width="200" height="36" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="140" y="144" text-anchor="middle" font-size="12" fill="#5F5E5A">マルチAZ</text>
      <rect x="250" y="122" width="180" height="36" fill="#FAECE7" stroke="#F5C4B3" stroke-width="0.5"/><text x="340" y="144" text-anchor="middle" font-size="12" fill="#712B13">✅ あり</text>
      <rect x="440" y="122" width="200" height="36" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="540" y="144" text-anchor="middle" font-size="12" fill="#A32D2D">✕ なし</text>
      <rect x="40"  y="158" width="200" height="36" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="140" y="180" text-anchor="middle" font-size="12" fill="#5F5E5A">データ構造</text>
      <rect x="250" y="158" width="180" height="36" fill="#FAECE7" stroke="#F5C4B3" stroke-width="0.5"/><text x="340" y="180" text-anchor="middle" font-size="12" fill="#712B13">多様（Set・List等）</text>
      <rect x="440" y="158" width="200" height="36" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="540" y="180" text-anchor="middle" font-size="12" fill="#2C2C2A">Key-Valueのみ</text>
      <rect x="40"  y="194" width="200" height="36" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="140" y="216" text-anchor="middle" font-size="12" fill="#5F5E5A">読み取りレプリカ</text>
      <rect x="250" y="194" width="180" height="36" fill="#FAECE7" stroke="#F5C4B3" stroke-width="0.5"/><text x="340" y="216" text-anchor="middle" font-size="12" fill="#712B13">✅ あり</text>
      <rect x="440" y="194" width="200" height="36" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="540" y="216" text-anchor="middle" font-size="12" fill="#A32D2D">✕ なし</text>
      <rect x="40"  y="230" width="200" height="36" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="140" y="252" text-anchor="middle" font-size="12" fill="#5F5E5A">マルチスレッド</text>
      <rect x="250" y="230" width="180" height="36" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="340" y="252" text-anchor="middle" font-size="12" fill="#2C2C2A">シングル</text>
      <rect x="440" y="230" width="200" height="36" fill="#E6F1FB" stroke="#B5D4F4" stroke-width="0.5"/><text x="540" y="252" text-anchor="middle" font-size="12" fill="#0C447C">✅ マルチ</text>
      <rect x="40" y="284" width="600" height="56" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="308" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">SAA頻出の選び方</text>
      <text x="60" y="330" font-size="12" fill="#633806">Redis：永続化・マルチAZ・Pub-Sub・ランキング・セッション管理　迷ったら Redis</text>
    </svg>
  </div>

  <div id="ec-pattern" class="ec-panel">
    <svg width="100%" viewBox="0 0 680 340">
      <defs><marker id="ec-arr2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">キャッシュ戦略：Lazy Loading vs Write Through</text>
      <text x="160" y="52" text-anchor="middle" font-size="12" font-weight="500" fill="#534AB7">Lazy Loading（読み取り時にキャッシュ）</text>
      <rect x="40" y="62" width="280" height="170" rx="10" fill="none" stroke="#534AB7" stroke-width="1" stroke-dasharray="5 3"/>
      <rect x="60"  y="80" width="80" height="36" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="100" y="102" text-anchor="middle" font-size="12" fill="#2C2C2A">アプリ</text>
      <line x1="140" y1="98" x2="178" y2="98" stroke="#888780" stroke-width="1.5" marker-end="url(#ec-arr2)"/>
      <rect x="180" y="80" width="120" height="36" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="240" y="98" text-anchor="middle" font-size="11" fill="#085041">Cache確認</text>
      <text x="130" y="138" text-anchor="middle" font-size="11" fill="#085041">ヒット→即返す</text>
      <line x1="180" y1="116" x2="130" y2="148" stroke="#1D9E75" stroke-width="1.5" stroke-dasharray="4 2" marker-end="url(#ec-arr2)"/>
      <text x="270" y="138" text-anchor="middle" font-size="11" fill="#A32D2D">ミス→DB取得</text>
      <line x1="300" y1="116" x2="240" y2="160" stroke="#E24B4A" stroke-width="1.5" marker-end="url(#ec-arr2)"/>
      <rect x="180" y="162" width="120" height="36" rx="6" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/><text x="240" y="184" text-anchor="middle" font-size="11" fill="#0C447C">DB→Cache保存</text>
      <rect x="56" y="214" width="248" height="14" rx="4" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="180" y="225" text-anchor="middle" font-size="10" fill="#534AB7">読まれないデータはキャッシュしない</text>
      <text x="510" y="52" text-anchor="middle" font-size="12" font-weight="500" fill="#993C1D">Write Through（書き込み時にキャッシュ）</text>
      <rect x="360" y="62" width="280" height="170" rx="10" fill="none" stroke="#993C1D" stroke-width="1" stroke-dasharray="5 3"/>
      <rect x="380" y="80" width="80" height="36" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="420" y="102" text-anchor="middle" font-size="12" fill="#2C2C2A">アプリ</text>
      <line x1="460" y1="98" x2="498" y2="98" stroke="#888780" stroke-width="1.5" marker-end="url(#ec-arr2)"/>
      <rect x="500" y="80" width="120" height="36" rx="6" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/><text x="560" y="102" text-anchor="middle" font-size="11" fill="#712B13">DB書き込み</text>
      <line x1="560" y1="116" x2="560" y2="148" stroke="#993C1D" stroke-width="1.5" marker-end="url(#ec-arr2)"/>
      <rect x="500" y="150" width="120" height="36" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="560" y="172" text-anchor="middle" font-size="11" fill="#085041">Cache同時更新</text>
      <rect x="376" y="214" width="248" height="14" rx="4" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
      <text x="500" y="225" text-anchor="middle" font-size="10" fill="#993C1D">常に最新データがキャッシュにある</text>
      <rect x="40" y="252" width="600" height="68" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="276" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">TTL（Time To Live）：キャッシュの有効期限</text>
      <text x="60" y="300" font-size="12" fill="#633806">短すぎ→DB負荷増　長すぎ→古いデータを返す可能性</text>
      <text x="60" y="318" font-size="12" fill="#633806">SAA頻出：「整合性を保ちながらキャッシュ」→ TTL + Write Throughの組み合わせ</text>
    </svg>
  </div>
</div>

<script>
  function ecTab(t: string) {
    document.querySelectorAll('[id^="ec-"]').forEach(el => el.classList.remove('active'));
    document.getElementById('ec-' + t)?.classList.add('active');
    document.querySelectorAll('.ec-btn').forEach(el => el.classList.remove('active'));
    (event?.target as HTMLElement)?.classList.add('active');
  }
  (window as any).ecTab = ecTab;
</script>