---
---
<div>
  <style>
    .lmd-btn{cursor:pointer;font-size:12px;padding:4px 12px;border-radius:6px;border:1px solid #e5e7eb;background:#f9fafb;color:#111827;font-family:inherit;}
    .dark .lmd-btn{border-color:#374151;background:#1f2937;color:#f9fafb;}
    .lmd-btn.active{background:#534AB7;color:#fff;border-color:#534AB7;}
    .lmd-panel{display:none;}
    .lmd-panel.active{display:block;}
  </style>

  <div style="display:flex;gap:6px;margin:0 0 10px;flex-wrap:wrap">
    <button class="lmd-btn active" onclick="lmdTab('overview')">Lambdaとは</button>
    <button class="lmd-btn" onclick="lmdTab('trigger')">トリガー</button>
    <button class="lmd-btn" onclick="lmdTab('limit')">制限・設定値</button>
    <button class="lmd-btn" onclick="lmdTab('pattern')">頻出パターン</button>
  </div>

  <div id="lmd-overview" class="lmd-panel active">
    <svg width="100%" viewBox="0 0 680 360">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">AWS Lambda：サーバー管理不要・イベント駆動で実行</text>
      <rect x="40"  y="50" width="240" height="120" rx="8" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
      <text x="160" y="78" text-anchor="middle" font-size="13" font-weight="500" fill="#791F1F">EC2（従来）</text>
      <text x="160" y="102" text-anchor="middle" font-size="12" fill="#A32D2D">24時間365日起動</text>
      <text x="160" y="124" text-anchor="middle" font-size="12" fill="#A32D2D">アイドル時も課金</text>
      <text x="160" y="146" text-anchor="middle" font-size="12" fill="#A32D2D">スケール設定が必要</text>
      <rect x="400" y="50" width="240" height="120" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="520" y="78" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">Lambda（サーバーレス）</text>
      <text x="520" y="102" text-anchor="middle" font-size="12" fill="#085041">イベント発生時のみ実行</text>
      <text x="520" y="124" text-anchor="middle" font-size="12" fill="#085041">実行時間・回数だけ課金</text>
      <text x="520" y="146" text-anchor="middle" font-size="12" fill="#085041">自動スケール</text>
      <rect x="40" y="196" width="600" height="56" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="340" y="220" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489">Lambdaの基本スペック</text>
      <text x="340" y="242" text-anchor="middle" font-size="12" fill="#534AB7">最大実行時間15分・メモリ128MB〜10GB・同時実行数デフォルト1000</text>
      <rect x="40" y="272" width="600" height="68" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="296" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">コールドスタート問題</text>
      <text x="60" y="320" font-size="12" fill="#633806">初回実行時にコンテナ起動のため遅延が発生（数百ms〜数秒）</text>
      <text x="60" y="338" font-size="12" fill="#633806">対策：Provisioned Concurrency（事前にコンテナを起動しておく）</text>
    </svg>
  </div>

  <div id="lmd-trigger" class="lmd-panel">
    <svg width="100%" viewBox="0 0 680 380">
      <defs><marker id="lmd-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">Lambdaのイベントトリガー</text>
      <rect x="270" y="160" width="140" height="56" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="340" y="184" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489">Lambda関数</text>
      <text x="340" y="204" text-anchor="middle" font-size="11" fill="#534AB7">コードを実行</text>
      <rect x="40"  y="46" width="140" height="44" rx="6" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/><text x="110" y="72" text-anchor="middle" font-size="12" fill="#0C447C">API Gateway</text>
      <rect x="40"  y="110" width="140" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="110" y="136" text-anchor="middle" font-size="12" fill="#085041">S3</text>
      <rect x="40"  y="174" width="140" height="44" rx="6" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/><text x="110" y="200" text-anchor="middle" font-size="12" fill="#712B13">SQS</text>
      <rect x="40"  y="238" width="140" height="44" rx="6" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/><text x="110" y="264" text-anchor="middle" font-size="12" fill="#633806">EventBridge</text>
      <rect x="40"  y="302" width="140" height="44" rx="6" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/><text x="110" y="328" text-anchor="middle" font-size="12" fill="#3C3489">DynamoDB Streams</text>
      <line x1="180" y1="68"  x2="270" y2="178" stroke="#185FA5" stroke-width="1.5" marker-end="url(#lmd-arr)"/>
      <line x1="180" y1="132" x2="270" y2="182" stroke="#0F6E56" stroke-width="1.5" marker-end="url(#lmd-arr)"/>
      <line x1="180" y1="196" x2="270" y2="188" stroke="#993C1D" stroke-width="1.5" marker-end="url(#lmd-arr)"/>
      <line x1="180" y1="260" x2="270" y2="194" stroke="#854F0B" stroke-width="1.5" marker-end="url(#lmd-arr)"/>
      <line x1="180" y1="324" x2="270" y2="200" stroke="#534AB7" stroke-width="1.5" marker-end="url(#lmd-arr)"/>
      <rect x="500" y="46"  width="140" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="570" y="72" text-anchor="middle" font-size="12" fill="#085041">DynamoDB</text>
      <rect x="500" y="110" width="140" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="570" y="136" text-anchor="middle" font-size="12" fill="#085041">S3（出力）</text>
      <rect x="500" y="174" width="140" height="44" rx="6" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/><text x="570" y="200" text-anchor="middle" font-size="12" fill="#712B13">SNS（通知）</text>
      <rect x="500" y="238" width="140" height="44" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="570" y="264" text-anchor="middle" font-size="12" fill="#5F5E5A">RDS（Proxy経由）</text>
      <line x1="410" y1="178" x2="500" y2="68"  stroke="#534AB7" stroke-width="1.5" marker-end="url(#lmd-arr)"/>
      <line x1="410" y1="184" x2="500" y2="132" stroke="#534AB7" stroke-width="1.5" marker-end="url(#lmd-arr)"/>
      <line x1="410" y1="190" x2="500" y2="196" stroke="#534AB7" stroke-width="1.5" marker-end="url(#lmd-arr)"/>
      <line x1="410" y1="196" x2="500" y2="260" stroke="#534AB7" stroke-width="1.5" marker-end="url(#lmd-arr)"/>
    </svg>
  </div>

  <div id="lmd-limit" class="lmd-panel">
    <svg width="100%" viewBox="0 0 680 340">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">Lambda の制限・設定値（SAA頻出）</text>
      <rect x="40"  y="44" width="200" height="36" rx="4" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="140" y="66" text-anchor="middle" font-size="12" font-weight="500" fill="#2C2C2A">項目</text>
      <rect x="250" y="44" width="180" height="36" rx="4" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="340" y="66" text-anchor="middle" font-size="12" font-weight="500" fill="#2C2C2A">値</text>
      <rect x="440" y="44" width="200" height="36" rx="4" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="540" y="66" text-anchor="middle" font-size="12" font-weight="500" fill="#2C2C2A">注意点</text>
      <rect x="40"  y="80" width="200" height="34" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="140" y="100" text-anchor="middle" font-size="12" fill="#2C2C2A">最大実行時間</text>
      <rect x="250" y="80" width="180" height="34" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="340" y="100" text-anchor="middle" font-size="12" fill="#2C2C2A">15分</text>
      <rect x="440" y="80" width="200" height="34" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="540" y="100" text-anchor="middle" font-size="12" fill="#A32D2D">超えたらECS/Fargate</text>
      <rect x="40"  y="114" width="200" height="34" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="140" y="134" text-anchor="middle" font-size="12" fill="#2C2C2A">メモリ</text>
      <rect x="250" y="114" width="180" height="34" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="340" y="134" text-anchor="middle" font-size="12" fill="#2C2C2A">128MB〜10GB</text>
      <rect x="440" y="114" width="200" height="34" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="540" y="134" text-anchor="middle" font-size="12" fill="#2C2C2A">CPUはメモリに比例</text>
      <rect x="40"  y="148" width="200" height="34" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="140" y="168" text-anchor="middle" font-size="12" fill="#2C2C2A">同時実行数</text>
      <rect x="250" y="148" width="180" height="34" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="340" y="168" text-anchor="middle" font-size="12" fill="#2C2C2A">デフォルト1000</text>
      <rect x="440" y="148" width="200" height="34" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="540" y="168" text-anchor="middle" font-size="12" fill="#2C2C2A">上限緩和申請可能</text>
      <rect x="40"  y="182" width="200" height="34" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="140" y="202" text-anchor="middle" font-size="12" fill="#2C2C2A">デプロイパッケージ</text>
      <rect x="250" y="182" width="180" height="34" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="340" y="202" text-anchor="middle" font-size="12" fill="#2C2C2A">50MB(zip)/250MB</text>
      <rect x="440" y="182" width="200" height="34" fill="#F9F8F4" stroke="#D3D1C7" stroke-width="0.5"/><text x="540" y="202" text-anchor="middle" font-size="12" fill="#2C2C2A">大きい場合はコンテナ</text>
      <rect x="40" y="236" width="600" height="80" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="260" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">SAA最重要：15分を超える処理はECS / Fargate / Batchを使う</text>
      <text x="340" y="284" text-anchor="middle" font-size="12" fill="#633806">「サーバーレス・イベント駆動・15分以内」→ Lambda が正解パターン</text>
    </svg>
  </div>

  <div id="lmd-pattern" class="lmd-panel">
    <svg width="100%" viewBox="0 0 680 340">
      <defs><marker id="lmd-arr2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">SAA頻出パターン</text>
      <rect x="40"  y="50" width="90" height="44" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="85"  y="76" text-anchor="middle" font-size="12" fill="#2C2C2A">クライアント</text>
      <line x1="130" y1="72" x2="158" y2="72" stroke="#888780" stroke-width="1.5" marker-end="url(#lmd-arr2)"/>
      <rect x="160" y="50" width="100" height="44" rx="6" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/><text x="210" y="72" text-anchor="middle" font-size="11" fill="#0C447C">API Gateway</text>
      <line x1="260" y1="72" x2="288" y2="72" stroke="#185FA5" stroke-width="1.5" marker-end="url(#lmd-arr2)"/>
      <rect x="290" y="50" width="100" height="44" rx="6" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/><text x="340" y="76" text-anchor="middle" font-size="12" fill="#3C3489">Lambda</text>
      <line x1="390" y1="72" x2="418" y2="72" stroke="#534AB7" stroke-width="1.5" marker-end="url(#lmd-arr2)"/>
      <rect x="420" y="50" width="120" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="480" y="72" text-anchor="middle" font-size="11" fill="#085041">DynamoDB/RDS</text>
      <text x="340" y="114" text-anchor="middle" font-size="11" fill="#534AB7">サーバーレスAPI構成（最頻出）</text>
      <rect x="40"  y="134" width="100" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="90"  y="160" text-anchor="middle" font-size="12" fill="#085041">S3（画像）</text>
      <line x1="140" y1="156" x2="168" y2="156" stroke="#0F6E56" stroke-width="1.5" marker-end="url(#lmd-arr2)"/>
      <rect x="170" y="134" width="100" height="44" rx="6" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/><text x="220" y="160" text-anchor="middle" font-size="12" fill="#3C3489">Lambda</text>
      <line x1="270" y1="156" x2="298" y2="156" stroke="#534AB7" stroke-width="1.5" marker-end="url(#lmd-arr2)"/>
      <rect x="300" y="134" width="140" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="370" y="160" text-anchor="middle" font-size="12" fill="#085041">リサイズ→S3保存</text>
      <text x="340" y="198" text-anchor="middle" font-size="11" fill="#534AB7">S3イベントトリガー（ファイル処理）</text>
      <rect x="40"  y="218" width="100" height="44" rx="6" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/><text x="90"  y="244" text-anchor="middle" font-size="12" fill="#712B13">SQS</text>
      <line x1="140" y1="240" x2="168" y2="240" stroke="#993C1D" stroke-width="1.5" marker-end="url(#lmd-arr2)"/>
      <rect x="170" y="218" width="100" height="44" rx="6" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/><text x="220" y="244" text-anchor="middle" font-size="12" fill="#3C3489">Lambda</text>
      <line x1="270" y1="240" x2="298" y2="240" stroke="#534AB7" stroke-width="1.5" marker-end="url(#lmd-arr2)"/>
      <rect x="300" y="218" width="140" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="370" y="244" text-anchor="middle" font-size="12" fill="#085041">非同期バッチ処理</text>
      <text x="340" y="282" text-anchor="middle" font-size="11" fill="#534AB7">SQS → Lambda 非同期処理</text>
      <rect x="40" y="296" width="600" height="32" rx="6" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="316" text-anchor="middle" font-size="12" font-weight="500" fill="#633806">EventBridge + Lambda = 定期バッチ（cron/rate）</text>
    </svg>
  </div>
</div>

<script>
  function lmdTab(t: string) {
    document.querySelectorAll('[id^="lmd-"]').forEach(el => el.classList.remove('active'));
    document.getElementById('lmd-' + t)?.classList.add('active');
    document.querySelectorAll('.lmd-btn').forEach(el => el.classList.remove('active'));
    (event?.target as HTMLElement)?.classList.add('active');
  }
  (window as any).lmdTab = lmdTab;
</script>