---
/**
 * セキュリティグループとNACLの違い解説（統合版）
 * - シナリオ切り替え
 * - ステップごとの通信フロー解説
 */
---

<style>
  .sgn-container {
    font-family: inherit;
  }

  /* Buttons */
  .sgn-btn {
    cursor: pointer;
    font-size: 16px;
    padding: 6px 14px;
    border-radius: 6px;
    border: 1px solid #e5e7eb;
    background: #f9fafb;
    color: #111827;
    font-family: inherit;
    transition: all 0.2s;
  }
  .dark .sgn-btn {
    border-color: #374151;
    background: #1f2937;
    color: #f9fafb;
  }
  .sgn-btn:hover {
    background: #f3f4f6;
  }
  .dark .sgn-btn:hover {
    background: #374151;
  }
  .sgn-btn.active {
    background: #534ab7;
    color: #fff;
    border-color: #534ab7;
  }
  .sgn-btn.success {
    background: #059669;
    color: #fff;
    border-color: #059669;
  }
  .sgn-btn.fail {
    background: #dc2626;
    color: #fff;
    border-color: #dc2626;
  }
  .sgn-btn-nav {
    padding: 4px 12px;
  }

  /* Step display */
  .sgn-step-info {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 8px 0;
    font-size: 12px;
    color: #6b7280;
  }
  .sgn-step-desc {
    font-size: 14px;
    margin: 12px 0;
    padding: 12px 16px;
    border-radius: 8px;
    line-height: 1.7;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    min-height: 60px;
  }
  .dark .sgn-step-desc {
    background: #1e293b;
    border-color: #334155;
    color: #e2e8f0;
  }

  /* Legend */
  .sgn-legend {
    display: flex;
    gap: 16px;
    margin: 8px 0;
    font-size: 16px;
    color: #6b7280;
    flex-wrap: wrap;
  }
  .sgn-legend span {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .sgn-legend-box {
    width: 16px;
    height: 16px;
    border-radius: 3px;
  }

  /* Main diagram */
  .sgn-diagram {
    display: flex;
    align-items: stretch;
    gap: 0;
    padding: 16px 8px;
    overflow-x: auto;
  }

  /* Flow column */
  .sgn-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  /* Client box */
  .sgn-client {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px 14px;
    background: #f1f5f9;
    border: 1px solid #94a3b8;
    border-radius: 8px;
    min-width: 70px;
    transition: all 0.3s;
  }
  .dark .sgn-client {
    background: #334155;
    border-color: #64748b;
  }
  .sgn-client.highlight {
    box-shadow: 0 0 0 3px rgba(83, 74, 183, 0.3);
  }
  .sgn-client-icon {
    width: 40px;
    height: 40px;
    margin-bottom: 4px;
  }
  .sgn-client-label {
    font-size: 16px;
    font-weight: 500;
    color: #334155;
  }
  .dark .sgn-client-label {
    color: #e2e8f0;
  }
  .sgn-client-port {
    font-size: 12px;
    color: #64748b;
  }

  /* Arrow */
  .sgn-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 2px;
    min-width: 30px;
  }
  .sgn-arrow-line {
    width: 24px;
    height: 3px;
    border-radius: 2px;
    position: relative;
    transition: background 0.3s;
  }
  .sgn-arrow-line::after {
    content: "";
    position: absolute;
    right: -3px;
    top: 50%;
    transform: translateY(-50%);
    border: 4px solid transparent;
    transition: border-left-color 0.3s;
  }
  .sgn-arrow-line.green {
    background: #059669;
  }
  .sgn-arrow-line.green::after {
    border-left-color: #059669;
  }
  .sgn-arrow-line.red {
    background: #dc2626;
  }
  .sgn-arrow-line.red::after {
    border-left-color: #dc2626;
  }
  .sgn-arrow-line.gray {
    background: #d1d5db;
  }
  .sgn-arrow-line.gray::after {
    border-left-color: #d1d5db;
  }
  .sgn-arrow-label {
    font-size: 12px;
    color: #9ca3af;
    white-space: nowrap;
    margin-bottom: 2px;
  }

  /* VPC box */
  .sgn-vpc {
    display: flex;
    flex-direction: column;
    border: 2px dashed #3b82f6;
    border-radius: 12px;
    padding: 8px;
    background: rgba(239, 246, 255, 0.3);
  }
  .dark .sgn-vpc {
    background: rgba(30, 58, 138, 0.2);
    border-color: #60a5fa;
  }
  .sgn-vpc-header {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 6px;
    padding: 0 4px;
  }
  .sgn-vpc-header img {
    width: 40px;
    height: 40px;
  }
  .sgn-vpc-header span {
    font-size: 16px;
    font-weight: 500;
    color: #2563eb;
  }
  .dark .sgn-vpc-header span {
    color: #93c5fd;
  }

  /* Subnet box */
  .sgn-subnet {
    display: flex;
    flex-direction: column;
    border: 1px solid #93c5fd;
    border-radius: 8px;
    padding: 6px;
    background: #eff6ff;
  }
  .dark .sgn-subnet {
    background: rgba(30, 64, 175, 0.3);
    border-color: #60a5fa;
  }
  .sgn-subnet-header {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 6px;
    padding: 0 2px;
  }
  .sgn-subnet-header img {
    width: 14px;
    height: 14px;
  }
  .sgn-subnet-header span {
    font-size: 16px;
    color: #3b82f6;
  }
  .dark .sgn-subnet-header span {
    color: #93c5fd;
  }

  /* Flow row inside subnet */
  .sgn-flow {
    display: flex;
    align-items: center;
    gap: 0;
  }

  /* Gate (NACL/SG) */
  .sgn-gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6px 8px;
    border-radius: 6px;
    min-width: 50px;
    transition: all 0.3s;
  }
  .sgn-gate.highlight {
    box-shadow: 0 0 0 3px rgba(83, 74, 183, 0.4);
    transform: scale(1.05);
  }
  .sgn-gate.nacl {
    background: #f5f3ff;
    border: 1px solid #8b5cf6;
  }
  .dark .sgn-gate.nacl {
    background: rgba(91, 33, 182, 0.3);
    border-color: #a78bfa;
  }
  .sgn-gate.sg {
    background: #ecfdf5;
    border: 1px solid #10b981;
  }
  .dark .sgn-gate.sg {
    background: rgba(5, 150, 105, 0.2);
    border-color: #34d399;
  }
  .sgn-gate-icon {
    width: 36px;
    height: 36px;
    margin-bottom: 2px;
  }
  .sgn-gate-label {
    font-size: 16px;
    font-weight: 500;
  }
  .sgn-gate.nacl .sgn-gate-label {
    color: #7c3aed;
  }
  .dark .sgn-gate.nacl .sgn-gate-label {
    color: #c4b5fd;
  }
  .sgn-gate.sg .sgn-gate-label {
    color: #059669;
  }
  .dark .sgn-gate.sg .sgn-gate-label {
    color: #6ee7b7;
  }
  .sgn-gate-dir {
    font-size: 12px;
    color: #6b7280;
  }
  .sgn-gate-status {
    font-size: 14px;
    margin-top: 2px;
    transition: color 0.3s;
  }
  .sgn-gate-status.pass {
    color: #059669;
  }
  .sgn-gate-status.block {
    color: #dc2626;
  }
  .sgn-gate-status.gray {
    color: #9ca3af;
  }
  .sgn-gate-type {
    font-size: 12px;
    padding: 1px 4px;
    border-radius: 3px;
    margin-top: 2px;
  }
  .sgn-gate.nacl .sgn-gate-type {
    background: #ede9fe;
    color: #6d28d9;
  }
  .dark .sgn-gate.nacl .sgn-gate-type {
    background: rgba(91, 33, 182, 0.5);
    color: #c4b5fd;
  }
  .sgn-gate.sg .sgn-gate-type {
    background: #d1fae5;
    color: #065f46;
  }
  .dark .sgn-gate.sg .sgn-gate-type {
    background: rgba(5, 150, 105, 0.3);
    color: #6ee7b7;
  }

  /* EC2 */
  .sgn-ec2 {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8px 10px;
    background: #d1fae5;
    border: 1px solid #10b981;
    border-radius: 8px;
    transition: all 0.3s;
  }
  .dark .sgn-ec2 {
    background: rgba(5, 150, 105, 0.2);
    border-color: #34d399;
  }
  .sgn-ec2.highlight {
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.4);
    transform: scale(1.05);
  }
  .sgn-ec2-icon {
    width: 28px;
    height: 28px;
    margin-bottom: 2px;
  }
  .sgn-ec2-label {
    font-size: 16px;
    color: #065f46;
    text-align: center;
  }
  .dark .sgn-ec2-label {
    color: #6ee7b7;
  }

  /* Summary section */
  .sgn-summary {
    margin-top: 16px;
    padding: 12px 16px;
    background: #fefce8;
    border: 1px solid #fde047;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.6;
  }
  .dark .sgn-summary {
    background: rgba(250, 204, 21, 0.1);
    border-color: #ca8a04;
    color: #fef9c3;
  }
  .sgn-summary-title {
    font-weight: 600;
    margin-bottom: 8px;
    color: #854d0e;
  }
  .dark .sgn-summary-title {
    color: #fde047;
  }
</style>

<div class="sgn-container">
  <!-- Scenario selection -->
  <div style="margin-bottom:12px;">
    <div style="font-size:13px;color:#6b7280;margin-bottom:8px;">
      シナリオを選択：
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:8px;">
      <button
        class="sgn-btn success"
        id="sgn-scenario-1"
        onclick="sgnSetScenario(1)"
      >
        ✓ SGインバウンド許可（正解）
      </button>
      <button class="sgn-btn" id="sgn-scenario-2" onclick="sgnSetScenario(2)">
        NACLのみ設定
      </button>
      <button class="sgn-btn" id="sgn-scenario-3" onclick="sgnSetScenario(3)">
        SGアウトバウンド許可
      </button>
    </div>
  </div>

  <!-- Step navigation -->
  <div class="sgn-step-info">
    <button class="sgn-btn sgn-btn-nav" id="sgn-prev" onclick="sgnPrev()"
      >◀ 前へ</button
    >
    <button class="sgn-btn sgn-btn-nav" id="sgn-next" onclick="sgnNext()"
      >次へ ▶</button
    >
    <span id="sgn-step-num">1 / 5</span>
  </div>

  <!-- Step description -->
  <div id="sgn-step-desc" class="sgn-step-desc"></div>

  <!-- Legend -->
  <div class="sgn-legend">
    <span
      ><div class="sgn-legend-box" style="background:#059669;"></div> 通過</span
    >
    <span
      ><div class="sgn-legend-box" style="background:#dc2626;"></div> ブロック</span
    >
    <span
      ><div class="sgn-legend-box" style="background:#d1d5db;"></div> 未到達</span
    >
  </div>

  <!-- Diagram -->
  <div class="sgn-diagram">
    <!-- Client (sender) -->
    <div class="sgn-col">
      <div id="sgn-client-send" class="sgn-client">
        <img
          class="sgn-client-icon"
          src="/AWS-icons/Resource-Icons_07312025/Res_General-Icons/Res_48_Light/Res_Internet-alt2_48_Light.svg"
          alt="client"
        />
        <div class="sgn-client-label">クライアント</div>
        <div class="sgn-client-port">HTTP :80</div>
      </div>
    </div>

    <!-- Arrow -->
    <div class="sgn-col">
      <div class="sgn-arrow">
        <div class="sgn-arrow-label">REQ</div>
        <div id="sgn-arr-1" class="sgn-arrow-line green"></div>
      </div>
    </div>

    <!-- VPC -->
    <div class="sgn-col">
      <div class="sgn-vpc">
        <div class="sgn-vpc-header">
          <img src="/icons/Aws-Vpc--Streamline-Svg-Logos.svg" alt="VPC" />
          <span>VPC</span>
        </div>

        <div class="sgn-subnet">
          <div class="sgn-subnet-header">
            <img
              src="/AWS-icons/Architecture-Group-Icons_07312025/Private-subnet_32.png"
              alt="subnet"
            />
            <span>パブリックサブネット</span>
          </div>

          <div class="sgn-flow">
            <!-- NACL IN -->
            <div id="sgn-nacl-in" class="sgn-gate nacl">
              <img
                class="sgn-gate-icon"
                src="/AWS-icons/Resource-Icons_07312025/Res_General-Icons/Res_48_Light/Res_Firewall_48_Light.svg"
                alt="NACL"
              />
              <div class="sgn-gate-label">NACL</div>
              <div class="sgn-gate-dir">IN</div>
              <div id="sgn-nacl-in-status" class="sgn-gate-status pass">✓</div>
              <div class="sgn-gate-type">ステートレス</div>
            </div>

            <div class="sgn-arrow">
              <div id="sgn-arr-2" class="sgn-arrow-line green"></div>
            </div>

            <!-- SG IN -->
            <div id="sgn-sg-in" class="sgn-gate sg">
              <img
                class="sgn-gate-icon"
                src="/AWS-icons/Resource-Icons_07312025/Res_General-Icons/Res_48_Light/Res_Firewall_48_Light.svg"
                alt="SG"
              />
              <div class="sgn-gate-label">SG</div>
              <div class="sgn-gate-dir">IN</div>
              <div id="sgn-sg-in-status" class="sgn-gate-status pass">✓</div>
              <div class="sgn-gate-type">ステートフル</div>
            </div>

            <div class="sgn-arrow">
              <div id="sgn-arr-3" class="sgn-arrow-line green"></div>
            </div>

            <!-- EC2 -->
            <div id="sgn-ec2" class="sgn-ec2">
              <img
                class="sgn-ec2-icon"
                src="/AWS-icons/Architecture-Service-Icons_07312025/Arch_Compute/48/Arch_Amazon-EC2_48.svg"
                alt="EC2"
              />
              <div class="sgn-ec2-label">Web<br />サーバー</div>
            </div>

            <div class="sgn-arrow">
              <div id="sgn-arr-4" class="sgn-arrow-line green"></div>
            </div>

            <!-- SG OUT -->
            <div id="sgn-sg-out" class="sgn-gate sg">
              <img
                class="sgn-gate-icon"
                src="/AWS-icons/Resource-Icons_07312025/Res_General-Icons/Res_48_Light/Res_Firewall_48_Light.svg"
                alt="SG"
              />
              <div class="sgn-gate-label">SG</div>
              <div class="sgn-gate-dir">OUT</div>
              <div id="sgn-sg-out-status" class="sgn-gate-status pass">✓</div>
              <div class="sgn-gate-type">ステートフル</div>
            </div>

            <div class="sgn-arrow">
              <div id="sgn-arr-5" class="sgn-arrow-line green"></div>
            </div>

            <!-- NACL OUT -->
            <div id="sgn-nacl-out" class="sgn-gate nacl">
              <img
                class="sgn-gate-icon"
                src="/AWS-icons/Resource-Icons_07312025/Res_Networking-Content-Delivery/Res_Amazon-VPC_Network-Access-Control-List_48.svg"
                alt="NACL"
              />
              <div class="sgn-gate-label">NACL</div>
              <div class="sgn-gate-dir">OUT</div>
              <div id="sgn-nacl-out-status" class="sgn-gate-status pass">✓</div>
              <div class="sgn-gate-type">ステートレス</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Arrow -->
    <div class="sgn-col">
      <div class="sgn-arrow">
        <div class="sgn-arrow-label">RES</div>
        <div id="sgn-arr-6" class="sgn-arrow-line green"></div>
      </div>
    </div>

    <!-- Client (receiver) -->
    <div class="sgn-col">
      <div id="sgn-client-recv" class="sgn-client">
        <img
          class="sgn-client-icon"
          src="/AWS-icons/Resource-Icons_07312025/Res_General-Icons/Res_48_Light/Res_Internet-alt2_48_Light.svg"
          alt="client"
        />
        <div class="sgn-client-label">クライアント</div>
        <div class="sgn-client-port">受信</div>
      </div>
    </div>
  </div>

  <!-- Summary -->
  <div class="sgn-summary">
    <div class="sgn-summary-title">ポイント</div>
    <div id="sgn-summary-text">
      <strong>セキュリティグループはステートフル</strong
      >：インバウンドを許可すれば、戻り通信は自動許可。<br />
      <strong>NACLはステートレス</strong
      >：戻り通信（エフェメラルポート1024-65535）も明示的に許可が必要。<br />
      → デフォルトNACL（全許可）を使う場合、<strong
        >SGでインバウンド許可するだけでOK</strong
      >
    </div>
  </div>
</div>

<script>
  interface Step {
    highlight: string;
    desc: string;
    gates: { naclIn: string; sgIn: string; sgOut: string; naclOut: string };
    arrows: string[];
  }

  interface Scenario {
    success: boolean;
    steps: Step[];
    summary: string;
  }

  const SGN_SCENARIOS: Record<number, Scenario> = {
    1: {
      success: true,
      steps: [
        {
          highlight: "sgn-client-send",
          desc: "【STEP 1】クライアントからHTTP :80 リクエストを送信。",
          gates: {
            naclIn: "pass",
            sgIn: "pass",
            sgOut: "pass",
            naclOut: "pass",
          },
          arrows: ["green", "gray", "gray", "gray", "gray", "gray"],
        },
        {
          highlight: "sgn-nacl-in",
          desc: "【STEP 2】NACL IN：デフォルトで全許可 → <strong>通過 ✓</strong>",
          gates: {
            naclIn: "pass",
            sgIn: "pass",
            sgOut: "pass",
            naclOut: "pass",
          },
          arrows: ["green", "green", "gray", "gray", "gray", "gray"],
        },
        {
          highlight: "sgn-sg-in",
          desc: "【STEP 3】SG IN：ポート80を許可設定 → <strong>通過 ✓</strong>",
          gates: {
            naclIn: "pass",
            sgIn: "pass",
            sgOut: "pass",
            naclOut: "pass",
          },
          arrows: ["green", "green", "green", "gray", "gray", "gray"],
        },
        {
          highlight: "sgn-ec2",
          desc: "【STEP 4】EC2がリクエストを処理し、レスポンスを返す。",
          gates: {
            naclIn: "pass",
            sgIn: "pass",
            sgOut: "pass",
            naclOut: "pass",
          },
          arrows: ["green", "green", "green", "green", "gray", "gray"],
        },
        {
          highlight: "sgn-sg-out",
          desc: "【STEP 5】SG OUT：<strong>ステートフル</strong>なのでインバウンド許可の戻り通信は自動許可 → <strong>通過 ✓</strong>",
          gates: {
            naclIn: "pass",
            sgIn: "pass",
            sgOut: "pass",
            naclOut: "pass",
          },
          arrows: ["green", "green", "green", "green", "green", "gray"],
        },
        {
          highlight: "sgn-nacl-out",
          desc: "【STEP 6】NACL OUT：デフォルトで全許可 → <strong>通過 ✓</strong>",
          gates: {
            naclIn: "pass",
            sgIn: "pass",
            sgOut: "pass",
            naclOut: "pass",
          },
          arrows: ["green", "green", "green", "green", "green", "green"],
        },
        {
          highlight: "sgn-client-recv",
          desc: "【完了】クライアントがレスポンスを受信。<strong>通信成功！</strong>",
          gates: {
            naclIn: "pass",
            sgIn: "pass",
            sgOut: "pass",
            naclOut: "pass",
          },
          arrows: ["green", "green", "green", "green", "green", "green"],
        },
      ],
      summary:
        "<strong>✅ 正解パターン</strong><br>SGでインバウンド80番を許可するだけでOK。SGはステートフルなので戻り通信は自動許可。NACLはデフォルト全許可なので追加設定不要。",
    },
    2: {
      success: false,
      steps: [
        {
          highlight: "sgn-client-send",
          desc: "【STEP 1】クライアントからHTTP :80 リクエストを送信。",
          gates: {
            naclIn: "pass",
            sgIn: "block",
            sgOut: "gray",
            naclOut: "block",
          },
          arrows: ["green", "gray", "gray", "gray", "gray", "gray"],
        },
        {
          highlight: "sgn-nacl-in",
          desc: "【STEP 2】NACL IN：80番インバウンドを許可設定 → <strong>通過 ✓</strong>",
          gates: {
            naclIn: "pass",
            sgIn: "block",
            sgOut: "gray",
            naclOut: "block",
          },
          arrows: ["green", "green", "gray", "gray", "gray", "gray"],
        },
        {
          highlight: "sgn-sg-in",
          desc: "【STEP 3】SG IN：許可設定がない → <strong>ブロック ✕</strong><br>リクエストはEC2に届かない！",
          gates: {
            naclIn: "pass",
            sgIn: "block",
            sgOut: "gray",
            naclOut: "block",
          },
          arrows: ["green", "red", "gray", "gray", "gray", "gray"],
        },
        {
          highlight: "sgn-nacl-out",
          desc: "【問題点】さらに、NACL OUTで「その他拒否」していると、たとえEC2に届いても戻り通信（エフェメラルポート1024-65535）がブロックされる。NACLはステートレスなので両方向の設定が必要。",
          gates: {
            naclIn: "pass",
            sgIn: "block",
            sgOut: "gray",
            naclOut: "block",
          },
          arrows: ["green", "red", "gray", "gray", "gray", "red"],
        },
      ],
      summary:
        "<strong>❌ 失敗パターン</strong><br>NACLだけ設定してもSGのインバウンド許可がないとEC2に到達できない。また「その他拒否」だと戻り通信もブロックされる。",
    },
    3: {
      success: false,
      steps: [
        {
          highlight: "sgn-client-send",
          desc: "【STEP 1】クライアントからHTTP :80 リクエストを送信。",
          gates: {
            naclIn: "pass",
            sgIn: "block",
            sgOut: "pass",
            naclOut: "pass",
          },
          arrows: ["green", "gray", "gray", "gray", "gray", "gray"],
        },
        {
          highlight: "sgn-nacl-in",
          desc: "【STEP 2】NACL IN：デフォルト全許可 → <strong>通過 ✓</strong>",
          gates: {
            naclIn: "pass",
            sgIn: "block",
            sgOut: "pass",
            naclOut: "pass",
          },
          arrows: ["green", "green", "gray", "gray", "gray", "gray"],
        },
        {
          highlight: "sgn-sg-in",
          desc: "【STEP 3】SG IN：<strong>インバウンド</strong>の許可がない → <strong>ブロック ✕</strong><br>アウトバウンドを許可しても、インバウンドがないと届かない！",
          gates: {
            naclIn: "pass",
            sgIn: "block",
            sgOut: "pass",
            naclOut: "pass",
          },
          arrows: ["green", "red", "gray", "gray", "gray", "gray"],
        },
        {
          highlight: "sgn-sg-out",
          desc: "【解説】アウトバウンド＝EC2から外部への通信方向。クライアント→EC2は<strong>インバウンド</strong>。方向を間違えると通信できない。",
          gates: {
            naclIn: "pass",
            sgIn: "block",
            sgOut: "pass",
            naclOut: "pass",
          },
          arrows: ["green", "red", "gray", "gray", "gray", "gray"],
        },
      ],
      summary:
        "<strong>❌ 失敗パターン</strong><br>アウトバウンドはEC2→外部の方向。クライアントからのアクセスはインバウンドなので、SGのインバウンド許可が必要。",
    },
  };

  let currentScenario = 1;
  let currentStep = 0;

  function sgnSetScenario(num: number) {
    currentScenario = num;
    currentStep = 0;

    // Update buttons
    [1, 2, 3].forEach((i) => {
      const btn = document.getElementById(`sgn-scenario-${i}`)!;
      btn.className = "sgn-btn";
      if (i === num) {
        const scenario = SGN_SCENARIOS[i];
        btn.classList.add(scenario.success ? "success" : "fail");
      }
    });

    sgnRender();
  }

  function sgnRender() {
    const scenario = SGN_SCENARIOS[currentScenario];
    const step = scenario.steps[currentStep];

    // Update step info
    document.getElementById("sgn-step-num")!.textContent =
      `${currentStep + 1} / ${scenario.steps.length}`;
    document.getElementById("sgn-step-desc")!.innerHTML = step.desc;

    // Update summary
    document.getElementById("sgn-summary-text")!.innerHTML = scenario.summary;

    // Remove all highlights
    [
      "sgn-client-send",
      "sgn-client-recv",
      "sgn-nacl-in",
      "sgn-sg-in",
      "sgn-ec2",
      "sgn-sg-out",
      "sgn-nacl-out",
    ].forEach((id) => {
      document.getElementById(id)?.classList.remove("highlight");
    });

    // Add highlight
    document.getElementById(step.highlight)?.classList.add("highlight");

    // Update gate statuses
    sgnUpdateGate("sgn-nacl-in-status", step.gates.naclIn);
    sgnUpdateGate("sgn-sg-in-status", step.gates.sgIn);
    sgnUpdateGate("sgn-sg-out-status", step.gates.sgOut);
    sgnUpdateGate("sgn-nacl-out-status", step.gates.naclOut);

    // Update arrows
    step.arrows.forEach((color, i) => {
      const el = document.getElementById(`sgn-arr-${i + 1}`)!;
      el.className = `sgn-arrow-line ${color}`;
    });
  }

  function sgnUpdateGate(id: string, status: string) {
    const el = document.getElementById(id)!;
    el.className = `sgn-gate-status ${status}`;
    if (status === "pass") {
      el.textContent = "✓";
    } else if (status === "block") {
      el.textContent = "✕";
    } else {
      el.textContent = "–";
    }
  }

  function sgnNext() {
    const scenario = SGN_SCENARIOS[currentScenario];
    if (currentStep < scenario.steps.length - 1) {
      currentStep++;
      sgnRender();
    }
  }

  function sgnPrev() {
    if (currentStep > 0) {
      currentStep--;
      sgnRender();
    }
  }

  // Export to window
  (window as any).sgnSetScenario = sgnSetScenario;
  (window as any).sgnNext = sgnNext;
  (window as any).sgnPrev = sgnPrev;

  // Initialize
  sgnSetScenario(1);
</script>
