<script>


  /* ---- SSL/TLS Scenario ---- */
  const ELB_SSL_SCENARIOS = {
    1: {
      name: 'SSL終端',
      desc: '<strong>SSL終端（SSL Termination）</strong>：ELBでSSL/TLSを復号化し、バックエンドへはHTTPで通信。<br>ELBがSSL処理を担当するため、EC2の負荷が軽減される。一般的なWebアプリで使用。',
      proto1: 'HTTPS',
      proto2: 'HTTP',
      lock1: true,
      lock2: false,
      elbSub: 'SSL終端',
      ec2Cert: false
    },
    2: {
      name: 'End-to-End暗号化',
      desc: '<strong>End-to-End暗号化</strong>：クライアント→ELB→EC2の全経路でHTTPS。<br>金融・医療など規制要件で「全経路の暗号化」が必要な場合に使用。EC2にも証明書が必要。',
      proto1: 'HTTPS',
      proto2: 'HTTPS',
      lock1: true,
      lock2: true,
      elbSub: 'TLS Pass-through or 再暗号化',
      ec2Cert: true
    }
  };

  function elbSslScenario(n: number) {
    const s = ELB_SSL_SCENARIOS[n as keyof typeof ELB_SSL_SCENARIOS];
    if (!s) return;

    // Update buttons
    document.getElementById('elb-ssl-btn-1')?.classList.toggle('active', n === 1);
    document.getElementById('elb-ssl-btn-2')?.classList.toggle('active', n === 2);

    // Update description
    const descEl = document.getElementById('elb-ssl-desc');
    if (descEl) descEl.innerHTML = s.desc;

    // Update protocol labels
    const proto1 = document.getElementById('elb-ssl-proto1');
    const proto2 = document.getElementById('elb-ssl-proto2');
    if (proto1) {
      proto1.textContent = s.proto1;
      proto1.className = 'elb-ssl-proto ' + s.proto1.toLowerCase();
    }
    if (proto2) {
      proto2.textContent = s.proto2;
      proto2.className = 'elb-ssl-proto ' + s.proto2.toLowerCase();
    }

    // Update locks
    const lock1 = document.getElementById('elb-ssl-lock1');
    const lock2 = document.getElementById('elb-ssl-lock2');
    if (lock1) lock1.classList.toggle('hidden', !s.lock1);
    if (lock2) lock2.classList.toggle('hidden', !s.lock2);

    // Update ELB sub text
    const elbSub = document.getElementById('elb-ssl-elb-sub');
    if (elbSub) elbSub.textContent = s.elbSub;

    // Update EC2 cert visibility
    const ec2Cert = document.getElementById('elb-ssl-ec2-cert');
    if (ec2Cert) ec2Cert.classList.toggle('hidden', !s.ec2Cert);
  }

  (window as any).elbSslScenario = elbSslScenario;

  // Initialize SSL scenario
  elbSslScenario(1);
</script>