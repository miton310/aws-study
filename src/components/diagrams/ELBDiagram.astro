      </div>

      <div class="dia-note" style="margin-top:12px;background:#f0fdf4;border:1px solid #22c55e;">
        <strong style="color:#166534;">SNI（Server Name Indication）とは</strong>
        <ul class="elb-feature-list" style="color:#166534;">
          <li>TLSハンドシェイク時にクライアントが接続先ホスト名を通知する拡張機能</li>
          <li><strong>1つのELB（1つのIP）で複数のSSL証明書を使い分けられる</strong></li>
          <li>ALB・NLBはSNI対応、CLB（Classic）は非対応</li>
          <li>ワイルドカード証明書（*.example.com）やSAN証明書と組み合わせ可能</li>
        </ul>
      </div>

      <div class="elb-sni-compare" style="margin-top:12px;">
        <table class="elb-compare-tbl">
          <thead>
            <tr>
              <th></th>
              <th>SNIなし（従来）</th>
              <th>SNIあり</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>1つのELBで</td>
              <td style="color:#dc2626;">1つの証明書のみ</td>
              <td style="color:#059669;">複数の証明書をアタッチ可能</td>
            </tr>
            <tr>
              <td>複数ドメイン対応</td>
              <td>ELBを複数作成</td>
              <td style="color:#059669;">1つのELBで対応</td>
            </tr>
            <tr>
              <td>コスト</td>
              <td style="color:#dc2626;">ELB数分の料金</td>
              <td style="color:#059669;">1つのELB料金</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Notes -->
    <div class="dia-note info" style="margin-top:12px;">
      <strong>SAA頻出ポイント</strong>
      <ul class="elb-feature-list">
        <li>「クライアントからWebサーバーまで全ての通信を暗号化」→ <strong>End-to-End暗号化</strong></li>
        <li>ELB→EC2間もHTTPSにするには、EC2に証明書をインストールする必要がある</li>
        <li>ACMの証明書はELBに直接アタッチできるが、EC2にはエクスポートできない</li>
        <li>EC2用の証明書は<strong>ACM Private CA</strong>または自己署名証明書を使用</li>
        <li>「1つのELBで複数ドメインのHTTPS」→ <strong>SNI</strong>（ALB/NLBで対応）</li>
      </ul>
    </div>

    <div class="dia-note warn" style="margin-top:8px;">
      <strong>問題パターン：</strong><br>
      ・「規制要件で全経路の暗号化が必要」→ End-to-End暗号化<br>
      ・「1つのALBで複数ドメインのSSL証明書を使いたい」→ SNI
    </div>
  </div>
</div>

<script>
  /* Tab switching */
  // タブ切り替え関数（event明示・一元化）
  function elbTab(tab, ev) {
    // すべてのタブパネルを非表示
    document.querySelectorAll('.tab-panel').forEach(el => el.classList.remove('active'));
    // 対象パネルのみ表示
    const panel = document.getElementById('elb-' + tab);
    if (panel) panel.classList.add('active');
    // すべてのタブボタンのactive解除
    document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
    // クリックされたボタンのみactive
    if (ev && ev.currentTarget) ev.currentTarget.classList.add('active');
    // 矢印など再描画
    requestAnimationFrame(() => {
      if (typeof elbDrawOverview === 'function') elbDrawOverview();
      if (typeof elbDrawTerms === 'function') elbDrawTerms();
      if (typeof elbDrawRouting === 'function') elbDrawRouting();
    });
  }
  window.elbTab = elbTab;

  /* ---- Helpers ---- */
  function elbRect(id: string, cr: DOMRect) {
    const el = document.getElementById(id);
    if (!el) return { cx: 0, cy: 0, top: 0, bottom: 0, left: 0, right: 0, w: 0, h: 0 };
    const r = el.getBoundingClientRect();
    return {
      cx: r.left + r.width / 2 - cr.left,
      cy: r.top + r.height / 2 - cr.top,
      top: r.top - cr.top,
      bottom: r.bottom - cr.top,
      left: r.left - cr.left,
      right: r.right - cr.left,
      w: r.width,
      h: r.height,
    };
  }
  function elbSetLine(id: string, x1: number, y1: number, x2: number, y2: number) {
    const el = document.getElementById(id);
    if (!el) return;
    el.setAttribute('x1', String(Math.round(x1)));
    el.setAttribute('y1', String(Math.round(y1)));
    el.setAttribute('x2', String(Math.round(x2)));
    el.setAttribute('y2', String(Math.round(y2)));
  }
  function elbSetPath(id: string, d: string) {
    const el = document.getElementById(id);
    if (!el) return;
    el.setAttribute('d', d);
  }

  /* ---- Overview arrows ---- */
  function elbDrawOverview() {
    const wrap = document.getElementById('elb-ov-wrap');
    const svg = document.getElementById('elb-ov-svg');
    if (!wrap || !svg) return;
    const cr = wrap.getBoundingClientRect();
    svg.setAttribute('viewBox', `0 0 ${cr.width} ${cr.height}`);

    const user = elbRect('elb-ov-user', cr);
    const elb = elbRect('elb-ov-elb', cr);
    const ec2a = elbRect('elb-ov-ec2a', cr);
    const ec2b = elbRect('elb-ov-ec2b', cr);
    const ec2c = elbRect('elb-ov-ec2c', cr);

    // user → elb (straight down)
    elbSetLine('elb-ov-a0', user.cx, user.bottom, elb.cx, elb.top);

    // elb → ec2a (diagonal left)
    const ey = elb.bottom;
    elbSetPath('elb-ov-a1', `M${elb.cx} ${ey} C${elb.cx} ${ey + 20} ${ec2a.cx} ${ec2a.top - 20} ${ec2a.cx} ${ec2a.top}`);
    // elb → ec2b (straight)
    elbSetPath('elb-ov-a2', `M${elb.cx} ${ey} L${ec2b.cx} ${ec2b.top}`);
    // elb → ec2c (diagonal right)
    elbSetPath('elb-ov-a3', `M${elb.cx} ${ey} C${elb.cx} ${ey + 20} ${ec2c.cx} ${ec2c.top - 20} ${ec2c.cx} ${ec2c.top}`);
  }

  /* ---- Terms arrows ---- */
  function elbDrawTerms() {
    const wrap = document.getElementById('elb-terms-wrap');
    const svg = document.getElementById('elb-terms-svg');
    if (!wrap || !svg) return;
    const cr = wrap.getBoundingClientRect();
    svg.setAttribute('viewBox', `0 0 ${cr.width} ${cr.height}`);

    const elb = elbRect('elb-t-elb', cr);
    const l1 = elbRect('elb-t-l1', cr);
    const l2 = elbRect('elb-t-l2', cr);
    const r1 = elbRect('elb-t-r1', cr);
    const r2 = elbRect('elb-t-r2', cr);
    const tga = elbRect('elb-t-tga', cr);
    const tgb = elbRect('elb-t-tgb', cr);
    const redir = elbRect('elb-t-redirect', cr);

    // ELB → Listener 1 (diagonal)
    elbSetPath('elb-t-a1', `M${elb.cx} ${elb.bottom} C${elb.cx} ${elb.bottom + 16} ${l1.cx} ${l1.top - 16} ${l1.cx} ${l1.top}`);
    // ELB → Listener 2 (diagonal)
    elbSetPath('elb-t-a2', `M${elb.cx} ${elb.bottom} C${elb.cx} ${elb.bottom + 16} ${l2.cx} ${l2.top - 16} ${l2.cx} ${l2.top}`);
    // Listener1 → Rule1
    elbSetLine('elb-t-a3', l1.cx, l1.bottom, r1.cx, r1.top);
    // Listener2 → Rule2
    elbSetLine('elb-t-a4', l2.cx, l2.bottom, r2.cx, r2.top);
    // Rule1 → TG-A
    elbSetPath('elb-t-a5', `M${r1.cx - 20} ${r1.bottom} C${r1.cx - 20} ${r1.bottom + 10} ${tga.cx} ${tga.top - 10} ${tga.cx} ${tga.top}`);
    // Rule1 → TG-B
    elbSetPath('elb-t-a6', `M${r1.cx + 20} ${r1.bottom} C${r1.cx + 20} ${r1.bottom + 10} ${tgb.cx} ${tgb.top - 10} ${tgb.cx} ${tgb.top}`);
    // Rule2 → Redirect
    elbSetLine('elb-t-a7', r2.cx, r2.bottom, redir.cx, redir.top);
  }

  /* ---- Routing arrows ---- */
  function elbDrawRouting() {
    const wrap = document.getElementById('elb-rt-wrap');
    const svg = document.getElementById('elb-rt-svg');
    if (!wrap || !svg) return;
    const cr = wrap.getBoundingClientRect();
    svg.setAttribute('viewBox', `0 0 ${cr.width} ${cr.height}`);

    const alb = elbRect('elb-rt-alb', cr);
    const conds = ['elb-rt-c1','elb-rt-c2','elb-rt-c3','elb-rt-c4','elb-rt-c5'].map(id => elbRect(id, cr));
    const targets = ['elb-rt-ta','elb-rt-tb','elb-rt-tc'].map(id => elbRect(id, cr));

    // conditions → ALB
    conds.forEach((c, i) => {
      const sx = c.right;
      const sy = c.cy;
      const ex = alb.left;
      const ey = alb.cy;
      const mx = (sx + ex) / 2;
      elbSetPath(`elb-rt-l${i + 1}`, `M${sx} ${sy} C${mx} ${sy} ${mx} ${ey} ${ex} ${ey}`);
    });

    // ALB → targets
    targets.forEach((t, i) => {
      const sx = alb.right;
      const sy = alb.cy;
      const ex = t.left;
      const ey = t.cy;
      const mx = (sx + ex) / 2;
      elbSetPath(`elb-rt-r${i + 1}`, `M${sx} ${sy} C${mx} ${sy} ${mx} ${ey} ${ex} ${ey}`);
    });
  }

  /* ---- Init ---- */
  function elbInitAll() {
    elbDrawOverview();
    elbDrawTerms();
    elbDrawRouting();
  }

  window.addEventListener('load', () => setTimeout(elbInitAll, 120));
  window.addEventListener('resize', elbInitAll);

  const ovWrap = document.getElementById('elb-ov-wrap');
  if (ovWrap) new ResizeObserver(elbInitAll).observe(ovWrap);
  const tWrap = document.getElementById('elb-terms-wrap');
  if (tWrap) new ResizeObserver(elbInitAll).observe(tWrap);
  const rtWrap = document.getElementById('elb-rt-wrap');
  if (rtWrap) new ResizeObserver(elbInitAll).observe(rtWrap);
</script>


