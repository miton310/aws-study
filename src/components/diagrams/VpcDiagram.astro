---
// VPC 図解コンポーネント
---

<div class="diagram-wrapper">
  <div class="text-center py-12">
    <h3 class="text-xl font-bold text-gray-800 mb-4">VPC関連の詳細図解</h3>
    <p class="text-gray-600 mb-8">
      各機能の詳細な図解は専用ページでご確認ください
    </p>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto"
    >
      <a
        href="/network/vpc/route-table"
        class="block p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:shadow-md transition-all"
      >
        <div class="text-lg font-medium text-blue-600 mb-2">ルートテーブル</div>
        <div class="text-sm text-gray-500">ルーティング設定・評価順序</div>
      </a>

      <a
        href="/network/vpc/sg-nacl"
        class="block p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:shadow-md transition-all"
      >
        <div class="text-lg font-medium text-blue-600 mb-2">SG vs NACL</div>
        <div class="text-sm text-gray-500">セキュリティ機能の比較</div>
      </a>

      <a
        href="/network/vpc/endpoint"
        class="block p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:shadow-md transition-all"
      >
        <div class="text-lg font-medium text-blue-600 mb-2">VPC Endpoint</div>
        <div class="text-sm text-gray-500">プライベート接続</div>
      </a>

      <a
        href="/network/vpc/nat"
        class="block p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:shadow-md transition-all"
      >
        <div class="text-lg font-medium text-blue-600 mb-2">NAT Gateway</div>
        <div class="text-sm text-gray-500">アウトバウンド通信</div>
      </a>

      <a
        href="/network/vpc/nacl"
        class="block p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:shadow-md transition-all"
      >
        <div class="text-lg font-medium text-blue-600 mb-2">NACL詳細</div>
        <div class="text-sm text-gray-500">ネットワークACL設定</div>
      </a>

      <a
        href="/network/vpc/eni"
        class="block p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:shadow-md transition-all"
      >
        <div class="text-lg font-medium text-blue-600 mb-2">ENI</div>
        <div class="text-sm text-gray-500">ネットワークインターフェース</div>
      </a>
    </div>
  </div>

  <!-- VPC全体構造のSVG図解を維持 -->
  <svg width="100%" viewBox="0 0 680 420">
    <defs>
      <!-- 矢印マーカー -->
      <marker
        id="vpc-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path
          d="M2 1L8 5L2 9"
          fill="none"
          stroke="context-stroke"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </marker>
      <!-- 電流エフェクト用矢印（青） -->
      <marker id="arrow-flow-blue" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="5" markerHeight="5" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#3b82f6"/>
      </marker>
      <!-- 電流エフェクト用矢印（緑） -->
      <marker id="arrow-flow-green" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="5" markerHeight="5" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#10b981"/>
      </marker>
      <!-- 電流エフェクト用矢印（オレンジ） -->
      <marker id="arrow-flow-orange" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="5" markerHeight="5" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#f59e0b"/>
      </marker>
      <!-- グロー効果 -->
      <filter id="glow-blue">
        <feGaussianBlur stdDeviation="2" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
      <filter id="glow-green">
        <feGaussianBlur stdDeviation="2" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>

    <!-- Internet -->
    <rect
      x="270"
      y="20"
      width="140"
      height="36"
      rx="8"
      fill="#F1EFE8"
      stroke="#D3D1C7"
      stroke-width="0.5"></rect>
    <text
      x="340"
      y="42"
      text-anchor="middle"
      font-size="14"
      font-weight="500"
      fill="#2C2C2A">インターネット</text
    >

    <!-- IGW -->
    <rect
      x="255"
      y="76"
      width="170"
      height="36"
      rx="8"
      fill="#E1F5EE"
      stroke="#0F6E56"
      stroke-width="0.5"></rect>
    <text x="340" y="98" text-anchor="middle" font-size="13" fill="#085041"
      >Internet Gateway</text
    >
    <!-- Internet → IGW ベースライン -->
    <line x1="340" y1="56" x2="340" y2="76" stroke="#0d503d" stroke-width="3"></line>
    <!-- Internet → IGW 電流 -->
    <line x1="340" y1="56" x2="340" y2="76" class="electric-flow-green"
          stroke="#10b981" stroke-width="2" filter="url(#glow-green)" marker-end="url(#arrow-flow-green)"></line>

    <!-- VPC border -->
    <rect
      x="30"
      y="130"
      width="620"
      height="250"
      rx="14"
      fill="none"
      stroke="#1D9E75"
      stroke-width="1.5"
      stroke-dasharray="8 4"></rect>
    <text x="46" y="152" font-size="12" fill="#085041">VPC (10.0.0.0/16)</text>

    <!-- Public Subnet -->
    <rect
      x="50"
      y="162"
      width="260"
      height="100"
      rx="10"
      fill="#E6F1FB"
      stroke="#185FA5"
      stroke-width="1"></rect>
    <text x="66" y="182" font-size="12" fill="#185FA5"
      >パブリックサブネット</text
    >
    <rect
      x="70"
      y="194"
      width="100"
      height="44"
      rx="6"
      fill="#B5D4F4"
      stroke="#185FA5"
      stroke-width="0.5"></rect>
    <text
      x="120"
      y="214"
      text-anchor="middle"
      font-size="13"
      font-weight="500"
      fill="#042C53">EC2</text
    >
    <text x="120" y="230" text-anchor="middle" font-size="11" fill="#0C447C"
      >パブリックIP</text
    >

    <!-- Private Subnet -->
    <rect
      x="370"
      y="162"
      width="260"
      height="100"
      rx="10"
      fill="#FAEEDA"
      stroke="#854F0B"
      stroke-width="1"></rect>
    <text x="386" y="182" font-size="12" fill="#854F0B"
      >プライベートサブネット</text
    >
    <rect
      x="390"
      y="194"
      width="100"
      height="44"
      rx="6"
      fill="#FAC775"
      stroke="#854F0B"
      stroke-width="0.5"></rect>
    <text
      x="440"
      y="214"
      text-anchor="middle"
      font-size="13"
      font-weight="500"
      fill="#412402">EC2</text
    >
    <text x="440" y="230" text-anchor="middle" font-size="11" fill="#633806"
      >プライベートIP</text
    >

    <!-- NAT GW -->
    <rect
      x="200"
      y="194"
      width="100"
      height="44"
      rx="6"
      fill="#E1F5EE"
      stroke="#0F6E56"
      stroke-width="0.5"></rect>
    <text
      x="250"
      y="214"
      text-anchor="middle"
      font-size="12"
      font-weight="500"
      fill="#085041">NAT GW</text
    >
    <text x="250" y="230" text-anchor="middle" font-size="11" fill="#085041"
      >→インターネット</text
    >

    <!-- Route Table note -->
    <rect
      x="50"
      y="290"
      width="570"
      height="72"
      rx="8"
      fill="#EEEDFE"
      stroke="#534AB7"
      stroke-width="0.5"></rect>
    <text
      x="340"
      y="312"
      text-anchor="middle"
      font-size="13"
      font-weight="500"
      fill="#3C3489">ルートテーブル</text
    >
    <text x="340" y="334" text-anchor="middle" font-size="11" fill="#534AB7"
      >パブリック: 0.0.0.0/0 → IGW-xxx （インターネットアクセス可能）</text
    >
    <text x="340" y="350" text-anchor="middle" font-size="11" fill="#534AB7"
      >プライベート: 0.0.0.0/0 → NAT-xxx （アウトバウンドのみ）</text
    >

    <!-- IGW → VPC ベースライン -->
    <line x1="340" y1="112" x2="340" y2="130" stroke="#0d503d" stroke-width="3"></line>
    <!-- IGW → VPC 電流 -->
    <line x1="340" y1="112" x2="340" y2="130" class="electric-flow-green"
          stroke="#10b981" stroke-width="2" filter="url(#glow-green)" marker-end="url(#arrow-flow-green)"></line>

    <!-- ===== 通信フロー矢印 ===== -->

    <!-- パブリックEC2 ↔ IGW（曲線・双方向） -->
    <!-- 上り：EC2 → IGW -->
    <path d="M 120,194 Q 120,140 280,112" stroke="#1e3a5f" stroke-width="3" fill="none"/>
    <path d="M 120,194 Q 120,140 280,112" class="electric-flow-blue"
          stroke="#3b82f6" stroke-width="2" fill="none" filter="url(#glow-blue)" marker-end="url(#arrow-flow-blue)"/>
    <!-- 下り：IGW → EC2 -->
    <path d="M 300,112 Q 150,140 120,194" stroke="#1e3a5f" stroke-width="3" fill="none"/>
    <path d="M 300,112 Q 150,140 120,194" class="electric-flow-blue-reverse"
          stroke="#60a5fa" stroke-width="2" fill="none" filter="url(#glow-blue)" marker-end="url(#arrow-flow-blue)"/>

    <!-- プライベートEC2 → NAT GW（オレンジ） -->
    <path d="M 390,216 Q 340,216 300,216" stroke="#78350f" stroke-width="3" fill="none"/>
    <path d="M 390,216 Q 340,216 300,216" class="electric-flow-orange"
          stroke="#f59e0b" stroke-width="2" fill="none" filter="url(#glow-blue)" marker-end="url(#arrow-flow-orange)"/>

    <!-- NAT GW → IGW（曲線・緑） -->
    <path d="M 250,194 Q 250,150 320,112" stroke="#0d503d" stroke-width="3" fill="none"/>
    <path d="M 250,194 Q 250,150 320,112" class="electric-flow-green"
          stroke="#10b981" stroke-width="2" fill="none" filter="url(#glow-green)" marker-end="url(#arrow-flow-green)"/>

    <!-- 凡例 -->
    <rect x="520" y="132" width="120" height="70" rx="6" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
    <text x="530" y="150" font-size="10" font-weight="600" fill="#374151">通信フロー</text>
    <line x1="530" y1="160" x2="555" y2="160" stroke="#3b82f6" stroke-width="2"/>
    <text x="560" y="163" font-size="9" fill="#374151">パブリック↔インターネット</text>
    <line x1="530" y1="175" x2="555" y2="175" stroke="#f59e0b" stroke-width="2"/>
    <text x="560" y="178" font-size="9" fill="#374151">プライベート→NAT</text>
    <line x1="530" y1="190" x2="555" y2="190" stroke="#10b981" stroke-width="2"/>
    <text x="560" y="193" font-size="9" fill="#374151">NAT→インターネット</text>
  </svg>
</div>

<style>
  /* 電流エフェクト - 緑（IGW・NAT） */
  .electric-flow-green {
    stroke-dasharray: 8 6;
    animation: electric-green 0.8s linear infinite;
  }
  @keyframes electric-green {
    to { stroke-dashoffset: -14; }
  }

  /* 電流エフェクト - 青（パブリックEC2） */
  .electric-flow-blue {
    stroke-dasharray: 10 8;
    animation: electric-blue 0.7s linear infinite;
  }
  @keyframes electric-blue {
    to { stroke-dashoffset: -18; }
  }

  /* 電流エフェクト - 青（逆方向） */
  .electric-flow-blue-reverse {
    stroke-dasharray: 10 8;
    animation: electric-blue-reverse 0.7s linear infinite;
  }
  @keyframes electric-blue-reverse {
    to { stroke-dashoffset: 18; }
  }

  /* 電流エフェクト - オレンジ（プライベート→NAT） */
  .electric-flow-orange {
    stroke-dasharray: 6 4;
    animation: electric-orange 0.6s linear infinite;
  }
  @keyframes electric-orange {
    to { stroke-dashoffset: -10; }
  }
</style>
