---
// VPC 図解コンポーネント
---

<div class="diagram-wrapper">
  <div class="text-center py-12">
    <h3 class="text-xl font-bold text-gray-800 mb-4">VPC関連の詳細図解</h3>
    <p class="text-gray-600 mb-8">
      各機能の詳細な図解は専用ページでご確認ください
    </p>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto"
    >
      <a
        href="/network/vpc/route-table"
        class="block p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:shadow-md transition-all"
      >
        <div class="text-lg font-medium text-blue-600 mb-2">ルートテーブル</div>
        <div class="text-sm text-gray-500">ルーティング設定・評価順序</div>
      </a>

      <a
        href="/network/vpc/sg-nacl"
        class="block p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:shadow-md transition-all"
      >
        <div class="text-lg font-medium text-blue-600 mb-2">SG vs NACL</div>
        <div class="text-sm text-gray-500">セキュリティ機能の比較</div>
      </a>

      <a
        href="/network/vpc/endpoint"
        class="block p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:shadow-md transition-all"
      >
        <div class="text-lg font-medium text-blue-600 mb-2">VPC Endpoint</div>
        <div class="text-sm text-gray-500">プライベート接続</div>
      </a>

      <a
        href="/network/vpc/nat"
        class="block p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:shadow-md transition-all"
      >
        <div class="text-lg font-medium text-blue-600 mb-2">NAT Gateway</div>
        <div class="text-sm text-gray-500">アウトバウンド通信</div>
      </a>

      <a
        href="/network/vpc/nacl"
        class="block p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:shadow-md transition-all"
      >
        <div class="text-lg font-medium text-blue-600 mb-2">NACL詳細</div>
        <div class="text-sm text-gray-500">ネットワークACL設定</div>
      </a>

      <a
        href="/network/vpc/eni"
        class="block p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:shadow-md transition-all"
      >
        <div class="text-lg font-medium text-blue-600 mb-2">ENI</div>
        <div class="text-sm text-gray-500">ネットワークインターフェース</div>
      </a>
    </div>
  </div>

  <!-- VPC全体構造のSVG図解を維持 -->
  <svg width="100%" viewBox="0 0 680 400">
    <defs>
      <marker
        id="vpc-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path
          d="M2 1L8 5L2 9"
          fill="none"
          stroke="context-stroke"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </marker>
    </defs>

    <!-- Internet -->
    <rect
      x="270"
      y="20"
      width="140"
      height="36"
      rx="8"
      fill="#F1EFE8"
      stroke="#D3D1C7"
      stroke-width="0.5"></rect>
    <text
      x="340"
      y="42"
      text-anchor="middle"
      font-size="14"
      font-weight="500"
      fill="#2C2C2A">インターネット</text
    >

    <!-- IGW -->
    <rect
      x="255"
      y="76"
      width="170"
      height="36"
      rx="8"
      fill="#E1F5EE"
      stroke="#0F6E56"
      stroke-width="0.5"></rect>
    <text x="340" y="98" text-anchor="middle" font-size="13" fill="#085041"
      >Internet Gateway</text
    >
    <line
      x1="340"
      y1="56"
      x2="340"
      y2="76"
      stroke="#1D9E75"
      stroke-width="1.5"
      marker-end="url(#vpc-arrow)"></line>

    <!-- VPC border -->
    <rect
      x="30"
      y="130"
      width="620"
      height="250"
      rx="14"
      fill="none"
      stroke="#1D9E75"
      stroke-width="1.5"
      stroke-dasharray="8 4"></rect>
    <text x="46" y="152" font-size="12" fill="#085041">VPC (10.0.0.0/16)</text>

    <!-- Public Subnet -->
    <rect
      x="50"
      y="162"
      width="260"
      height="100"
      rx="10"
      fill="#E6F1FB"
      stroke="#185FA5"
      stroke-width="1"></rect>
    <text x="66" y="182" font-size="12" fill="#185FA5"
      >パブリックサブネット</text
    >
    <rect
      x="70"
      y="194"
      width="100"
      height="44"
      rx="6"
      fill="#B5D4F4"
      stroke="#185FA5"
      stroke-width="0.5"></rect>
    <text
      x="120"
      y="214"
      text-anchor="middle"
      font-size="13"
      font-weight="500"
      fill="#042C53">EC2</text
    >
    <text x="120" y="230" text-anchor="middle" font-size="11" fill="#0C447C"
      >パブリックIP</text
    >

    <!-- Private Subnet -->
    <rect
      x="370"
      y="162"
      width="260"
      height="100"
      rx="10"
      fill="#FAEEDA"
      stroke="#854F0B"
      stroke-width="1"></rect>
    <text x="386" y="182" font-size="12" fill="#854F0B"
      >プライベートサブネット</text
    >
    <rect
      x="390"
      y="194"
      width="100"
      height="44"
      rx="6"
      fill="#FAC775"
      stroke="#854F0B"
      stroke-width="0.5"></rect>
    <text
      x="440"
      y="214"
      text-anchor="middle"
      font-size="13"
      font-weight="500"
      fill="#412402">EC2</text
    >
    <text x="440" y="230" text-anchor="middle" font-size="11" fill="#633806"
      >プライベートIP</text
    >

    <!-- NAT GW -->
    <rect
      x="200"
      y="194"
      width="100"
      height="44"
      rx="6"
      fill="#E1F5EE"
      stroke="#0F6E56"
      stroke-width="0.5"></rect>
    <text
      x="250"
      y="214"
      text-anchor="middle"
      font-size="12"
      font-weight="500"
      fill="#085041">NAT GW</text
    >
    <text x="250" y="230" text-anchor="middle" font-size="11" fill="#085041"
      >→インターネット</text
    >

    <!-- Route Table note -->
    <rect
      x="50"
      y="290"
      width="570"
      height="72"
      rx="8"
      fill="#EEEDFE"
      stroke="#534AB7"
      stroke-width="0.5"></rect>
    <text
      x="340"
      y="312"
      text-anchor="middle"
      font-size="13"
      font-weight="500"
      fill="#3C3489">ルートテーブル</text
    >
    <text x="340" y="334" text-anchor="middle" font-size="11" fill="#534AB7"
      >パブリック: 0.0.0.0/0 → IGW-xxx （インターネットアクセス可能）</text
    >
    <text x="340" y="350" text-anchor="middle" font-size="11" fill="#534AB7"
      >プライベート: 0.0.0.0/0 → NAT-xxx （アウトバウンドのみ）</text
    >

    <line
      x1="340"
      y1="112"
      x2="340"
      y2="130"
      stroke="#1D9E75"
      stroke-width="1.5"
      marker-end="url(#vpc-arrow)"></line>
  </svg>
</div>
