---
/**
 * NATゲートウェイ経由のインターネットアクセス解説
 * プライベートサブネットからインターネットへの通信フロー
 */
---

<style>
  /* コンポーネント固有: ナビボタン */
  .nat-btn {
    cursor: pointer;
    font-size: 12px;
    padding: 6px 14px;
    border-radius: 6px;
    border: 1px solid #e5e7eb;
    background: #f9fafb;
    color: #111827;
    font-family: inherit;
    transition: all 0.2s;
  }
  .dark .nat-btn {
    border-color: #374151;
    background: #1f2937;
    color: #f9fafb;
  }
  .nat-btn:hover {
    background: #f3f4f6;
  }
  .dark .nat-btn:hover {
    background: #374151;
  }
  .nat-btn.success {
    background: #059669;
    color: #fff;
    border-color: #059669;
  }
  .nat-btn.fail {
    background: #dc2626;
    color: #fff;
    border-color: #dc2626;
  }
  .nat-btn-nav {
    padding: 4px 12px;
  }

  /* コンポーネント固有: サマリー */
  .nat-summary {
    margin-top: 16px;
    padding: 12px 16px;
    background: #fefce8;
    border: 1px solid #fde047;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.6;
  }
  .dark .nat-summary {
    background: rgba(250, 204, 21, 0.1);
    border-color: #ca8a04;
    color: #fef9c3;
  }
  .nat-summary-title {
    font-weight: 600;
    margin-bottom: 8px;
    color: #854d0e;
  }
  .dark .nat-summary-title {
    color: #fde047;
  }
</style>

<div>
  <!-- Step navigation -->
  <div class="dia-step-info">
    <button class="nat-btn nat-btn-nav" onclick="natPrev()">◀ 前へ</button>
    <button class="nat-btn nat-btn-nav" onclick="natNext()">次へ ▶</button>
    <span id="nat-step-num">1 / 4</span>
  </div>

  <!-- Step description -->
  <div id="nat-step-desc" class="dia-step-desc"></div>

  <!-- Legend -->
  <div class="dia-legend">
    <span
      ><div class="dia-legend-box" style="background:#059669;"></div> 通過</span
    >
    <span
      ><div class="dia-legend-box" style="background:#dc2626;"></div> ブロック</span
    >
    <span
      ><div class="dia-legend-box" style="background:#d1d5db;"></div> 未到達</span
    >
  </div>

  <!-- Diagram -->
  <div class="dia-diagram">
    <!-- Internet -->
    <div class="dia-row">
      <div id="nat-internet" class="dia-box dia-internet">
        <img
          class="dia-box-icon"
          src="/AWS-icons/Resource-Icons_07312025/Res_General-Icons/Res_48_Light/Res_Internet_48_Light.svg"
          alt="Internet"
        />
        <div class="dia-box-label">インターネット</div>
        <div class="dia-box-sub">Webコンテンツ</div>
      </div>
    </div>

    <!-- Arrow -->
    <div class="dia-row">
      <div class="dia-arrow">
        <div id="nat-arr-1" class="dia-arrow-v gray"></div>
      </div>
    </div>

    <!-- VPC -->
    <div class="dia-vpc">
      <div class="dia-vpc-header">
        <img src="/icons/Aws-Vpc--Streamline-Svg-Logos.svg" alt="VPC" />
        <span>VPC</span>
      </div>

      <!-- IGW row -->
      <div class="dia-row">
        <div id="nat-igw" class="dia-box dia-igw">
          <img
            class="dia-box-icon"
            src="/AWS-icons/Resource-Icons_07312025/Res_Networking-Content-Delivery/Res_Amazon-VPC_Internet-Gateway_48.svg"
            alt="IGW"
          />
          <div class="dia-box-label">Internet Gateway</div>
        </div>
      </div>

      <div class="dia-row">
        <div class="dia-arrow">
          <div id="nat-arr-2" class="dia-arrow-v diagonal gray"></div>
        </div>
      </div>

      <!-- Subnets row -->
      <div class="dia-row" style="gap: 16px; align-items: flex-start;">
        <!-- Public Subnet -->
        <div class="dia-subnet public">
          <div class="dia-subnet-header">
            <img
              src="/AWS-icons/Architecture-Group-Icons_07312025/Public-subnet_32.svg"
              alt="public"
            />
            <span>パブリックサブネット</span>
          </div>
          <div class="dia-row">
            <div id="nat-natgw" class="dia-box dia-natgw">
              <img
                class="dia-box-icon"
                src="/AWS-icons/Resource-Icons_07312025/Res_Networking-Content-Delivery/Res_Amazon-VPC_NAT-Gateway_48.svg"
                alt="NAT"
              />
              <div class="dia-box-label">NAT Gateway</div>
            </div>
          </div>
          <div class="dia-row" style="margin-top:6px;">
            <div id="nat-rt-public" class="dia-box dia-rt">
              <div class="dia-box-label">ルートテーブル</div>
              <img
                src="/AWS-icons/Resource-Icons_07312025/Res_Networking-Content-Delivery/Res_Amazon-Route-53_Route-Table_48.svg"
                alt="Route Table"
              />
              <div class="dia-box-sub">0.0.0.0/0 → IGW ✓</div>
            </div>
          </div>
        </div>

        <!-- Arrow between subnets -->
        <div style="display:flex;align-items:center;padding-top:30px;">
          <div class="dia-arrow">
            <div id="nat-arr-3" class="dia-arrow-h gray"></div>
          </div>
        </div>

        <!-- Private Subnet -->
        <div class="dia-subnet private">
          <div class="dia-subnet-header">
            <img
              src="/AWS-icons/Architecture-Group-Icons_07312025/Private-subnet_32.svg"
              alt="private"
            />
            <span>プライベートサブネット</span>
          </div>
          <div class="dia-row">
            <div id="nat-ec2" class="dia-box dia-ec2">
              <img
                class="dia-box-icon"
                src="/AWS-icons/Architecture-Service-Icons_07312025/Arch_Compute/48/Arch_Amazon-EC2_48.svg"
                alt="EC2"
              />
              <div class="dia-box-label">EC2</div>
              <div class="dia-box-sub">プライベートIPのみ</div>
            </div>
          </div>
          <div class="dia-row" style="margin-top:6px;">
            <div id="nat-rt-private" class="dia-box dia-rt">
              <div class="dia-box-label">ルートテーブル</div>
              <img
                src="/AWS-icons/Resource-Icons_07312025/Res_Networking-Content-Delivery/Res_Amazon-Route-53_Route-Table_48.svg"
                alt="Route Table"
              />
              <div id="nat-rt-private-route" class="dia-box-sub">
                0.0.0.0/0 → ???
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Checklist -->
  <div class="dia-checklist">
    <div class="dia-checklist-title">設定チェックリスト</div>
    <div id="nat-checklist-items">
      <!-- Filled by JS -->
    </div>
  </div>

  <!-- Summary -->
  <div class="nat-summary">
    <div class="nat-summary-title">ポイント</div>
    <div id="nat-summary-text"></div>
  </div>
</div>

<script>
  interface NatStep {
    highlight: string;
    desc: string;
    arrows: string[];
    rtPrivateError: boolean;
  }

  interface NatScenario {
    success: boolean;
    rtPrivateRoute: string;
    steps: NatStep[];
    checklist: { text: string; ok: boolean }[];
    summary: string;
  }

  const NAT_SCENARIOS: Record<number, NatScenario> = {
    2: {
      success: true,
      rtPrivateRoute: "0.0.0.0/0 → NAT GW ✓",
      steps: [
        {
          highlight: "nat-ec2",
          desc: "【STEP 1】プライベートサブネットのEC2からインターネットへリクエストを送信。",
          arrows: ["gray", "gray", "gray"],
          rtPrivateError: false,
        },
        {
          highlight: "nat-rt-private",
          desc: "【STEP 2】ルートテーブルを参照。<strong>0.0.0.0/0 → NAT Gateway</strong> が設定済み → NAT GWへ転送。",
          arrows: ["gray", "gray", "green"],
          rtPrivateError: false,
        },
        {
          highlight: "nat-natgw",
          desc: "【STEP 3】NAT Gatewayがパケットを受信。送信元IPをNAT GWのパブリックIPに変換（NAT）。",
          arrows: ["gray", "gray", "green"],
          rtPrivateError: false,
        },
        {
          highlight: "nat-rt-public",
          desc: "【STEP 4】パブリックサブネットのルートテーブル：<strong>0.0.0.0/0 → IGW</strong> → IGWへ転送。",
          arrows: ["gray", "green", "green"],
          rtPrivateError: false,
        },
        {
          highlight: "nat-igw",
          desc: "【STEP 5】Internet Gatewayを通過。インターネットへ。",
          arrows: ["green", "green", "green"],
          rtPrivateError: false,
        },
        {
          highlight: "nat-internet",
          desc: "【成功】インターネットのWebコンテンツにアクセス完了！<br>レスポンスは逆順でNAT Gateway経由でEC2に戻る。",
          arrows: ["green", "green", "green"],
          rtPrivateError: false,
        },
      ],
      checklist: [
        { text: "EC2にプライベートIPのみ", ok: true },
        { text: "VPCにIGW作成済み", ok: true },
        { text: "パブリックサブネットのルートテーブル → IGW", ok: true },
        { text: "NAT Gatewayをパブリックサブネットに作成", ok: true },
        { text: "SG/NACLはデフォルト設定", ok: true },
        { text: "プライベートサブネットのルートテーブル → NAT GW", ok: true },
      ],
      summary:
        "<strong>✅ 正しい設定</strong><br><br>プライベートサブネットのルートテーブルに <code>0.0.0.0/0 → NAT Gateway</code> を設定。<br>NAT Gatewayはパブリックサブネットに配置され、IGW経由でインターネットに出る。<br><br><strong>ポイント：</strong>プライベートEC2はインターネットに「出られる」が「入れない」（セキュリティ確保）。",
    },
  };

  let natCurrentScenario = 2;
  let natCurrentStep = 0;

  function natSetScenario(num: number) {
    natCurrentScenario = num;
    natCurrentStep = 0;

    // Update route table text
    const scenario = NAT_SCENARIOS[num];
    document.getElementById("nat-rt-private-route")!.textContent =
      scenario.rtPrivateRoute;

    // Update checklist
    const checklistEl = document.getElementById("nat-checklist-items")!;
    checklistEl.innerHTML = scenario.checklist
      .map(
        (item) => `
      <div class="dia-checklist-item ${item.ok ? "ok" : "ng"}">
        ${item.ok ? "✓" : "✕"} ${item.text}
      </div>
    `,
      )
      .join("");

    natRender();
  }

  function natRender() {
    const scenario = NAT_SCENARIOS[natCurrentScenario];
    const step = scenario.steps[natCurrentStep];

    // Update step info
    document.getElementById("nat-step-num")!.textContent =
      `${natCurrentStep + 1} / ${scenario.steps.length}`;
    document.getElementById("nat-step-desc")!.innerHTML = step.desc;

    // Update summary
    document.getElementById("nat-summary-text")!.innerHTML = scenario.summary;

    // Remove all highlights
    [
      "nat-internet",
      "nat-igw",
      "nat-natgw",
      "nat-rt-public",
      "nat-rt-private",
      "nat-ec2",
    ].forEach((id) => {
      document.getElementById(id)?.classList.remove("highlight");
    });

    // Add highlight
    document.getElementById(step.highlight)?.classList.add("highlight");

    // Update route table error state
    const rtPrivate = document.getElementById("nat-rt-private")!;
    if (step.rtPrivateError) {
      rtPrivate.classList.add("error");
    } else {
      rtPrivate.classList.remove("error");
    }

    // Update arrows
    const arrowIds = ["nat-arr-1", "nat-arr-2", "nat-arr-3"];
    step.arrows.forEach((color, i) => {
      const el = document.getElementById(arrowIds[i])!;
      el.className = el.className.includes("-v")
        ? `dia-arrow-v ${color}`
        : `dia-arrow-h ${color}`;
    });

    // Preserve diagonal class on arr-2
    const arr2 = document.getElementById("nat-arr-2")!;
    if (!arr2.classList.contains("diagonal")) {
      arr2.classList.add("diagonal");
    }
  }

  function natNext() {
    const scenario = NAT_SCENARIOS[natCurrentScenario];
    if (natCurrentStep < scenario.steps.length - 1) {
      natCurrentStep++;
      natRender();
    }
  }

  function natPrev() {
    if (natCurrentStep > 0) {
      natCurrentStep--;
      natRender();
    }
  }

  // Export to window
  (window as any).natSetScenario = natSetScenario;
  (window as any).natNext = natNext;
  (window as any).natPrev = natPrev;

  // Initialize
  natSetScenario(2);
</script>
