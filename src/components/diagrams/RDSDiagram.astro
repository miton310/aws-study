---
---
<div>
  <style>
    .rds-btn{cursor:pointer;font-size:12px;padding:4px 12px;border-radius:6px;border:1px solid #e5e7eb;background:#f9fafb;color:#111827;font-family:inherit;}
    .dark .rds-btn{border-color:#374151;background:#1f2937;color:#f9fafb;}
    .rds-btn.active{background:#534AB7;color:#fff;border-color:#534AB7;}
    .rds-panel{display:none;}
    .rds-panel.active{display:block;}
  </style>

  <div style="display:flex;gap:6px;margin:0 0 10px;flex-wrap:wrap">
    <button class="rds-btn active" onclick="rdsTab('overview')">RDS基本</button>
    <button class="rds-btn" onclick="rdsTab('aurora')">Aurora</button>
    <button class="rds-btn" onclick="rdsTab('ha')">マルチAZ vs リードレプリカ</button>
    <button class="rds-btn" onclick="rdsTab('pattern')">頻出パターン</button>
  </div>

  <div id="rds-overview" class="rds-panel active">
    <svg width="100%" viewBox="0 0 680 380">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">Amazon RDS：マネージドリレーショナルDB</text>
      <text x="340" y="52" text-anchor="middle" font-size="12" fill="currentColor">対応エンジン</text>
      <rect x="40"  y="66" width="88" height="36" rx="6" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/><text x="84"  y="88" text-anchor="middle" font-size="12" fill="#0C447C">MySQL</text>
      <rect x="140" y="66" width="88" height="36" rx="6" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/><text x="184" y="88" text-anchor="middle" font-size="12" fill="#0C447C">PostgreSQL</text>
      <rect x="240" y="66" width="88" height="36" rx="6" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/><text x="284" y="88" text-anchor="middle" font-size="12" fill="#0C447C">MariaDB</text>
      <rect x="340" y="66" width="88" height="36" rx="6" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/><text x="384" y="88" text-anchor="middle" font-size="12" fill="#0C447C">Oracle</text>
      <rect x="440" y="66" width="88" height="36" rx="6" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/><text x="484" y="88" text-anchor="middle" font-size="12" fill="#0C447C">SQL Server</text>
      <rect x="540" y="66" width="100" height="36" rx="6" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/><text x="590" y="88" text-anchor="middle" font-size="12" fill="#3C3489">Aurora ★</text>
      <text x="340" y="128" text-anchor="middle" font-size="13" font-weight="500" fill="currentColor">AWSが管理してくれること</text>
      <rect x="40"  y="140" width="180" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="130" y="158" text-anchor="middle" font-size="12" fill="#085041">OSパッチ適用</text><text x="130" y="176" text-anchor="middle" font-size="11" fill="#085041">自動で適用される</text>
      <rect x="250" y="140" width="180" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="340" y="158" text-anchor="middle" font-size="12" fill="#085041">自動バックアップ</text><text x="340" y="176" text-anchor="middle" font-size="11" fill="#085041">1〜35日間保持</text>
      <rect x="460" y="140" width="180" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="550" y="158" text-anchor="middle" font-size="12" fill="#085041">マルチAZ対応</text><text x="550" y="176" text-anchor="middle" font-size="11" fill="#085041">自動フェイルオーバー</text>
      <rect x="40" y="206" width="600" height="144" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="230" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">SAA頻出ポイント</text>
      <text x="60" y="256" font-size="12" fill="#633806">・自動バックアップ：毎日スナップショット + トランザクションログ → 秒単位でリストア可能</text>
      <text x="60" y="278" font-size="12" fill="#633806">・暗号化：作成時のみ設定可能。後から変更不可（スナップショット経由で移行）</text>
      <text x="60" y="300" font-size="12" fill="#633806">・RDS Proxy：接続プールでLambdaからの大量接続を効率化</text>
      <text x="60" y="322" font-size="12" fill="#633806">・リードレプリカ：非同期レプリケーション・読み取り専用・最大5台</text>
      <text x="60" y="342" font-size="12" fill="#633806">・マルチAZ：同期レプリケーション・スタンバイは読み取り不可・自動フェイルオーバー</text>
    </svg>
  </div>

  <div id="rds-aurora" class="rds-panel">
    <svg width="100%" viewBox="0 0 680 380">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">Amazon Aurora：RDSの5倍速・クラウドネイティブDB</text>
      <rect x="40" y="44" width="600" height="190" rx="14" fill="none" stroke="#534AB7" stroke-width="1.5" stroke-dasharray="8 4"/>
      <text x="56" y="64" font-size="12" fill="#534AB7">Auroraクラスター</text>
      <rect x="80"  y="76" width="160" height="56" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="160" y="100" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489">プライマリ</text>
      <text x="160" y="120" text-anchor="middle" font-size="11" fill="#534AB7">読み書き両方</text>
      <rect x="290" y="76" width="130" height="56" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="355" y="100" text-anchor="middle" font-size="12" font-weight="500" fill="#085041">リードレプリカ1</text>
      <text x="355" y="118" text-anchor="middle" font-size="11" fill="#085041">読み取り専用</text>
      <rect x="440" y="76" width="130" height="56" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="505" y="100" text-anchor="middle" font-size="12" font-weight="500" fill="#085041">リードレプリカ2</text>
      <text x="505" y="118" text-anchor="middle" font-size="11" fill="#085041">読み取り専用</text>
      <rect x="80" y="160" width="490" height="56" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
      <text x="325" y="184" text-anchor="middle" font-size="13" font-weight="500" fill="#712B13">共有ストレージ（6コピー・3AZ）</text>
      <text x="325" y="204" text-anchor="middle" font-size="11" fill="#993C1D">プライマリもレプリカも同じストレージを参照 → レプリカラグがほぼゼロ</text>
      <rect x="40" y="254" width="600" height="108" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="278" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">RDS vs Aurora</text>
      <text x="60" y="302" font-size="12" fill="#633806">・スループット：MySQL比5倍速・PostgreSQL比3倍速</text>
      <text x="60" y="322" font-size="12" fill="#633806">・リードレプリカ：RDS最大5台 vs Aurora最大15台</text>
      <text x="60" y="342" font-size="12" fill="#633806">・フェイルオーバー：RDS 1〜2分 vs Aurora 30秒以内</text>
    </svg>
  </div>

  <div id="rds-ha" class="rds-panel">
    <svg width="100%" viewBox="0 0 680 380">
      <defs><marker id="rds-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">マルチAZ vs リードレプリカ（最頻出の対比）</text>
      <text x="160" y="52" text-anchor="middle" font-size="13" font-weight="500" fill="#993C1D">マルチAZ（高可用性）</text>
      <rect x="40" y="62" width="240" height="220" rx="12" fill="none" stroke="#993C1D" stroke-width="1.5" stroke-dasharray="6 3"/>
      <rect x="66"  y="82" width="180" height="56" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
      <text x="156" y="106" text-anchor="middle" font-size="13" font-weight="500" fill="#712B13">プライマリDB</text>
      <text x="156" y="126" text-anchor="middle" font-size="11" fill="#993C1D">AZ1・読み書き</text>
      <text x="156" y="162" text-anchor="middle" font-size="11" fill="#993C1D">同期レプリケーション</text>
      <line x1="156" y1="138" x2="156" y2="178" stroke="#993C1D" stroke-width="1.5" stroke-dasharray="5 3" marker-end="url(#rds-arr)"/>
      <rect x="66"  y="180" width="180" height="56" rx="8" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/>
      <text x="156" y="204" text-anchor="middle" font-size="13" font-weight="500" fill="#444441">スタンバイDB</text>
      <text x="156" y="222" text-anchor="middle" font-size="11" fill="#5F5E5A">AZ2・待機のみ</text>
      <rect x="66"  y="256" width="180" height="16" rx="4" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="156" y="268" text-anchor="middle" font-size="11" fill="#085041">目的：高可用性・障害時に自動切替</text>
      <text x="520" y="52" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">リードレプリカ（パフォーマンス）</text>
      <rect x="400" y="62" width="240" height="220" rx="12" fill="none" stroke="#1D9E75" stroke-width="1.5" stroke-dasharray="6 3"/>
      <rect x="426" y="82" width="180" height="56" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="516" y="106" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">プライマリDB</text>
      <text x="516" y="126" text-anchor="middle" font-size="11" fill="#085041">読み書き</text>
      <text x="516" y="162" text-anchor="middle" font-size="11" fill="#085041">非同期レプリケーション</text>
      <line x1="516" y1="138" x2="516" y2="178" stroke="#1D9E75" stroke-width="1.5" stroke-dasharray="5 3" marker-end="url(#rds-arr)"/>
      <rect x="426" y="180" width="180" height="56" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="516" y="204" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">リードレプリカ</text>
      <text x="516" y="222" text-anchor="middle" font-size="11" fill="#085041">読み取り専用</text>
      <rect x="426" y="256" width="180" height="16" rx="4" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="516" y="268" text-anchor="middle" font-size="11" fill="#085041">目的：読み取り負荷を分散</text>
      <rect x="40" y="300" width="600" height="60" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="324" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">SAA頻出の使い分け</text>
      <text x="60" y="348" font-size="12" fill="#633806">「障害時に自動切替・ダウンタイム最小」→ マルチAZ　「読み取り性能を上げたい」→ リードレプリカ</text>
    </svg>
  </div>

  <div id="rds-pattern" class="rds-panel">
    <svg width="100%" viewBox="0 0 680 340">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">SAA頻出パターン</text>
      <rect x="40" y="44" width="600" height="276" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="60" y="74"  font-size="12" fill="#633806">「一般的なリレーショナルDB・OSパッチ不要」</text><text x="500" y="74"  font-size="12" font-weight="500" fill="#412402">→ RDS</text>
      <line x1="40" y1="86" x2="640" y2="86" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="108" font-size="12" fill="#633806">「高スループット・高可用性・フルマネージド」</text><text x="500" y="108" font-size="12" font-weight="500" fill="#412402">→ Aurora</text>
      <line x1="40" y1="120" x2="640" y2="120" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="142" font-size="12" fill="#633806">「障害時に自動フェイルオーバーしたい」</text><text x="500" y="142" font-size="12" font-weight="500" fill="#412402">→ マルチAZ有効化</text>
      <line x1="40" y1="154" x2="640" y2="154" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="176" font-size="12" fill="#633806">「読み取り負荷を分散したい」</text><text x="500" y="176" font-size="12" font-weight="500" fill="#412402">→ リードレプリカ</text>
      <line x1="40" y1="188" x2="640" y2="188" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="210" font-size="12" fill="#633806">「Lambdaから大量DB接続・接続枯渇を防ぎたい」</text><text x="500" y="210" font-size="12" font-weight="500" fill="#412402">→ RDS Proxy</text>
      <line x1="40" y1="222" x2="640" y2="222" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="244" font-size="12" fill="#633806">「使った分だけ課金・トラフィックが不定期」</text><text x="500" y="244" font-size="12" font-weight="500" fill="#412402">→ Aurora Serverless</text>
      <line x1="40" y1="256" x2="640" y2="256" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="278" font-size="12" fill="#633806">「DBのキャッシュで高速化したい」</text><text x="500" y="278" font-size="12" font-weight="500" fill="#412402">→ ElastiCache（Redis推奨）</text>
      <line x1="40" y1="290" x2="640" y2="290" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="312" font-size="12" fill="#633806">「暗号化されていないRDSを暗号化したい」</text><text x="500" y="312" font-size="12" font-weight="500" fill="#412402">→ スナップショット→暗号化コピー→復元</text>
    </svg>
  </div>
</div>

<script>
  function rdsTab(t: string) {
    document.querySelectorAll('[id^="rds-"]').forEach(el => el.classList.remove('active'));
    document.getElementById('rds-' + t)?.classList.add('active');
    document.querySelectorAll('.rds-btn').forEach(el => el.classList.remove('active'));
    (event?.target as HTMLElement)?.classList.add('active');
  }
  (window as any).rdsTab = rdsTab;
</script>