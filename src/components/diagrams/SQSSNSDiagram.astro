---
---
<div>
  <style>
    .sqs-btn{cursor:pointer;font-size:12px;padding:4px 12px;border-radius:6px;border:1px solid #e5e7eb;background:#f9fafb;color:#111827;font-family:inherit;}
    .dark .sqs-btn{border-color:#374151;background:#1f2937;color:#f9fafb;}
    .sqs-btn.active{background:#534AB7;color:#fff;border-color:#534AB7;}
    .sqs-panel{display:none;}
    .sqs-panel.active{display:block;}
  </style>

  <div style="display:flex;gap:6px;margin:0 0 10px;flex-wrap:wrap">
    <button class="sqs-btn active" onclick="sqsTab('concept')">疎結合とは</button>
    <button class="sqs-btn" onclick="sqsTab('sqs')">SQS</button>
    <button class="sqs-btn" onclick="sqsTab('sns')">SNS</button>
    <button class="sqs-btn" onclick="sqsTab('compare')">使い分け・Fan-out</button>
  </div>

  <div id="sqs-concept" class="sqs-panel active">
    <svg width="100%" viewBox="0 0 680 360">
      <defs><marker id="sqs-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">疎結合：サービス間の依存をなくす</text>
      <text x="160" y="52" text-anchor="middle" font-size="13" font-weight="500" fill="#A32D2D">密結合（問題あり）</text>
      <rect x="40"  y="62" width="100" height="44" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="90" y="88" text-anchor="middle" font-size="12" fill="#2C2C2A">サービスA</text>
      <line x1="140" y1="84" x2="178" y2="84" stroke="#E24B4A" stroke-width="2" marker-end="url(#sqs-arr)"/>
      <text x="159" y="76" text-anchor="middle" font-size="11" fill="#A32D2D">直接呼出</text>
      <rect x="180" y="62" width="100" height="44" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="230" y="88" text-anchor="middle" font-size="12" fill="#2C2C2A">サービスB</text>
      <rect x="40" y="122" width="240" height="32" rx="6" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
      <text x="160" y="142" text-anchor="middle" font-size="11" fill="#791F1F">BがダウンするとAも失敗</text>
      <text x="520" y="52" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">疎結合（SQS/SNSで解決）</text>
      <rect x="360" y="62" width="100" height="44" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="410" y="88" text-anchor="middle" font-size="12" fill="#2C2C2A">サービスA</text>
      <line x1="460" y1="84" x2="498" y2="84" stroke="#1D9E75" stroke-width="2" marker-end="url(#sqs-arr)"/>
      <rect x="500" y="62" width="80" height="44" rx="6" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/><text x="540" y="88" text-anchor="middle" font-size="12" fill="#712B13">SQS/SNS</text>
      <line x1="580" y1="84" x2="618" y2="84" stroke="#1D9E75" stroke-width="2" marker-end="url(#sqs-arr)"/>
      <rect x="620" y="62" width="40" height="44" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="640" y="88" text-anchor="middle" font-size="12" fill="#2C2C2A">B</text>
      <rect x="360" y="122" width="300" height="32" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="510" y="142" text-anchor="middle" font-size="11" fill="#085041">BがダウンしてもAは継続</text>
      <rect x="40" y="180" width="270" height="80" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
      <text x="175" y="208" text-anchor="middle" font-size="13" font-weight="500" fill="#712B13">SQS（キュー）</text>
      <text x="175" y="232" text-anchor="middle" font-size="12" fill="#993C1D">メッセージを溜めて順番に処理</text>
      <text x="175" y="252" text-anchor="middle" font-size="12" fill="#993C1D">1対1・プル型</text>
      <rect x="370" y="180" width="270" height="80" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="505" y="208" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489">SNS（通知）</text>
      <text x="505" y="232" text-anchor="middle" font-size="12" fill="#534AB7">メッセージを全員に配信</text>
      <text x="505" y="252" text-anchor="middle" font-size="12" fill="#534AB7">1対多・プッシュ型</text>
      <rect x="40" y="278" width="600" height="60" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="302" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">SAA頻出：「疎結合・スケーラブル・非同期」→ SQS / SNS が正解パターン</text>
    </svg>
  </div>

  <div id="sqs-sqs" class="sqs-panel">
    <svg width="100%" viewBox="0 0 680 360">
      <defs><marker id="sqs-arr2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">Amazon SQS：メッセージキューイング</text>
      <rect x="20"  y="60" width="100" height="44" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="70" y="86" text-anchor="middle" font-size="12" fill="#2C2C2A">プロデューサー</text>
      <line x1="120" y1="82" x2="158" y2="82" stroke="#888780" stroke-width="1.5" marker-end="url(#sqs-arr2)"/>
      <rect x="160" y="48" width="260" height="68" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
      <text x="290" y="78" text-anchor="middle" font-size="13" font-weight="500" fill="#712B13">SQS キュー</text>
      <text x="290" y="100" text-anchor="middle" font-size="11" fill="#993C1D">メッセージを蓄積・順番に保持</text>
      <line x1="420" y1="82" x2="458" y2="82" stroke="#993C1D" stroke-width="1.5" marker-end="url(#sqs-arr2)"/>
      <text x="439" y="74" text-anchor="middle" font-size="11" fill="#993C1D">ポーリング</text>
      <rect x="460" y="60" width="100" height="44" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="510" y="86" text-anchor="middle" font-size="12" fill="#2C2C2A">コンシューマー</text>
      <rect x="40"  y="148" width="270" height="80" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
      <text x="175" y="176" text-anchor="middle" font-size="13" font-weight="500" fill="#712B13">標準キュー</text>
      <text x="175" y="200" text-anchor="middle" font-size="12" fill="#993C1D">順序保証なし・重複配信あり</text>
      <text x="175" y="220" text-anchor="middle" font-size="12" fill="#993C1D">スループット無制限・高速</text>
      <rect x="370" y="148" width="270" height="80" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
      <text x="505" y="176" text-anchor="middle" font-size="13" font-weight="500" fill="#712B13">FIFOキュー</text>
      <text x="505" y="200" text-anchor="middle" font-size="12" fill="#993C1D">順序保証あり・重複なし</text>
      <text x="505" y="220" text-anchor="middle" font-size="12" fill="#993C1D">300TPS（バッチで3000）</text>
      <rect x="40" y="250" width="600" height="88" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="274" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">SAA頻出ポイント</text>
      <text x="60" y="298" font-size="12" fill="#633806">可視性タイムアウト：処理中のメッセージを他のコンシューマーから隠す時間（デフォルト30秒）</text>
      <text x="60" y="320" font-size="12" fill="#633806">DLQ（デッドレタキュー）：処理失敗したメッセージを別キューに移す → 原因分析に使う</text>
    </svg>
  </div>

  <div id="sqs-sns" class="sqs-panel">
    <svg width="100%" viewBox="0 0 680 360">
      <defs><marker id="sqs-arr3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">Amazon SNS：Pub/Sub 通知サービス</text>
      <rect x="20" y="150" width="110" height="44" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="75" y="176" text-anchor="middle" font-size="12" fill="#2C2C2A">パブリッシャー</text>
      <line x1="130" y1="172" x2="168" y2="172" stroke="#888780" stroke-width="1.5" marker-end="url(#sqs-arr3)"/>
      <rect x="170" y="138" width="160" height="68" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="250" y="168" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489">SNS トピック</text>
      <text x="250" y="192" text-anchor="middle" font-size="11" fill="#534AB7">全員に即時配信</text>
      <line x1="330" y1="160" x2="388" y2="70"  stroke="#534AB7" stroke-width="1.5" marker-end="url(#sqs-arr3)"/>
      <line x1="330" y1="168" x2="388" y2="128" stroke="#534AB7" stroke-width="1.5" marker-end="url(#sqs-arr3)"/>
      <line x1="330" y1="176" x2="388" y2="188" stroke="#534AB7" stroke-width="1.5" marker-end="url(#sqs-arr3)"/>
      <line x1="330" y1="184" x2="388" y2="248" stroke="#534AB7" stroke-width="1.5" marker-end="url(#sqs-arr3)"/>
      <line x1="330" y1="192" x2="388" y2="308" stroke="#534AB7" stroke-width="1.5" marker-end="url(#sqs-arr3)"/>
      <rect x="390" y="46"  width="120" height="44" rx="6" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/><text x="450" y="72" text-anchor="middle" font-size="12" fill="#712B13">SQSキュー</text>
      <rect x="390" y="106" width="120" height="44" rx="6" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/><text x="450" y="132" text-anchor="middle" font-size="12" fill="#3C3489">Lambda</text>
      <rect x="390" y="166" width="120" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="450" y="192" text-anchor="middle" font-size="12" fill="#085041">メール</text>
      <rect x="390" y="226" width="120" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="450" y="252" text-anchor="middle" font-size="12" fill="#085041">HTTP/HTTPS</text>
      <rect x="390" y="286" width="120" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="450" y="312" text-anchor="middle" font-size="12" fill="#085041">SMS</text>
      <rect x="40" y="336" width="600" height="20" rx="6" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="350" text-anchor="middle" font-size="11" font-weight="500" fill="#633806">SAA頻出：Fan-outパターン = SNS → 複数SQS → 並列処理</text>
    </svg>
  </div>

  <div id="sqs-compare" class="sqs-panel">
    <svg width="100%" viewBox="0 0 680 360">
      <defs><marker id="sqs-arr4" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">Fan-outパターン：SNS + SQS の組み合わせ</text>
      <rect x="40"  y="60" width="100" height="44" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="90" y="86" text-anchor="middle" font-size="12" fill="#2C2C2A">注文完了</text>
      <line x1="140" y1="82" x2="178" y2="82" stroke="#888780" stroke-width="1.5" marker-end="url(#sqs-arr4)"/>
      <rect x="180" y="60" width="100" height="44" rx="6" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/><text x="230" y="86" text-anchor="middle" font-size="12" fill="#3C3489">SNS</text>
      <line x1="280" y1="72" x2="318" y2="42"  stroke="#534AB7" stroke-width="1.5" marker-end="url(#sqs-arr4)"/>
      <line x1="280" y1="82" x2="318" y2="82"  stroke="#534AB7" stroke-width="1.5" marker-end="url(#sqs-arr4)"/>
      <line x1="280" y1="92" x2="318" y2="122" stroke="#534AB7" stroke-width="1.5" marker-end="url(#sqs-arr4)"/>
      <rect x="320" y="20"  width="120" height="36" rx="6" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/><text x="380" y="42" text-anchor="middle" font-size="12" fill="#712B13">SQS→在庫更新</text>
      <rect x="320" y="64"  width="120" height="36" rx="6" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/><text x="380" y="86" text-anchor="middle" font-size="12" fill="#712B13">SQS→メール送信</text>
      <rect x="320" y="108" width="120" height="36" rx="6" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/><text x="380" y="130" text-anchor="middle" font-size="12" fill="#712B13">SQS→請求処理</text>
      <rect x="460" y="44" width="180" height="100" rx="8" fill="#EAF3DE" stroke="#3B6D11" stroke-width="0.5"/>
      <text x="550" y="70" text-anchor="middle" font-size="13" font-weight="500" fill="#27500A">メリット</text>
      <text x="550" y="96" text-anchor="middle" font-size="12" fill="#3B6D11">各処理が独立</text>
      <text x="550" y="118" text-anchor="middle" font-size="12" fill="#3B6D11">並列・非同期で実行</text>
      <rect x="40" y="180" width="600" height="80" rx="8" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/>
      <text x="340" y="206" text-anchor="middle" font-size="13" font-weight="500" fill="#2C2C2A">SQS vs SNS 比較</text>
      <text x="60" y="232" font-size="12" fill="#5F5E5A">SQS：1対1・プル型・最大14日保持・非同期バッチ処理向け</text>
      <text x="60" y="252" font-size="12" fill="#5F5E5A">SNS：1対多・プッシュ型・保持しない・イベント通知・Fan-out向け</text>
      <rect x="40" y="278" width="600" height="60" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="302" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">SAA頻出：「リアルタイムログ・IoTデータ」→ Kinesis / 「非同期・疎結合」→ SQS</text>
    </svg>
  </div>
</div>

<script>
  function sqsTab(t: string) {
    document.querySelectorAll('[id^="sqs-"]').forEach(el => el.classList.remove('active'));
    document.getElementById('sqs-' + t)?.classList.add('active');
    document.querySelectorAll('.sqs-btn').forEach(el => el.classList.remove('active'));
    (event?.target as HTMLElement)?.classList.add('active');
  }
  (window as any).sqsTab = sqsTab;
</script>