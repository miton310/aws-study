---
---
<div>
  <style>
    .tgw-btn{cursor:pointer;font-size:12px;padding:4px 12px;border-radius:6px;border:1px solid #e5e7eb;background:#f9fafb;color:#111827;font-family:inherit;}
    .dark .tgw-btn{border-color:#374151;background:#1f2937;color:#f9fafb;}
    .tgw-btn.active{background:#534AB7;color:#fff;border-color:#534AB7;}
    .tgw-panel{display:none;}
    .tgw-panel.active{display:block;}
  </style>

  <div style="display:flex;gap:6px;margin:0 0 10px;flex-wrap:wrap">
    <button class="tgw-btn active" onclick="tgwTab('compare')">ピアリング vs TGW</button>
    <button class="tgw-btn" onclick="tgwTab('basic')">TGW基本構造</button>
    <button class="tgw-btn" onclick="tgwTab('usecases')">ユースケース</button>
  </div>

  <!-- ピアリング vs TGW -->
  <div id="tgw-compare" class="tgw-panel active">
    <div style="display:flex;gap:8px;margin:0 0 8px;flex-wrap:wrap">
      <button class="tgw-btn active" id="tgw-btn-peer" onclick="tgwMode('peer')">VPCピアリング（NG）</button>
      <button class="tgw-btn" id="tgw-btn-hub" onclick="tgwMode('hub')">Transit Gateway（正解）</button>
    </div>
    <svg width="100%" viewBox="0 0 680 420">
      <defs><marker id="tgw-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>

      <text id="tgw-mode-title" x="340" y="28" text-anchor="middle" font-size="14" font-weight="500" fill="#A32D2D">VPCピアリング：フルメッシュ構成</text>
      <text id="tgw-mode-sub" x="340" y="48" text-anchor="middle" font-size="11" fill="#5F5E5A">30VPC = 435本の接続が必要。推移的ルーティング非対応。運用不可能。</text>

      <!-- PEERING -->
      <g id="tgw-g-peer">
        <rect x="290" y="60"  width="100" height="40" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="340" y="84"  text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">VPC 1</text>
        <rect x="480" y="140" width="100" height="40" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="530" y="164" text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">VPC 2</text>
        <rect x="480" y="270" width="100" height="40" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="530" y="294" text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">VPC 3</text>
        <rect x="290" y="340" width="100" height="40" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="340" y="364" text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">VPC 4</text>
        <rect x="100" y="270" width="100" height="40" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="150" y="294" text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">VPC 5</text>
        <rect x="100" y="140" width="100" height="40" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="150" y="164" text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">VPC 6</text>
        <line x1="390" y1="80"  x2="480" y2="150" stroke="#E24B4A" stroke-width="1" opacity="0.7"/>
        <line x1="390" y1="90"  x2="480" y2="275" stroke="#E24B4A" stroke-width="1" opacity="0.7"/>
        <line x1="340" y1="100" x2="340" y2="340" stroke="#E24B4A" stroke-width="1" opacity="0.7"/>
        <line x1="290" y1="90"  x2="200" y2="275" stroke="#E24B4A" stroke-width="1" opacity="0.7"/>
        <line x1="290" y1="80"  x2="200" y2="150" stroke="#E24B4A" stroke-width="1" opacity="0.7"/>
        <line x1="530" y1="180" x2="530" y2="270" stroke="#E24B4A" stroke-width="1" opacity="0.7"/>
        <line x1="480" y1="170" x2="390" y2="345" stroke="#E24B4A" stroke-width="1" opacity="0.7"/>
        <line x1="480" y1="160" x2="200" y2="280" stroke="#E24B4A" stroke-width="1" opacity="0.7"/>
        <line x1="480" y1="150" x2="200" y2="155" stroke="#E24B4A" stroke-width="1" opacity="0.7"/>
        <line x1="480" y1="285" x2="390" y2="350" stroke="#E24B4A" stroke-width="1" opacity="0.7"/>
        <line x1="480" y1="290" x2="200" y2="290" stroke="#E24B4A" stroke-width="1" opacity="0.7"/>
        <line x1="480" y1="275" x2="200" y2="165" stroke="#E24B4A" stroke-width="1" opacity="0.7"/>
        <line x1="290" y1="360" x2="200" y2="295" stroke="#E24B4A" stroke-width="1" opacity="0.7"/>
        <line x1="290" y1="350" x2="200" y2="170" stroke="#E24B4A" stroke-width="1" opacity="0.7"/>
        <line x1="150" y1="270" x2="150" y2="180" stroke="#E24B4A" stroke-width="1" opacity="0.7"/>
        <rect x="200" y="200" width="280" height="72" rx="8" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
        <text x="340" y="226" text-anchor="middle" font-size="13" font-weight="500" fill="#791F1F" dominant-baseline="central">6VPCで接続数 = 15本</text>
        <text x="340" y="248" text-anchor="middle" font-size="11" fill="#A32D2D" dominant-baseline="central">30VPCなら = 435本！</text>
        <text x="340" y="264" text-anchor="middle" font-size="11" fill="#A32D2D" dominant-baseline="central">推移的ルーティング非対応</text>
      </g>

      <!-- TGW HUB -->
      <g id="tgw-g-hub" style="display:none">
        <rect x="255" y="160" width="170" height="60" rx="10" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
        <text x="340" y="183" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489" dominant-baseline="central">Transit Gateway</text>
        <text x="340" y="203" text-anchor="middle" font-size="11" fill="#534AB7" dominant-baseline="central">ルートテーブルで経路を管理</text>
        <rect x="285" y="60"  width="110" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="340" y="86"  text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">VPC A</text>
        <rect x="490" y="160" width="110" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="545" y="186" text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">VPC B</text>
        <rect x="400" y="300" width="110" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="455" y="326" text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">VPC C</text>
        <rect x="175" y="300" width="110" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="230" y="326" text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">VPC D</text>
        <rect x="80"  y="160" width="110" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="135" y="186" text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">VPC E</text>
        <line x1="340" y1="104" x2="340" y2="160" stroke="#534AB7" stroke-width="2" marker-end="url(#tgw-arr)"/>
        <line x1="490" y1="182" x2="425" y2="185" stroke="#534AB7" stroke-width="2" marker-end="url(#tgw-arr)"/>
        <line x1="440" y1="300" x2="390" y2="220" stroke="#534AB7" stroke-width="2" marker-end="url(#tgw-arr)"/>
        <line x1="230" y1="300" x2="290" y2="220" stroke="#534AB7" stroke-width="2" marker-end="url(#tgw-arr)"/>
        <line x1="190" y1="182" x2="255" y2="185" stroke="#534AB7" stroke-width="2" marker-end="url(#tgw-arr)"/>
        <rect x="30" y="360" width="620" height="44" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
        <text x="340" y="386" text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">接続数 = VPC数だけ / 推移的ルーティング対応 / RAM でアカウント間共有可</text>
      </g>
    </svg>
  </div>

  <!-- TGW基本構造 -->
  <div id="tgw-basic" class="tgw-panel">
    <svg width="100%" viewBox="0 0 680 340">
      <defs><marker id="tgw-arr2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">Transit Gateway：クラウドのネットワークハブ</text>
      <rect x="230" y="120" width="220" height="60" rx="10" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="340" y="144" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489" dominant-baseline="central">Transit Gateway</text>
      <text x="340" y="164" text-anchor="middle" font-size="11" fill="#534AB7" dominant-baseline="central">ルートテーブルで経路を管理</text>
      <rect x="255" y="196" width="170" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="340" y="214" text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">TGW ルートテーブル</text>
      <text x="340" y="230" text-anchor="middle" font-size="11" fill="#085041" dominant-baseline="central">全VPCの経路を一元管理</text>
      <rect x="40"  y="50"  width="110" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="95"  y="76"  text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">VPC A 10.0.0.0/16</text>
      <rect x="530" y="50"  width="110" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="585" y="76"  text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">VPC B 10.1.0.0/16</text>
      <rect x="40"  y="246" width="110" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="95"  y="272" text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">VPC C 10.2.0.0/16</text>
      <rect x="530" y="246" width="110" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="585" y="272" text-anchor="middle" font-size="12" font-weight="500" fill="#085041" dominant-baseline="central">VPC D 10.3.0.0/16</text>
      <line x1="150" y1="72"  x2="230" y2="140" stroke="#534AB7" stroke-width="1.5" marker-end="url(#tgw-arr2)"/>
      <line x1="530" y1="72"  x2="450" y2="140" stroke="#534AB7" stroke-width="1.5" marker-end="url(#tgw-arr2)"/>
      <line x1="150" y1="268" x2="230" y2="178" stroke="#534AB7" stroke-width="1.5" marker-end="url(#tgw-arr2)"/>
      <line x1="530" y1="268" x2="450" y2="178" stroke="#534AB7" stroke-width="1.5" marker-end="url(#tgw-arr2)"/>
      <text x="178" y="100" text-anchor="middle" font-size="11" fill="#534AB7">アタッチメント</text>
      <text x="500" y="100" text-anchor="middle" font-size="11" fill="#534AB7">アタッチメント</text>
      <text x="178" y="228" text-anchor="middle" font-size="11" fill="#534AB7">アタッチメント</text>
      <text x="500" y="228" text-anchor="middle" font-size="11" fill="#534AB7">アタッチメント</text>
      <rect x="40" y="302" width="600" height="32" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="322" text-anchor="middle" font-size="12" font-weight="500" fill="#633806" dominant-baseline="central">VPCはTGWにアタッチするだけ。あとはTGWのルートテーブルが経路を全部さばく。</text>
    </svg>
  </div>

  <!-- ユースケース -->
  <div id="tgw-usecases" class="tgw-panel">
    <svg width="100%" viewBox="0 0 680 320">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">Transit Gateway ユースケース</text>
      <rect x="40"  y="44" width="290" height="80" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="185" y="70" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489">マルチVPC接続</text>
      <text x="185" y="92" text-anchor="middle" font-size="11" fill="#534AB7">複数VPCをハブ&スポークで接続</text>
      <text x="185" y="112" text-anchor="middle" font-size="11" fill="#534AB7">推移的ルーティングで柔軟な経路制御</text>
      <rect x="350" y="44" width="290" height="80" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="495" y="70" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489">リージョン間接続</text>
      <text x="495" y="92" text-anchor="middle" font-size="11" fill="#534AB7">TGWピアリングで異なるリージョンの</text>
      <text x="495" y="112" text-anchor="middle" font-size="11" fill="#534AB7">VPCを接続可能</text>
      <rect x="40"  y="144" width="290" height="80" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="185" y="170" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">オンプレ接続</text>
      <text x="185" y="192" text-anchor="middle" font-size="11" fill="#085041">Site-to-Site VPN / Direct Connect</text>
      <text x="185" y="212" text-anchor="middle" font-size="11" fill="#085041">と組み合わせてハイブリッド構成</text>
      <rect x="350" y="144" width="290" height="80" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="495" y="170" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">アカウント間共有</text>
      <text x="495" y="192" text-anchor="middle" font-size="11" fill="#085041">AWS RAM（Resource Access Manager）</text>
      <text x="495" y="212" text-anchor="middle" font-size="11" fill="#085041">で複数アカウントと共有</text>
      <rect x="40" y="244" width="600" height="56" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="268" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">SAA頻出</text>
      <text x="340" y="288" text-anchor="middle" font-size="11" fill="#633806">「複数VPCを接続したい・オンプレと繋ぎたい」→ Transit Gateway が最初の候補</text>
    </svg>
  </div>
</div>

<script>
  function tgwTab(t: string) {
    document.querySelectorAll('[id^="tgw-"]').forEach(el => {
      if(el.classList.contains('tgw-panel')) el.classList.remove('active');
    });
    document.getElementById('tgw-' + t)?.classList.add('active');
    document.querySelectorAll('.tgw-btn').forEach(el => el.classList.remove('active'));
    (event?.target as HTMLElement)?.classList.add('active');
  }

  function tgwMode(m: string) {
    const peer = document.getElementById('tgw-g-peer')!;
    const hub  = document.getElementById('tgw-g-hub')!;
    const title = document.getElementById('tgw-mode-title')!;
    const sub   = document.getElementById('tgw-mode-sub')!;
    document.getElementById('tgw-btn-peer')!.classList.toggle('active', m === 'peer');
    document.getElementById('tgw-btn-hub')!.classList.toggle('active', m === 'hub');
    if(m === 'peer'){
      peer.style.display = ''; hub.style.display = 'none';
      title.textContent = 'VPCピアリング：フルメッシュ構成';
      title.setAttribute('fill','#A32D2D');
      sub.textContent = '30VPC = 435本の接続が必要。推移的ルーティング非対応。運用不可能。';
    } else {
      peer.style.display = 'none'; hub.style.display = '';
      title.textContent = 'Transit Gateway：ハブ＆スポーク構成';
      title.setAttribute('fill','#3C3489');
      sub.textContent = '30VPC = 30本の接続だけ。VPC追加も1本追加するだけ。';
    }
  }
  (window as any).tgwTab = tgwTab;
  (window as any).tgwMode = tgwMode;
</script>