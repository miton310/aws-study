---
---
<div>
  <style>
    .ec2-btn{cursor:pointer;font-size:12px;padding:4px 12px;border-radius:6px;border:1px solid #e5e7eb;background:#f9fafb;color:#111827;font-family:inherit;}
    .dark .ec2-btn{border-color:#374151;background:#1f2937;color:#f9fafb;}
    .ec2-btn.active{background:#534AB7;color:#fff;border-color:#534AB7;}
    .ec2-panel{display:none;}
    .ec2-panel.active{display:block;}
  </style>

  <div style="display:flex;gap:6px;margin:0 0 10px;flex-wrap:wrap">
    <button class="ec2-btn active" onclick="ec2Tab('option')">購入オプション</button>
    <button class="ec2-btn" onclick="ec2Tab('spot')">スポット詳細</button>
    <button class="ec2-btn" onclick="ec2Tab('pattern')">頻出パターン</button>
  </div>

  <div id="ec2-option" class="ec2-panel active">
    <svg width="100%" viewBox="0 0 680 380">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">EC2購入オプション：コストと柔軟性のトレードオフ</text>
      <rect x="40"  y="50" width="270" height="80" rx="8" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/>
      <text x="175" y="78" text-anchor="middle" font-size="13" font-weight="500" fill="#444441">オンデマンド</text>
      <text x="175" y="102" text-anchor="middle" font-size="12" fill="#5F5E5A">使った分だけ秒単位で課金</text>
      <text x="175" y="122" text-anchor="middle" font-size="12" fill="#5F5E5A">コスト高・柔軟性最大</text>
      <rect x="370" y="50" width="270" height="80" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/>
      <text x="505" y="78" text-anchor="middle" font-size="13" font-weight="500" fill="#0C447C">リザーブドインスタンス（RI）</text>
      <text x="505" y="102" text-anchor="middle" font-size="12" fill="#185FA5">1年 or 3年の予約で最大72%割引</text>
      <text x="505" y="122" text-anchor="middle" font-size="12" fill="#185FA5">安定した継続利用向け</text>
      <rect x="40"  y="150" width="270" height="80" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
      <text x="175" y="178" text-anchor="middle" font-size="13" font-weight="500" fill="#712B13">スポットインスタンス</text>
      <text x="175" y="202" text-anchor="middle" font-size="12" fill="#993C1D">最大90%割引・中断リスクあり</text>
      <text x="175" y="222" text-anchor="middle" font-size="12" fill="#993C1D">バッチ・CI/CDなど耐障害性が必要</text>
      <rect x="370" y="150" width="270" height="80" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="505" y="178" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489">Savings Plans</text>
      <text x="505" y="202" text-anchor="middle" font-size="12" fill="#534AB7">$/時間の使用量をコミット</text>
      <text x="505" y="222" text-anchor="middle" font-size="12" fill="#534AB7">EC2・Lambda・Fargateに適用</text>
      <rect x="40"  y="250" width="270" height="80" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="175" y="278" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">Dedicated Host</text>
      <text x="175" y="302" text-anchor="middle" font-size="12" fill="#854F0B">物理サーバーを専有</text>
      <text x="175" y="322" text-anchor="middle" font-size="12" fill="#854F0B">ライセンス持ち込み（BYOL）向け</text>
      <rect x="370" y="250" width="270" height="80" rx="8" fill="#EAF3DE" stroke="#3B6D11" stroke-width="0.5"/>
      <text x="505" y="278" text-anchor="middle" font-size="13" font-weight="500" fill="#27500A">Savings Plans vs RI</text>
      <text x="505" y="302" text-anchor="middle" font-size="12" fill="#3B6D11">SP：インスタンスタイプ変更OK</text>
      <text x="505" y="322" text-anchor="middle" font-size="12" fill="#3B6D11">RI：特定タイプを予約・割引率高い</text>
    </svg>
  </div>

  <div id="ec2-spot" class="ec2-panel">
    <svg width="100%" viewBox="0 0 680 340">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">スポットインスタンス：最大90%割引・中断リスクあり</text>
      <rect x="40" y="50" width="600" height="68" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
      <text x="340" y="78" text-anchor="middle" font-size="13" font-weight="500" fill="#712B13">仕組み</text>
      <text x="60" y="102" font-size="12" fill="#993C1D">AWSの余剰キャパシティを格安で使う → AWSが必要になったら2分前通知で強制終了</text>
      <rect x="40"  y="140" width="270" height="120" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="175" y="168" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">向いている（中断OK）</text>
      <text x="175" y="194" text-anchor="middle" font-size="12" fill="#085041">バッチ処理</text>
      <text x="175" y="216" text-anchor="middle" font-size="12" fill="#085041">CI/CDパイプライン</text>
      <text x="175" y="238" text-anchor="middle" font-size="12" fill="#085041">機械学習の学習・画像処理</text>
      <rect x="370" y="140" width="270" height="120" rx="8" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
      <text x="505" y="168" text-anchor="middle" font-size="13" font-weight="500" fill="#791F1F">向いていない（中断NG）</text>
      <text x="505" y="194" text-anchor="middle" font-size="12" fill="#A32D2D">Webサーバー・本番DB</text>
      <text x="505" y="216" text-anchor="middle" font-size="12" fill="#A32D2D">継続的なAPI処理</text>
      <text x="505" y="238" text-anchor="middle" font-size="12" fill="#A32D2D">クリティカルな業務</text>
      <rect x="40" y="278" width="600" height="44" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="304" text-anchor="middle" font-size="12" font-weight="500" fill="#633806">SAA頻出：「コスト最小・中断許容できるバッチ」→ スポットインスタンス</text>
    </svg>
  </div>

  <div id="ec2-pattern" class="ec2-panel">
    <svg width="100%" viewBox="0 0 680 320">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">SAA頻出パターン</text>
      <rect x="40" y="44" width="600" height="256" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="60" y="74"  font-size="12" fill="#633806">「テスト・開発環境で短期利用」</text><text x="500" y="74"  font-size="12" font-weight="500" fill="#412402">→ オンデマンド</text>
      <line x1="40" y1="86" x2="640" y2="86" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="108" font-size="12" fill="#633806">「24時間365日稼働・1年以上継続」</text><text x="500" y="108" font-size="12" font-weight="500" fill="#412402">→ RI（1年 or 3年）</text>
      <line x1="40" y1="120" x2="640" y2="120" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="142" font-size="12" fill="#633806">「中断されてもいいバッチ・コスト最小」</text><text x="500" y="142" font-size="12" font-weight="500" fill="#412402">→ スポットインスタンス</text>
      <line x1="40" y1="154" x2="640" y2="154" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="176" font-size="12" fill="#633806">「インスタンスタイプを変えながらコスト削減」</text><text x="500" y="176" font-size="12" font-weight="500" fill="#412402">→ Savings Plans（Compute）</text>
      <line x1="40" y1="188" x2="640" y2="188" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="210" font-size="12" fill="#633806">「Windows Serverライセンスを持ち込みたい」</text><text x="500" y="210" font-size="12" font-weight="500" fill="#412402">→ Dedicated Host</text>
      <line x1="40" y1="222" x2="640" y2="222" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="244" font-size="12" fill="#633806">「本番（オンデマンド）+ バッチ（スポット）の混在」</text><text x="500" y="244" font-size="12" font-weight="500" fill="#412402">→ 混合インスタンスポリシー</text>
      <line x1="40" y1="256" x2="640" y2="256" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="282" font-size="12" fill="#633806">「Lambda・Fargate・EC2まとめてコスト削減」</text><text x="500" y="282" font-size="12" font-weight="500" fill="#412402">→ Savings Plans（Compute SP）</text>
    </svg>
  </div>
</div>

<script>
  function ec2Tab(t: string) {
    document.querySelectorAll('[id^="ec2-"]').forEach(el => el.classList.remove('active'));
    document.getElementById('ec2-' + t)?.classList.add('active');
    document.querySelectorAll('.ec2-btn').forEach(el => el.classList.remove('active'));
    (event?.target as HTMLElement)?.classList.add('active');
  }
  (window as any).ec2Tab = ec2Tab;
</script>