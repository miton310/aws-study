---
---
<div>
  <div style="display:flex;gap:6px;margin:0 0 10px;flex-wrap:wrap">
    <button class="ec2-btn active" onclick="ec2Tab('option')">購入オプション</button>
    <button class="ec2-btn" onclick="ec2Tab('family')">インスタンスファミリー</button>
    <button class="ec2-btn" onclick="ec2Tab('storage')">ストレージ</button>
    <button class="ec2-btn" onclick="ec2Tab('ami')">AMI</button>
    <button class="ec2-btn" onclick="ec2Tab('spot')">スポット詳細</button>
    <button class="ec2-btn" onclick="ec2Tab('placement')">プレイスメントグループ</button>
    <button class="ec2-btn" onclick="ec2Tab('connect')">接続方法</button>
    <button class="ec2-btn" onclick="ec2Tab('pattern')">頻出パターン</button>
  </div>

  <!-- EC2購入オプションパネル -->
  <div id="ec2-option" class="ec2-panel active">
    <div class="ec2-option-title">EC2購入オプション</div>

    <!-- メイン3オプション -->
    <div class="ec2-option-grid">
      <!-- オンデマンド -->
      <div class="ec2-option-card ec2-option-ondemand">
        <div class="ec2-option-header">
          <div class="ec2-option-name">オンデマンド</div>
          <div class="ec2-option-badge">基準価格</div>
        </div>
        <div class="ec2-option-body">
          <div class="ec2-option-point">使った分だけ秒単位で課金</div>
          <div class="ec2-option-point">予約不要・いつでも起動/停止</div>
          <div class="ec2-option-point">柔軟性最大・コスト高</div>
        </div>
        <div class="ec2-option-usecase">
          <span class="ec2-option-usecase-label">向いている</span>
          短期・テスト・開発・不定期な負荷
        </div>
      </div>

      <!-- リザーブドインスタンス -->
      <div class="ec2-option-card ec2-option-ri">
        <div class="ec2-option-header">
          <div class="ec2-option-name">リザーブドインスタンス（RI）</div>
          <div class="ec2-option-badge ec2-option-badge-save">最大72%割引</div>
        </div>
        <div class="ec2-option-body">
          <div class="ec2-option-point">1年 or 3年の予約でコスト削減</div>
          <div class="ec2-option-point">特定のインスタンスタイプを予約</div>
          <div class="ec2-option-point">前払いオプションで割引率UP</div>
        </div>
        <div class="ec2-option-usecase">
          <span class="ec2-option-usecase-label">向いている</span>
          24時間365日稼働・本番DB・基幹システム
        </div>
      </div>

      <!-- スポットインスタンス -->
      <div class="ec2-option-card ec2-option-spot">
        <div class="ec2-option-header">
          <div class="ec2-option-name">スポットインスタンス</div>
          <div class="ec2-option-badge ec2-option-badge-save">最大90%割引</div>
        </div>
        <div class="ec2-option-body">
          <div class="ec2-option-point">AWSの余剰キャパシティを利用</div>
          <div class="ec2-option-point ec2-option-warn">2分前通知で強制終了リスク</div>
          <div class="ec2-option-point">中断されても問題ない処理向け</div>
        </div>
        <div class="ec2-option-usecase">
          <span class="ec2-option-usecase-label">向いている</span>
          バッチ処理・CI/CD・機械学習
        </div>
      </div>
    </div>

    <!-- サブオプション -->
    <div class="ec2-option-sub-grid">
      <!-- Savings Plans -->
      <div class="ec2-option-card-sub ec2-option-sp">
        <div class="ec2-option-sub-header">
          <div class="ec2-option-sub-name">Savings Plans</div>
          <div class="ec2-option-badge ec2-option-badge-save">最大72%割引</div>
        </div>
        <div class="ec2-option-sub-body">
          <div class="ec2-option-point">$/時間の使用量をコミット（1年 or 3年）</div>
          <div class="ec2-option-point">インスタンスタイプ・サイズ変更OK</div>
          <div class="ec2-option-point">EC2・Lambda・Fargateに適用可能</div>
        </div>
      </div>

      <!-- Dedicated Host -->
      <div class="ec2-option-card-sub ec2-option-dedicated">
        <div class="ec2-option-sub-header">
          <div class="ec2-option-sub-name">Dedicated Host</div>
          <div class="ec2-option-badge">専用物理サーバー</div>
        </div>
        <div class="ec2-option-sub-body">
          <div class="ec2-option-point">物理サーバーを丸ごと専有</div>
          <div class="ec2-option-point">ソケット/コア単位のライセンス持ち込み（BYOL）</div>
          <div class="ec2-option-point">コンプライアンス要件対応</div>
        </div>
      </div>
    </div>

    <!-- 比較表 -->
    <div class="ec2-option-compare">
      <div class="ec2-option-compare-title">Savings Plans vs リザーブドインスタンス</div>
      <div class="ec2-option-compare-grid">
        <div class="ec2-option-compare-row ec2-option-compare-header">
          <div></div>
          <div>Savings Plans</div>
          <div>リザーブドインスタンス</div>
        </div>
        <div class="ec2-option-compare-row">
          <div class="ec2-option-compare-label">柔軟性</div>
          <div class="ec2-option-compare-good">タイプ・サイズ変更OK</div>
          <div class="ec2-option-compare-bad">特定タイプに固定</div>
        </div>
        <div class="ec2-option-compare-row">
          <div class="ec2-option-compare-label">割引率</div>
          <div>最大72%</div>
          <div class="ec2-option-compare-good">最大72%（同等〜やや高い）</div>
        </div>
        <div class="ec2-option-compare-row">
          <div class="ec2-option-compare-label">適用範囲</div>
          <div class="ec2-option-compare-good">EC2・Lambda・Fargate</div>
          <div>EC2のみ</div>
        </div>
        <div class="ec2-option-compare-row">
          <div class="ec2-option-compare-label">コミット</div>
          <div>$/時間の使用量</div>
          <div>特定インスタンス</div>
        </div>
      </div>
    </div>

    <!-- Savings Plans 詳細比較 -->
    <div class="ec2-sp-section">
      <div class="ec2-sp-title">Savings Plans の2種類</div>
      <div class="ec2-sp-grid">
        <!-- EC2 Instance Savings Plans -->
        <div class="ec2-sp-card ec2-sp-instance">
          <div class="ec2-sp-card-header">
            <div class="ec2-sp-card-name">EC2 Instance Savings Plans</div>
            <div class="ec2-sp-card-badge">最大72%割引</div>
          </div>
          <div class="ec2-sp-card-desc">特定リージョン + 特定インスタンスファミリーにコミット</div>
          <div class="ec2-sp-card-body">
            <div class="ec2-sp-item ec2-sp-good">割引率が高い</div>
            <div class="ec2-sp-item ec2-sp-good">OS・テナンシー変更OK</div>
            <div class="ec2-sp-item ec2-sp-good">サイズ変更OK（M5.large→M5.xlarge）</div>
            <div class="ec2-sp-item ec2-sp-bad">リージョン変更NG</div>
            <div class="ec2-sp-item ec2-sp-bad">ファミリー変更NG（M5→C5）</div>
          </div>
          <div class="ec2-sp-card-example">
            <strong>例:</strong> us-east-1のM5ファミリーを$10/時間コミット
          </div>
        </div>

        <!-- Compute Savings Plans -->
        <div class="ec2-sp-card ec2-sp-compute">
          <div class="ec2-sp-card-header">
            <div class="ec2-sp-card-name">Compute Savings Plans</div>
            <div class="ec2-sp-card-badge">最大66%割引</div>
          </div>
          <div class="ec2-sp-card-desc">コンピュート全体の使用量（$/時間）にコミット</div>
          <div class="ec2-sp-card-body">
            <div class="ec2-sp-item ec2-sp-good">リージョン変更OK</div>
            <div class="ec2-sp-item ec2-sp-good">ファミリー変更OK</div>
            <div class="ec2-sp-item ec2-sp-good">EC2 + Fargate + Lambda に適用</div>
            <div class="ec2-sp-item ec2-sp-good">将来のアーキテクチャ変更に柔軟</div>
            <div class="ec2-sp-item ec2-sp-warn">割引率はやや低め</div>
          </div>
          <div class="ec2-sp-card-example">
            <strong>例:</strong> コンピュート全体で$10/時間コミット（どこでも使える）
          </div>
        </div>
      </div>

      <!-- 選び方ガイド -->
      <div class="ec2-sp-guide">
        <div class="ec2-sp-guide-title">どちらを選ぶ？</div>
        <div class="ec2-sp-guide-grid">
          <div class="ec2-sp-guide-item">
            <span class="ec2-sp-guide-q">ワークロードが安定・同じファミリーを長期利用</span>
            <span class="ec2-sp-guide-a">→ EC2 Instance SP（割引率重視）</span>
          </div>
          <div class="ec2-sp-guide-item">
            <span class="ec2-sp-guide-q">Fargate/Lambdaへの移行可能性あり</span>
            <span class="ec2-sp-guide-a">→ Compute SP（柔軟性重視）</span>
          </div>
          <div class="ec2-sp-guide-item">
            <span class="ec2-sp-guide-q">複数リージョンに分散したワークロード</span>
            <span class="ec2-sp-guide-a">→ Compute SP</span>
          </div>
          <div class="ec2-sp-guide-item">
            <span class="ec2-sp-guide-q">最大の割引率を得たい</span>
            <span class="ec2-sp-guide-a">→ EC2 Instance SP</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- インスタンスファミリー -->
  <div id="ec2-family" class="ec2-panel">
    <div class="ec2-family-title">インスタンスファミリー</div>

    <!-- 命名規則 -->
    <div class="ec2-family-naming">
      <div class="ec2-family-naming-title">インスタンスタイプの読み方</div>
      <div class="ec2-family-naming-example">
        <span class="ec2-family-naming-part ec2-family-naming-family">m</span>
        <span class="ec2-family-naming-part ec2-family-naming-gen">5</span>
        <span class="ec2-family-naming-dot">.</span>
        <span class="ec2-family-naming-part ec2-family-naming-size">xlarge</span>
      </div>
      <div class="ec2-family-naming-labels">
        <div class="ec2-family-naming-label">
          <span class="ec2-family-naming-arrow ec2-family-naming-family">↑</span>
          <span>ファミリー（用途）</span>
        </div>
        <div class="ec2-family-naming-label">
          <span class="ec2-family-naming-arrow ec2-family-naming-gen">↑</span>
          <span>世代（大きいほど新しい）</span>
        </div>
        <div class="ec2-family-naming-label">
          <span class="ec2-family-naming-arrow ec2-family-naming-size">↑</span>
          <span>サイズ</span>
        </div>
      </div>
    </div>

    <!-- ファミリー一覧 -->
    <div class="ec2-family-grid">
      <!-- 汎用 -->
      <div class="ec2-family-card ec2-family-general">
        <div class="ec2-family-card-header">
          <div class="ec2-family-card-icon">⚖️</div>
          <div class="ec2-family-card-name">汎用</div>
          <div class="ec2-family-card-types">T / M</div>
        </div>
        <div class="ec2-family-card-desc">CPU・メモリ・ネットワークのバランス型</div>
        <div class="ec2-family-card-use">
          <span class="ec2-family-use-label">用途</span>
          Webサーバー、小〜中規模DB、開発環境
        </div>
        <div class="ec2-family-card-note">
          <strong>T系</strong>：バースト可能（CPUクレジット制）・低コスト
        </div>
      </div>

      <!-- コンピューティング最適化 -->
      <div class="ec2-family-card ec2-family-compute">
        <div class="ec2-family-card-header">
          <div class="ec2-family-card-icon">⚡</div>
          <div class="ec2-family-card-name">コンピューティング最適化</div>
          <div class="ec2-family-card-types">C</div>
        </div>
        <div class="ec2-family-card-desc">高性能プロセッサ搭載</div>
        <div class="ec2-family-card-use">
          <span class="ec2-family-use-label">用途</span>
          バッチ処理、HPC、ゲームサーバー、科学計算
        </div>
        <div class="ec2-family-card-note">
          CPU負荷の高いワークロードに最適
        </div>
      </div>

      <!-- メモリ最適化 -->
      <div class="ec2-family-card ec2-family-memory">
        <div class="ec2-family-card-header">
          <div class="ec2-family-card-icon">🧠</div>
          <div class="ec2-family-card-name">メモリ最適化</div>
          <div class="ec2-family-card-types">R / X / z</div>
        </div>
        <div class="ec2-family-card-desc">大容量メモリ搭載</div>
        <div class="ec2-family-card-use">
          <span class="ec2-family-use-label">用途</span>
          インメモリDB、Redis、SAP HANA、ビッグデータ
        </div>
        <div class="ec2-family-card-note">
          <strong>X系</strong>：超大容量メモリ（最大24TB）
        </div>
      </div>

      <!-- ストレージ最適化 -->
      <div class="ec2-family-card ec2-family-storage">
        <div class="ec2-family-card-header">
          <div class="ec2-family-card-icon">💾</div>
          <div class="ec2-family-card-name">ストレージ最適化</div>
          <div class="ec2-family-card-types">I / D / H</div>
        </div>
        <div class="ec2-family-card-desc">高速ローカルストレージ</div>
        <div class="ec2-family-card-use">
          <span class="ec2-family-use-label">用途</span>
          NoSQL DB、データウェアハウス、分散ファイルシステム
        </div>
        <div class="ec2-family-card-note">
          <strong>I系</strong>：NVMe SSD　<strong>D/H系</strong>：大容量HDD
        </div>
      </div>

      <!-- 高速コンピューティング -->
      <div class="ec2-family-card ec2-family-accelerated">
        <div class="ec2-family-card-header">
          <div class="ec2-family-card-icon">🎮</div>
          <div class="ec2-family-card-name">高速コンピューティング</div>
          <div class="ec2-family-card-types">P / G / Inf / Trn</div>
        </div>
        <div class="ec2-family-card-desc">GPU・専用チップ搭載</div>
        <div class="ec2-family-card-use">
          <span class="ec2-family-use-label">用途</span>
          機械学習、グラフィックス処理、動画エンコード
        </div>
        <div class="ec2-family-card-note">
          <strong>P系</strong>：ML学習　<strong>G系</strong>：グラフィックス　<strong>Inf/Trn</strong>：推論
        </div>
      </div>
    </div>

    <!-- SAA頻出 -->
    <div class="ec2-family-note">
      <strong>SAA頻出パターン</strong>
      <div class="ec2-family-patterns">
        <div class="ec2-family-pattern">
          <span class="ec2-family-q">「CPU負荷が高いバッチ処理」</span>
          <span class="ec2-family-a">→ C系（C5, C6i, C7g）</span>
        </div>
        <div class="ec2-family-pattern">
          <span class="ec2-family-q">「大量データをメモリに載せたい」</span>
          <span class="ec2-family-a">→ R系（R5, R6i）/ X系</span>
        </div>
        <div class="ec2-family-pattern">
          <span class="ec2-family-q">「コスト重視・負荷が不定期」</span>
          <span class="ec2-family-a">→ T系（T3, T4g）バースト可能</span>
        </div>
        <div class="ec2-family-pattern">
          <span class="ec2-family-q">「機械学習のトレーニング」</span>
          <span class="ec2-family-a">→ P系（P4d, P5）/ Trn系</span>
        </div>
        <div class="ec2-family-pattern">
          <span class="ec2-family-q">「高速ローカルストレージが必要」</span>
          <span class="ec2-family-a">→ I系（I3, I4i）NVMe SSD</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ストレージ -->
  <div id="ec2-storage" class="ec2-panel">
    <div class="ec2-storage-title">EC2で使えるブロックストレージ</div>

    <!-- EBS vs インスタンスストア比較 -->
    <div class="ec2-storage-compare">
      <div class="ec2-storage-card ec2-storage-ebs">
        <div class="ec2-storage-card-header">
          <div class="ec2-storage-card-icon">💾</div>
          <div class="ec2-storage-card-name">EBS（Elastic Block Store）</div>
          <div class="ec2-storage-card-badge">永続的</div>
        </div>
        <div class="ec2-storage-card-body">
          <div class="ec2-storage-point ec2-storage-good">ネットワーク接続型（別のAZ以外のEC2に付け替え可能）</div>
          <div class="ec2-storage-point ec2-storage-good">インスタンス停止/終了後もデータ保持</div>
          <div class="ec2-storage-point ec2-storage-good">スナップショット（S3に増分バックアップ）</div>
          <div class="ec2-storage-point ec2-storage-good">暗号化対応（KMS統合）</div>
          <div class="ec2-storage-point">同一AZ内のEC2にのみアタッチ可能</div>
        </div>
        <div class="ec2-storage-usecase">
          <span class="ec2-storage-usecase-label">用途</span>
          OS・DB・アプリケーションデータ
        </div>
      </div>

      <div class="ec2-storage-card ec2-storage-instance">
        <div class="ec2-storage-card-header">
          <div class="ec2-storage-card-icon">⚡</div>
          <div class="ec2-storage-card-name">インスタンスストア</div>
          <div class="ec2-storage-card-badge ec2-storage-badge-warn">一時的</div>
        </div>
        <div class="ec2-storage-card-body">
          <div class="ec2-storage-point ec2-storage-good">物理的に接続（超高速I/O）</div>
          <div class="ec2-storage-point ec2-storage-good">追加コストなし（インスタンス料金に含む）</div>
          <div class="ec2-storage-point ec2-storage-warn">インスタンス停止/終了でデータ消失</div>
          <div class="ec2-storage-point ec2-storage-warn">スナップショット不可</div>
          <div class="ec2-storage-point">一部のインスタンスタイプのみ利用可能</div>
        </div>
        <div class="ec2-storage-usecase">
          <span class="ec2-storage-usecase-label">用途</span>
          キャッシュ・一時ファイル・バッファ
        </div>
      </div>
    </div>

    <!-- EBSボリュームタイプ -->
    <div class="ec2-storage-types">
      <div class="ec2-storage-types-title">EBSボリュームタイプ</div>
      <div class="ec2-storage-types-grid">
        <!-- SSD -->
        <div class="ec2-storage-type ec2-storage-type-ssd">
          <div class="ec2-storage-type-category">SSD（IOPS重視）</div>
          <div class="ec2-storage-type-items">
            <div class="ec2-storage-type-item">
              <div class="ec2-storage-type-name">gp3 / gp2</div>
              <div class="ec2-storage-type-desc">汎用SSD</div>
              <div class="ec2-storage-type-detail">gp3: IOPS・スループット個別設定可</div>
              <div class="ec2-storage-type-use">一般的なワークロード</div>
            </div>
            <div class="ec2-storage-type-item">
              <div class="ec2-storage-type-name">io2 / io1</div>
              <div class="ec2-storage-type-desc">プロビジョンドIOPS SSD</div>
              <div class="ec2-storage-type-detail">最大64,000 IOPS・マルチアタッチ対応</div>
              <div class="ec2-storage-type-use">高性能DB（Oracle, SAP等）</div>
            </div>
          </div>
        </div>

        <!-- HDD -->
        <div class="ec2-storage-type ec2-storage-type-hdd">
          <div class="ec2-storage-type-category">HDD（スループット重視）</div>
          <div class="ec2-storage-type-items">
            <div class="ec2-storage-type-item">
              <div class="ec2-storage-type-name">st1</div>
              <div class="ec2-storage-type-desc">スループット最適化HDD</div>
              <div class="ec2-storage-type-detail">最大500 MB/s</div>
              <div class="ec2-storage-type-use">ビッグデータ・ログ処理</div>
            </div>
            <div class="ec2-storage-type-item">
              <div class="ec2-storage-type-name">sc1</div>
              <div class="ec2-storage-type-desc">コールドHDD</div>
              <div class="ec2-storage-type-detail">最低コスト</div>
              <div class="ec2-storage-type-use">アクセス頻度の低いデータ</div>
            </div>
          </div>
        </div>
      </div>
      <div class="ec2-storage-boot-note">
        ※ ブートボリュームはSSD（gp2/gp3/io1/io2）のみ対応。HDDはブート不可。
      </div>
    </div>

    <!-- スナップショット -->
    <div class="ec2-storage-snapshot">
      <div class="ec2-storage-snapshot-title">EBSスナップショット</div>
      <div class="ec2-storage-snapshot-flow">
        <div class="ec2-storage-snapshot-item">
          <div class="ec2-storage-snapshot-icon">💾</div>
          <div class="ec2-storage-snapshot-label">EBSボリューム</div>
        </div>
        <div class="ec2-storage-snapshot-arrow">→</div>
        <div class="ec2-storage-snapshot-item ec2-storage-snapshot-s3">
          <div class="ec2-storage-snapshot-icon">📸</div>
          <div class="ec2-storage-snapshot-label">スナップショット</div>
