---
---
<div>
  <div style="display:flex;gap:6px;margin:0 0 10px;flex-wrap:wrap">
    <button class="ec2-btn active" onclick="ec2Tab('option')">購入オプション</button>
    <button class="ec2-btn" onclick="ec2Tab('spot')">スポット詳細</button>
    <button class="ec2-btn" onclick="ec2Tab('placement')">プレイスメントグループ</button>
    <button class="ec2-btn" onclick="ec2Tab('pattern')">頻出パターン</button>
  </div>

  <div id="ec2-option" class="ec2-panel active">
    <div class="ec2-option-title">EC2購入オプション</div>

    <!-- メイン3オプション -->
    <div class="ec2-option-grid">
      <!-- オンデマンド -->
      <div class="ec2-option-card ec2-option-ondemand">
        <div class="ec2-option-header">
          <div class="ec2-option-name">オンデマンド</div>
          <div class="ec2-option-badge">基準価格</div>
        </div>
        <div class="ec2-option-body">
          <div class="ec2-option-point">使った分だけ秒単位で課金</div>
          <div class="ec2-option-point">予約不要・いつでも起動/停止</div>
          <div class="ec2-option-point">柔軟性最大・コスト高</div>
        </div>
        <div class="ec2-option-usecase">
          <span class="ec2-option-usecase-label">向いている</span>
          短期・テスト・開発・不定期な負荷
        </div>
      </div>

      <!-- リザーブドインスタンス -->
      <div class="ec2-option-card ec2-option-ri">
        <div class="ec2-option-header">
          <div class="ec2-option-name">リザーブドインスタンス（RI）</div>
          <div class="ec2-option-badge ec2-option-badge-save">最大72%割引</div>
        </div>
        <div class="ec2-option-body">
          <div class="ec2-option-point">1年 or 3年の予約でコスト削減</div>
          <div class="ec2-option-point">特定のインスタンスタイプを予約</div>
          <div class="ec2-option-point">前払いオプションで割引率UP</div>
        </div>
        <div class="ec2-option-usecase">
          <span class="ec2-option-usecase-label">向いている</span>
          24時間365日稼働・本番DB・基幹システム
        </div>
      </div>

      <!-- スポットインスタンス -->
      <div class="ec2-option-card ec2-option-spot">
        <div class="ec2-option-header">
          <div class="ec2-option-name">スポットインスタンス</div>
          <div class="ec2-option-badge ec2-option-badge-save">最大90%割引</div>
        </div>
        <div class="ec2-option-body">
          <div class="ec2-option-point">AWSの余剰キャパシティを利用</div>
          <div class="ec2-option-point ec2-option-warn">2分前通知で強制終了リスク</div>
          <div class="ec2-option-point">中断されても問題ない処理向け</div>
        </div>
        <div class="ec2-option-usecase">
          <span class="ec2-option-usecase-label">向いている</span>
          バッチ処理・CI/CD・機械学習
        </div>
      </div>
    </div>

    <!-- サブオプション -->
    <div class="ec2-option-sub-grid">
      <!-- Savings Plans -->
      <div class="ec2-option-card-sub ec2-option-sp">
        <div class="ec2-option-sub-header">
          <div class="ec2-option-sub-name">Savings Plans</div>
          <div class="ec2-option-badge ec2-option-badge-save">最大72%割引</div>
        </div>
        <div class="ec2-option-sub-body">
          <div class="ec2-option-point">$/時間の使用量をコミット（1年 or 3年）</div>
          <div class="ec2-option-point">インスタンスタイプ・サイズ変更OK</div>
          <div class="ec2-option-point">EC2・Lambda・Fargateに適用可能</div>
        </div>
      </div>

      <!-- Dedicated Host -->
      <div class="ec2-option-card-sub ec2-option-dedicated">
        <div class="ec2-option-sub-header">
          <div class="ec2-option-sub-name">Dedicated Host</div>
          <div class="ec2-option-badge">専用物理サーバー</div>
        </div>
        <div class="ec2-option-sub-body">
          <div class="ec2-option-point">物理サーバーを丸ごと専有</div>
          <div class="ec2-option-point">ソケット/コア単位のライセンス持ち込み（BYOL）</div>
          <div class="ec2-option-point">コンプライアンス要件対応</div>
        </div>
      </div>
    </div>

    <!-- 比較表 -->
    <div class="ec2-option-compare">
      <div class="ec2-option-compare-title">Savings Plans vs リザーブドインスタンス</div>
      <div class="ec2-option-compare-grid">
        <div class="ec2-option-compare-row ec2-option-compare-header">
          <div></div>
          <div>Savings Plans</div>
          <div>リザーブドインスタンス</div>
        </div>
        <div class="ec2-option-compare-row">
          <div class="ec2-option-compare-label">柔軟性</div>
          <div class="ec2-option-compare-good">タイプ・サイズ変更OK</div>
          <div class="ec2-option-compare-bad">特定タイプに固定</div>
        </div>
        <div class="ec2-option-compare-row">
          <div class="ec2-option-compare-label">割引率</div>
          <div>最大72%</div>
          <div class="ec2-option-compare-good">最大72%（同等〜やや高い）</div>
        </div>
        <div class="ec2-option-compare-row">
          <div class="ec2-option-compare-label">適用範囲</div>
          <div class="ec2-option-compare-good">EC2・Lambda・Fargate</div>
          <div>EC2のみ</div>
        </div>
        <div class="ec2-option-compare-row">
          <div class="ec2-option-compare-label">コミット</div>
          <div>$/時間の使用量</div>
          <div>特定インスタンス</div>
        </div>
      </div>
    </div>
  </div>

  <div id="ec2-spot" class="ec2-panel">
    <svg width="100%" viewBox="0 0 680 340">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">スポットインスタンス：最大90%割引・中断リスクあり</text>
      <rect x="40" y="50" width="600" height="68" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
      <text x="340" y="78" text-anchor="middle" font-size="13" font-weight="500" fill="#712B13">仕組み</text>
      <text x="60" y="102" font-size="12" fill="#993C1D">AWSの余剰キャパシティを格安で使う → AWSが必要になったら2分前通知で強制終了</text>
      <rect x="40"  y="140" width="270" height="120" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="175" y="168" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">向いている（中断OK）</text>
      <text x="175" y="194" text-anchor="middle" font-size="12" fill="#085041">バッチ処理</text>
      <text x="175" y="216" text-anchor="middle" font-size="12" fill="#085041">CI/CDパイプライン</text>
      <text x="175" y="238" text-anchor="middle" font-size="12" fill="#085041">機械学習の学習・画像処理</text>
      <rect x="370" y="140" width="270" height="120" rx="8" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
      <text x="505" y="168" text-anchor="middle" font-size="13" font-weight="500" fill="#791F1F">向いていない（中断NG）</text>
      <text x="505" y="194" text-anchor="middle" font-size="12" fill="#A32D2D">Webサーバー・本番DB</text>
      <text x="505" y="216" text-anchor="middle" font-size="12" fill="#A32D2D">継続的なAPI処理</text>
      <text x="505" y="238" text-anchor="middle" font-size="12" fill="#A32D2D">クリティカルな業務</text>
      <rect x="40" y="278" width="600" height="44" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="304" text-anchor="middle" font-size="12" font-weight="500" fill="#633806">SAA頻出：「コスト最小・中断許容できるバッチ」→ スポットインスタンス</text>
    </svg>
  </div>

  <div id="ec2-placement" class="ec2-panel">
    <div class="ec2-placement-title">プレイスメントグループ：インスタンスの配置戦略</div>

    <div class="ec2-placement-grid">
      <!-- Cluster -->
      <div class="ec2-placement-card ec2-placement-cluster">
        <div class="ec2-placement-card-header">
          <div class="ec2-placement-card-title">クラスター</div>
          <div class="ec2-placement-card-subtitle">Cluster</div>
        </div>
        <div class="ec2-placement-diagram">
          <div class="ec2-placement-rack">
            <div class="ec2-placement-rack-label">同一ラック</div>
            <div class="ec2-placement-instances">
              <div class="ec2-placement-instance"></div>
              <div class="ec2-placement-instance"></div>
              <div class="ec2-placement-instance"></div>
              <div class="ec2-placement-instance"></div>
            </div>
          </div>
        </div>
        <div class="ec2-placement-info">
          <div class="ec2-placement-info-row">
            <span class="ec2-placement-info-label">配置</span>
            <span class="ec2-placement-info-value">近接（同一ラック）</span>
          </div>
          <div class="ec2-placement-info-row">
            <span class="ec2-placement-info-label">目的</span>
            <span class="ec2-placement-info-value ec2-placement-highlight">⚡ 低レイテンシー</span>
          </div>
          <div class="ec2-placement-info-row">
            <span class="ec2-placement-info-label">制限</span>
            <span class="ec2-placement-info-value ec2-placement-warn">単一AZ・障害時全滅リスク</span>
          </div>
          <div class="ec2-placement-info-row">
            <span class="ec2-placement-info-label">用途</span>
            <span class="ec2-placement-info-value">HPC・機械学習・ビッグデータ</span>
          </div>
        </div>
      </div>

      <!-- Spread -->
      <div class="ec2-placement-card ec2-placement-spread">
        <div class="ec2-placement-card-header">
          <div class="ec2-placement-card-title">スプレッド</div>
          <div class="ec2-placement-card-subtitle">Spread</div>
        </div>
        <div class="ec2-placement-diagram">
          <div class="ec2-placement-racks">
            <div class="ec2-placement-rack-small">
              <div class="ec2-placement-instance"></div>
            </div>
            <div class="ec2-placement-rack-small">
              <div class="ec2-placement-instance"></div>
            </div>
            <div class="ec2-placement-rack-small">
              <div class="ec2-placement-instance"></div>
            </div>
          </div>
          <div class="ec2-placement-rack-label">異なるラック</div>
        </div>
        <div class="ec2-placement-info">
          <div class="ec2-placement-info-row">
            <span class="ec2-placement-info-label">配置</span>
            <span class="ec2-placement-info-value">分散（異なるラック）</span>
          </div>
          <div class="ec2-placement-info-row">
            <span class="ec2-placement-info-label">目的</span>
            <span class="ec2-placement-info-value ec2-placement-highlight">🛡️ 障害分離</span>
          </div>
          <div class="ec2-placement-info-row">
            <span class="ec2-placement-info-label">制限</span>
            <span class="ec2-placement-info-value ec2-placement-warn">AZあたり最大7インスタンス</span>
          </div>
          <div class="ec2-placement-info-row">
            <span class="ec2-placement-info-label">用途</span>
            <span class="ec2-placement-info-value">クリティカルな小規模アプリ</span>
          </div>
        </div>
      </div>

      <!-- Partition -->
      <div class="ec2-placement-card ec2-placement-partition">
        <div class="ec2-placement-card-header">
          <div class="ec2-placement-card-title">パーティション</div>
          <div class="ec2-placement-card-subtitle">Partition</div>
        </div>
        <div class="ec2-placement-diagram">
          <div class="ec2-placement-partitions">
            <div class="ec2-placement-partition-box">
              <div class="ec2-placement-partition-label">P1</div>
              <div class="ec2-placement-instance"></div>
              <div class="ec2-placement-instance"></div>
            </div>
            <div class="ec2-placement-partition-box">
              <div class="ec2-placement-partition-label">P2</div>
              <div class="ec2-placement-instance"></div>
              <div class="ec2-placement-instance"></div>
            </div>
            <div class="ec2-placement-partition-box">
              <div class="ec2-placement-partition-label">P3</div>
              <div class="ec2-placement-instance"></div>
              <div class="ec2-placement-instance"></div>
            </div>
          </div>
        </div>
        <div class="ec2-placement-info">
          <div class="ec2-placement-info-row">
            <span class="ec2-placement-info-label">配置</span>
            <span class="ec2-placement-info-value">パーティション単位（異なるラック）</span>
          </div>
          <div class="ec2-placement-info-row">
            <span class="ec2-placement-info-label">目的</span>
            <span class="ec2-placement-info-value ec2-placement-highlight">📊 大規模分散</span>
          </div>
          <div class="ec2-placement-info-row">
            <span class="ec2-placement-info-label">制限</span>
            <span class="ec2-placement-info-value ec2-placement-warn">AZあたり最大7パーティション</span>
          </div>
          <div class="ec2-placement-info-row">
            <span class="ec2-placement-info-label">用途</span>
            <span class="ec2-placement-info-value">Hadoop・Cassandra・Kafka</span>
          </div>
        </div>
      </div>
    </div>

    <!-- SAA note -->
    <div class="ec2-placement-note">
      <strong>SAA頻出パターン</strong>
      <div class="ec2-placement-patterns">
        <div class="ec2-placement-pattern">
          <span class="ec2-placement-q">「HPC・低レイテンシーが必要」</span>
          <span class="ec2-placement-a">→ クラスター</span>
        </div>
        <div class="ec2-placement-pattern">
          <span class="ec2-placement-q">「障害時に全滅を避けたい小規模」</span>
          <span class="ec2-placement-a">→ スプレッド</span>
        </div>
        <div class="ec2-placement-pattern">
          <span class="ec2-placement-q">「Hadoop・Cassandraなど大規模分散」</span>
          <span class="ec2-placement-a">→ パーティション</span>
        </div>
      </div>
    </div>
  </div>

  <div id="ec2-pattern" class="ec2-panel">
    <svg width="100%" viewBox="0 0 680 320">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">SAA頻出パターン</text>
      <rect x="40" y="44" width="600" height="256" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="60" y="74"  font-size="12" fill="#633806">「テスト・開発環境で短期利用」</text><text x="500" y="74"  font-size="12" font-weight="500" fill="#412402">→ オンデマンド</text>
      <line x1="40" y1="86" x2="640" y2="86" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="108" font-size="12" fill="#633806">「24時間365日稼働・1年以上継続」</text><text x="500" y="108" font-size="12" font-weight="500" fill="#412402">→ RI（1年 or 3年）</text>
      <line x1="40" y1="120" x2="640" y2="120" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="142" font-size="12" fill="#633806">「中断されてもいいバッチ・コスト最小」</text><text x="500" y="142" font-size="12" font-weight="500" fill="#412402">→ スポットインスタンス</text>
      <line x1="40" y1="154" x2="640" y2="154" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="176" font-size="12" fill="#633806">「インスタンスタイプを変えながらコスト削減」</text><text x="500" y="176" font-size="12" font-weight="500" fill="#412402">→ Savings Plans（Compute）</text>
      <line x1="40" y1="188" x2="640" y2="188" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="210" font-size="12" fill="#633806">「Windows Serverライセンスを持ち込みたい」</text><text x="500" y="210" font-size="12" font-weight="500" fill="#412402">→ Dedicated Host</text>
      <line x1="40" y1="222" x2="640" y2="222" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="244" font-size="12" fill="#633806">「本番（オンデマンド）+ バッチ（スポット）の混在」</text><text x="500" y="244" font-size="12" font-weight="500" fill="#412402">→ 混合インスタンスポリシー</text>
      <line x1="40" y1="256" x2="640" y2="256" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="282" font-size="12" fill="#633806">「Lambda・Fargate・EC2まとめてコスト削減」</text><text x="500" y="282" font-size="12" font-weight="500" fill="#412402">→ Savings Plans（Compute SP）</text>
    </svg>
  </div>
</div>

<script>
  function ec2Tab(t: string) {
    document.querySelectorAll('[id^="ec2-"]').forEach(el => el.classList.remove('active'));
    document.getElementById('ec2-' + t)?.classList.add('active');
    document.querySelectorAll('.ec2-btn').forEach(el => el.classList.remove('active'));
    (event?.target as HTMLElement)?.classList.add('active');
  }
  (window as any).ec2Tab = ec2Tab;
</script>

<style>
  /* 購入オプション */
  .ec2-option-title {
    font-size: 16px;
    font-weight: 600;
    text-align: center;
    margin-bottom: 16px;
    color: var(--text);
  }
  .ec2-option-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    max-width: 800px;
    margin: 0 auto 16px;
  }
  @media (max-width: 700px) {
    .ec2-option-grid {
      grid-template-columns: 1fr;
    }
  }
  .ec2-option-card {
    padding: 14px;
    border-radius: 10px;
    border: 2px solid;
    display: flex;
    flex-direction: column;
  }
  .ec2-option-ondemand {
    background: #f3f4f6;
    border-color: #9ca3af;
  }
  .dark .ec2-option-ondemand {
    background: rgba(156, 163, 175, 0.1);
    border-color: #6b7280;
  }
  .ec2-option-ri {
    background: #dbeafe;
    border-color: #3b82f6;
  }
  .dark .ec2-option-ri {
    background: rgba(59, 130, 246, 0.1);
    border-color: #60a5fa;
  }
  .ec2-option-spot {
    background: #fef3c7;
    border-color: #f59e0b;
  }
  .dark .ec2-option-spot {
    background: rgba(245, 158, 11, 0.15);
    border-color: #fbbf24;
  }
  .ec2-option-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 10px;
  }
  .ec2-option-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }
  .ec2-option-badge {
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(0,0,0,0.1);
    color: #374151;
    white-space: nowrap;
  }
  .dark .ec2-option-badge {
    background: rgba(255,255,255,0.1);
    color: #d1d5db;
  }
  .ec2-option-badge-save {
    background: #059669;
    color: #fff;
  }
  .dark .ec2-option-badge-save {
    background: #10b981;
  }
  .ec2-option-body {
    flex: 1;
    margin-bottom: 10px;
  }
  .ec2-option-point {
    font-size: 12px;
    color: #374151;
    margin-bottom: 4px;
    padding-left: 12px;
    position: relative;
  }
  .dark .ec2-option-point {
    color: #d1d5db;
  }
  .ec2-option-point::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #6b7280;
  }
  .ec2-option-warn {
    color: #dc2626;
  }
  .dark .ec2-option-warn {
    color: #f87171;
  }
  .ec2-option-usecase {
    font-size: 11px;
    padding: 8px;
    background: rgba(0,0,0,0.05);
    border-radius: 6px;
    color: #374151;
  }
  .dark .ec2-option-usecase {
    background: rgba(255,255,255,0.05);
    color: #d1d5db;
  }
  .ec2-option-usecase-label {
    font-weight: 600;
    color: #059669;
    margin-right: 4px;
  }
  .dark .ec2-option-usecase-label {
    color: #34d399;
  }
  /* サブオプション */
  .ec2-option-sub-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    max-width: 800px;
    margin: 0 auto 16px;
  }
  @media (max-width: 600px) {
    .ec2-option-sub-grid {
      grid-template-columns: 1fr;
    }
  }
  .ec2-option-card-sub {
    padding: 12px;
    border-radius: 8px;
    border: 1px solid;
  }
  .ec2-option-sp {
    background: #ecfdf5;
    border-color: #10b981;
  }
  .dark .ec2-option-sp {
    background: rgba(16, 185, 129, 0.1);
    border-color: #34d399;
  }
  .ec2-option-dedicated {
    background: #fdf4ff;
    border-color: #a855f7;
  }
  .dark .ec2-option-dedicated {
    background: rgba(168, 85, 247, 0.1);
    border-color: #c084fc;
  }
  .ec2-option-sub-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .ec2-option-sub-name {
