---
<style>
.ctrl-btn{cursor:pointer;font-size:12px;padding:4px 12px;border-radius:6px;border:1px solid #e5e7eb;background:#f9fafb;color:#111827;font-family:inherit;}
.dark .ctrl-btn{border-color:#374151;background:#1f2937;color:#f9fafb;}
.ctrl-btn.active{background:#534AB7;color:#fff;border-color:#534AB7;}
#scenario-label{font-size:12px;color:#6b7280;margin-left:8px;}
</style>

<div style="display:flex;gap:6px;margin:0 0 8px;flex-wrap:wrap;align-items:center;">
  <button class="ctrl-btn active" id="btn-inbound"  onclick="setMode('inbound')">インターネット → EC2</button>
  <button class="ctrl-btn"        id="btn-nat"      onclick="setMode('nat')">プライベートEC2 → NAT</button>
  <button class="ctrl-btn"        id="btn-failover" onclick="setMode('failover')">マルチAZ フェイルオーバー</button>
  <span id="scenario-label">インターネットからパブリックEC2への通信</span>
</div>

<svg id="vpc-svg" width="100%" viewBox="0 0 680 480">
  <defs>
    <marker id="vpc-anim-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
  </defs>

  <!-- Internet -->
  <rect x="270" y="10" width="140" height="36" rx="8" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/>
  <text x="340" y="32" text-anchor="middle" font-size="13" font-weight="500" fill="#2C2C2A" dominant-baseline="central">インターネット</text>

  <!-- IGW -->
  <rect x="255" y="62" width="170" height="36" rx="8" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5" id="igw-box"/>
  <text x="340" y="84" text-anchor="middle" font-size="13" font-weight="500" fill="#2C2C2A" dominant-baseline="central">Internet Gateway</text>

  <!-- static base lines -->
  <line x1="340" y1="46"  x2="340" y2="62"  stroke="#D3D1C7" stroke-width="1"/>
  <line x1="280" y1="98"  x2="160" y2="148" stroke="#D3D1C7" stroke-width="1"/>
  <line x1="400" y1="98"  x2="520" y2="148" stroke="#D3D1C7" stroke-width="1"/>

  <!-- VPC border -->
  <rect x="20" y="110" width="640" height="358" rx="14" fill="none" stroke="#639922" stroke-width="1.5" stroke-dasharray="8 4"/>
  <text x="34" y="128" font-size="12" fill="#3B6D11">VPC</text>

  <!-- AZ1 -->
  <rect x="30"  y="134" width="300" height="324" rx="10" fill="none" stroke="#378ADD" stroke-width="1" stroke-dasharray="5 3"/>
  <text x="42" y="150" font-size="12" fill="#185FA5">AZ 1</text>

  <!-- AZ2 -->
  <rect x="350" y="134" width="300" height="324" rx="10" fill="none" stroke="#378ADD" stroke-width="1" stroke-dasharray="5 3"/>
  <text x="362" y="150" font-size="12" fill="#185FA5">AZ 2</text>

  <!-- Public subnet AZ1 -->
  <rect x="40"  y="156" width="278" height="110" rx="8" fill="none" stroke="#1D9E75" stroke-width="1"/>
  <text x="52" y="172" font-size="12" fill="#085041">Public Subnet</text>

  <!-- Public EC2 AZ1 -->
  <g id="pub-ec2-1">
    <rect x="52"  y="178" width="100" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
    <text x="102" y="196" text-anchor="middle" font-size="13" font-weight="500" fill="#085041" dominant-baseline="central">EC2</text>
    <text x="102" y="212" text-anchor="middle" font-size="11" fill="#085041" dominant-baseline="central">Webサーバー</text>
  </g>

  <!-- NAT GW AZ1 -->
  <g id="nat-1">
    <rect x="184" y="178" width="120" height="44" rx="6" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
    <text x="244" y="196" text-anchor="middle" font-size="13" font-weight="500" fill="#633806" dominant-baseline="central">NAT GW</text>
    <text x="244" y="212" text-anchor="middle" font-size="11" fill="#633806" dominant-baseline="central">アウトバウンド</text>
  </g>

  <!-- Public subnet AZ2 -->
  <rect x="362" y="156" width="278" height="110" rx="8" fill="none" stroke="#1D9E75" stroke-width="1"/>
  <text x="374" y="172" font-size="12" fill="#085041">Public Subnet</text>

  <!-- Public EC2 AZ2 -->
  <g id="pub-ec2-2">
    <rect x="374" y="178" width="100" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
    <text x="424" y="196" text-anchor="middle" font-size="13" font-weight="500" fill="#085041" dominant-baseline="central">EC2</text>
    <text x="424" y="212" text-anchor="middle" font-size="11" fill="#085041" dominant-baseline="central">Webサーバー</text>
  </g>

  <!-- NAT GW AZ2 -->
  <g id="nat-2">
    <rect x="506" y="178" width="120" height="44" rx="6" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
    <text x="566" y="196" text-anchor="middle" font-size="13" font-weight="500" fill="#633806" dominant-baseline="central">NAT GW</text>
    <text x="566" y="212" text-anchor="middle" font-size="11" fill="#633806" dominant-baseline="central">アウトバウンド</text>
  </g>

  <!-- Private subnet AZ1 -->
  <rect x="40"  y="278" width="278" height="168" rx="8" fill="none" stroke="#7F77DD" stroke-width="1"/>
  <text x="52" y="294" font-size="12" fill="#534AB7">Private Subnet</text>

  <!-- Private EC2 AZ1 -->
  <g id="priv-ec2-1">
    <rect x="52"  y="300" width="100" height="44" rx="6" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
    <text x="102" y="318" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489" dominant-baseline="central">EC2</text>
    <text x="102" y="334" text-anchor="middle" font-size="11" fill="#534AB7" dominant-baseline="central">APサーバー</text>
  </g>

  <!-- RDS AZ1 -->
  <g id="rds-1">
    <rect x="52"  y="390" width="100" height="44" rx="6" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
    <text x="102" y="408" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489" dominant-baseline="central">RDS</text>
    <text x="102" y="424" text-anchor="middle" font-size="11" fill="#534AB7" dominant-baseline="central">Primary</text>
  </g>

  <!-- Private subnet AZ2 -->
  <rect x="362" y="278" width="278" height="168" rx="8" fill="none" stroke="#7F77DD" stroke-width="1"/>
  <text x="374" y="294" font-size="12" fill="#534AB7">Private Subnet</text>

  <!-- Private EC2 AZ2 -->
  <g id="priv-ec2-2">
    <rect x="374" y="300" width="100" height="44" rx="6" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
    <text x="424" y="318" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489" dominant-baseline="central">EC2</text>
    <text x="424" y="334" text-anchor="middle" font-size="11" fill="#534AB7" dominant-baseline="central">APサーバー</text>
  </g>

  <!-- RDS AZ2 -->
  <g id="rds-2">
    <rect x="374" y="390" width="100" height="44" rx="6" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
    <text x="424" y="408" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489" dominant-baseline="central">RDS</text>
    <text x="424" y="424" text-anchor="middle" font-size="11" fill="#534AB7" dominant-baseline="central">Standby</text>
  </g>

  <!-- Animated flow lines -->
  <line id="f1" x1="340" y1="46" x2="340" y2="62" stroke="#534AB7" stroke-width="3" stroke-dasharray="8 6" stroke-dashoffset="40" fill="none" marker-end="url(#vpc-anim-arr)" opacity="0"/>
  <line id="f2" x1="280" y1="98" x2="155" y2="178" stroke="#1D9E75" stroke-width="3" stroke-dasharray="8 6" stroke-dashoffset="40" fill="none" marker-end="url(#vpc-anim-arr)" opacity="0"/>
  <line id="f3" x1="102" y1="222" x2="102" y2="300" stroke="#1D9E75" stroke-width="3" stroke-dasharray="8 6" stroke-dashoffset="40" fill="none" marker-end="url(#vpc-anim-arr)" opacity="0"/>
  <line id="f4" x1="184" y1="322" x2="244" y2="222" stroke="#EF9F27" stroke-width="3" stroke-dasharray="8 6" stroke-dashoffset="60" fill="none" marker-end="url(#vpc-anim-arr)" opacity="0"/>
  <line id="f5" x1="244" y1="178" x2="310" y2="98" stroke="#EF9F27" stroke-width="3" stroke-dasharray="8 6" stroke-dashoffset="60" fill="none" marker-end="url(#vpc-anim-arr)" opacity="0"/>
  <line id="f6" x1="340" y1="62" x2="340" y2="46" stroke="#EF9F27" stroke-width="3" stroke-dasharray="8 6" stroke-dashoffset="40" fill="none" marker-end="url(#vpc-anim-arr)" opacity="0"/>
  <path id="f7" d="M 152 412 Q 260 460 374 412" stroke="#E24B4A" stroke-width="3" stroke-dasharray="8 6" stroke-dashoffset="80" fill="none" marker-end="url(#vpc-anim-arr)" opacity="0"/>
  <line id="f8" x1="400" y1="98" x2="424" y2="178" stroke="#1D9E75" stroke-width="3" stroke-dasharray="8 6" stroke-dashoffset="40" fill="none" marker-end="url(#vpc-anim-arr)" opacity="0"/>
  <line id="f9" x1="424" y1="222" x2="424" y2="300" stroke="#1D9E75" stroke-width="3" stroke-dasharray="8 6" stroke-dashoffset="40" fill="none" marker-end="url(#vpc-anim-arr)" opacity="0"/>

  <!-- Failure marks -->
  <text id="fail-mark-ec2" x="102" y="202" text-anchor="middle" font-size="22" fill="#E24B4A" opacity="0">✕</text>
  <text id="fail-mark-rds" x="102" y="415" text-anchor="middle" font-size="22" fill="#E24B4A" opacity="0">✕</text>

  <!-- Status text -->
  <text id="step-txt" x="340" y="468" text-anchor="middle" font-size="12" fill="#534AB7"></text>
</svg>

  <div>
    インターネット → EC2 はリクエストがIGW→パブリックEC2→プライベートEC2と降りていく流れです。<br>
    プライベートEC2 → NAT はプライベートEC2がNAT Gatewayを経由してインターネットに出ていく流れで、プライベートIPが外に出ない点がポイントです。<br>
    マルチAZフェイルオーバー はAZ1が落ちたときにRDS Standbyが昇格してAZ2で通信が継続される流れです。
  </div>

<script>
const STEPS = {
  inbound: [
    {lines:['f1'], txt:'① インターネットからIGWへ', dur:500},
    {lines:['f2'], txt:'② IGWからパブリックEC2（Webサーバー）へ', dur:600},
    {lines:['f3'], txt:'③ WebサーバーからプライベートEC2（APサーバー）へ', dur:600},
  ],
  nat: [
    {lines:['f4'], txt:'① プライベートEC2からNAT Gatewayへ', dur:600},
    {lines:['f5'], txt:'② NAT GatewayからIGWへ（送信元IPをNATに変換）', dur:600},
    {lines:['f6'], txt:'③ IGWからインターネットへ（プライベートIPは外に出ない）', dur:500},
  ],
  failover: [
    {lines:[], txt:'① AZ1で障害発生', dur:600, fn:'showFail'},
    {lines:['f7'], txt:'② RDS Primary → Standby へ自動昇格', dur:700},
    {lines:['f1'], txt:'③ インターネット → IGW', dur:500},
    {lines:['f8'], txt:'④ IGW → AZ2のEC2へ切替', dur:600},
    {lines:['f9'], txt:'⑤ AZ2で通常通り処理継続', dur:600},
  ],
};

const LABELS = {
  inbound:  'インターネットからパブリックEC2への通信',
  nat:      'プライベートEC2がNATを経由してインターネットへ',
  failover: 'AZ1障害時のマルチAZフェイルオーバー',
};

let mode = 'inbound';

function getEl(id){ return document.getElementById(id); }

function resetAll(){
  ['f1','f2','f3','f4','f5','f6','f7','f8','f9'].forEach(id=>{
    const el = getEl(id);
    el.style.transition='none';
    el.setAttribute('opacity','0');
    const orig = id==='f7' ? '80' : (id==='f4'||id==='f5' ? '60' : '40');
    el.setAttribute('stroke-dashoffset', orig);
  });
  getEl('fail-mark-ec2').setAttribute('opacity','0');
  getEl('fail-mark-rds').setAttribute('opacity','0');
  getEl('pub-ec2-1').style.opacity='1';
  getEl('rds-1').style.opacity='1';
}

function animLine(id, dur, cb){
  const el = getEl(id);
  const offset = el.getAttribute('stroke-dashoffset');
  el.style.transition='none';
  el.setAttribute('stroke-dashoffset', offset);
  el.setAttribute('opacity','1');
  requestAnimationFrame(()=>requestAnimationFrame(()=>{
    el.style.transition=`stroke-dashoffset ${dur}ms linear`;
    el.setAttribute('stroke-dashoffset','0');
    setTimeout(()=>{ el.setAttribute('opacity','0'); el.style.transition='none'; if(cb)cb(); }, dur+100);
  }));
}

function showFail(cb){
  getEl('pub-ec2-1').style.opacity='0.3';
  getEl('rds-1').style.opacity='0.3';
  getEl('fail-mark-ec2').setAttribute('opacity','1');
  getEl('fail-mark-rds').setAttribute('opacity','1');
  setTimeout(cb, 700);
}

let currentSteps = null;

function runSteps(steps, idx){
  if(steps !== currentSteps) return;
  if(idx >= steps.length){ setTimeout(()=>runSteps(steps,0), 1000); return; }
  const s = steps[idx];
  getEl('step-txt').textContent = s.txt;
  const next = ()=>setTimeout(()=>runSteps(steps, idx+1), 300);
  if(s.fn === 'showFail'){
    showFail(next);
  } else if(s.lines.length === 0){
    setTimeout(next, s.dur);
  } else {
    let remaining = s.lines.length;
    s.lines.forEach(id=>animLine(id, s.dur, ()=>{ remaining--; if(remaining===0) next(); }));
  }
}

function setMode(m){
  mode = m;
  ['inbound','nat','failover'].forEach(id=>{
    const btn = getEl('btn-'+id);
    if(btn) btn.classList.toggle('active', id===m);
  });
  const label = getEl('scenario-label');
  if(label) label.textContent = LABELS[m];
  resetAll();
  currentSteps = STEPS[m];
  setTimeout(()=>runSteps(currentSteps, 0), 400);
}

currentSteps = STEPS[mode];
runSteps(currentSteps, 0);
</script>