---
---
<div>
  <style>
    .cfn-btn{cursor:pointer;font-size:12px;padding:4px 12px;border-radius:6px;border:1px solid #e5e7eb;background:#f9fafb;color:#111827;font-family:inherit;}
    .dark .cfn-btn{border-color:#374151;background:#1f2937;color:#f9fafb;}
    .cfn-btn.active{background:#534AB7;color:#fff;border-color:#534AB7;}
    .cfn-panel{display:none;}
    .cfn-panel.active{display:block;}
  </style>

  <div style="display:flex;gap:6px;margin:0 0 10px;flex-wrap:wrap">
    <button class="cfn-btn active" onclick="cfnTab('overview')">CloudFormationとは</button>
    <button class="cfn-btn" onclick="cfnTab('template')">テンプレート構造</button>
    <button class="cfn-btn" onclick="cfnTab('compare')">関連サービス比較</button>
  </div>

  <div id="cfn-overview" class="cfn-panel active">
    <svg width="100%" viewBox="0 0 680 360">
      <defs><marker id="cfn-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">AWS CloudFormation：IaC（Infrastructure as Code）</text>
      <rect x="40" y="50" width="160" height="180" rx="8" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/>
      <text x="120" y="78" text-anchor="middle" font-size="13" font-weight="500" fill="#444441">テンプレート</text>
      <text x="120" y="102" text-anchor="middle" font-size="12" fill="#5F5E5A">YAML / JSON</text>
      <text x="120" y="132" text-anchor="middle" font-size="12" fill="#5F5E5A">「VPC・EC2・RDS</text>
      <text x="120" y="152" text-anchor="middle" font-size="12" fill="#5F5E5A">を作る」という</text>
      <text x="120" y="172" text-anchor="middle" font-size="12" fill="#5F5E5A">設計書をコードで</text>
      <text x="120" y="192" text-anchor="middle" font-size="12" fill="#5F5E5A">記述</text>
      <line x1="200" y1="140" x2="238" y2="140" stroke="#888780" stroke-width="1.5" marker-end="url(#cfn-arr)"/>
      <rect x="240" y="100" width="160" height="80" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/>
      <text x="320" y="130" text-anchor="middle" font-size="13" font-weight="500" fill="#0C447C">CloudFormation</text>
      <text x="320" y="154" text-anchor="middle" font-size="12" fill="#185FA5">テンプレートを読み</text>
      <text x="320" y="172" text-anchor="middle" font-size="11" fill="#185FA5">リソースを自動作成</text>
      <line x1="400" y1="128" x2="438" y2="88"  stroke="#185FA5" stroke-width="1.5" marker-end="url(#cfn-arr)"/>
      <line x1="400" y1="140" x2="438" y2="140" stroke="#185FA5" stroke-width="1.5" marker-end="url(#cfn-arr)"/>
      <line x1="400" y1="152" x2="438" y2="192" stroke="#185FA5" stroke-width="1.5" marker-end="url(#cfn-arr)"/>
      <rect x="440" y="60"  width="120" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="500" y="86" text-anchor="middle" font-size="12" fill="#085041">VPC / サブネット</text>
      <rect x="440" y="118" width="120" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="500" y="144" text-anchor="middle" font-size="12" fill="#085041">EC2 / ALB</text>
      <rect x="440" y="176" width="120" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="500" y="202" text-anchor="middle" font-size="12" fill="#085041">RDS / S3</text>
      <rect x="40" y="250" width="600" height="88" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="340" y="278" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489">スタック：テンプレートから作成されたリソースのまとまり</text>
      <text x="340" y="302" text-anchor="middle" font-size="12" fill="#534AB7">スタックを削除すると関連リソースがすべて削除される</text>
      <text x="340" y="326" text-anchor="middle" font-size="12" fill="#534AB7">同じテンプレートで本番・開発・検証環境を簡単に複製できる</text>
    </svg>
  </div>

  <div id="cfn-template" class="cfn-panel">
    <svg width="100%" viewBox="0 0 680 340">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">テンプレートの主要セクション</text>
      <rect x="40"  y="50" width="150" height="56" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="115" y="74" text-anchor="middle" font-size="13" font-weight="500" fill="#444441">Parameters</text><text x="115" y="96" text-anchor="middle" font-size="11" fill="#5F5E5A">入力値の定義</text>
      <rect x="210" y="50" width="150" height="56" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="285" y="74" text-anchor="middle" font-size="13" font-weight="500" fill="#444441">Mappings</text><text x="285" y="96" text-anchor="middle" font-size="11" fill="#5F5E5A">環境ごとの値マップ</text>
      <rect x="380" y="50" width="150" height="56" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="455" y="74" text-anchor="middle" font-size="13" font-weight="500" fill="#444441">Conditions</text><text x="455" y="96" text-anchor="middle" font-size="11" fill="#5F5E5A">条件分岐</text>
      <rect x="550" y="50" width="90" height="56" rx="6" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="595" y="74" text-anchor="middle" font-size="13" font-weight="500" fill="#444441">Outputs</text><text x="595" y="96" text-anchor="middle" font-size="11" fill="#5F5E5A">出力値</text>
      <rect x="40" y="130" width="600" height="80" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/>
      <text x="340" y="158" text-anchor="middle" font-size="13" font-weight="500" fill="#0C447C">Resources（必須・唯一の必須セクション）</text>
      <text x="60" y="184" font-size="12" fill="#185FA5">作成するAWSリソースをすべて定義する</text>
      <text x="60" y="204" font-size="12" fill="#185FA5">Type: AWS::EC2::Instance / AWS::RDS::DBInstance / AWS::S3::Bucket など</text>
      <text x="340" y="244" text-anchor="middle" font-size="13" font-weight="500" fill="currentColor">CloudFormationのメリット</text>
      <rect x="40"  y="258" width="180" height="56" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="130" y="280" text-anchor="middle" font-size="12" fill="#085041">再現性</text><text x="130" y="302" text-anchor="middle" font-size="11" fill="#085041">同じ環境を何度でも作れる</text>
      <rect x="250" y="258" width="180" height="56" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="340" y="280" text-anchor="middle" font-size="12" fill="#085041">バージョン管理</text><text x="340" y="302" text-anchor="middle" font-size="11" fill="#085041">Gitでインフラを管理</text>
      <rect x="460" y="258" width="180" height="56" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="550" y="280" text-anchor="middle" font-size="12" fill="#085041">ドリフト検出</text><text x="550" y="302" text-anchor="middle" font-size="11" fill="#085041">手動変更を検出できる</text>
    </svg>
  </div>

  <div id="cfn-compare" class="cfn-panel">
    <svg width="100%" viewBox="0 0 680 340">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">関連サービスとの比較</text>
      <rect x="40"  y="50" width="180" height="120" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/>
      <text x="130" y="78" text-anchor="middle" font-size="13" font-weight="500" fill="#0C447C">CloudFormation</text>
      <text x="130" y="102" text-anchor="middle" font-size="12" fill="#185FA5">YAML/JSONで記述</text>
      <text x="130" y="124" text-anchor="middle" font-size="12" fill="#185FA5">AWSネイティブIaC</text>
      <text x="130" y="146" text-anchor="middle" font-size="11" fill="#185FA5">SAA試験の主役</text>
      <rect x="250" y="50" width="180" height="120" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="340" y="78" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489">AWS CDK</text>
      <text x="340" y="102" text-anchor="middle" font-size="12" fill="#534AB7">Python/TSで記述</text>
      <text x="340" y="124" text-anchor="middle" font-size="12" fill="#534AB7">最終的にCFnに変換</text>
      <text x="340" y="146" text-anchor="middle" font-size="11" fill="#534AB7">開発者向け</text>
      <rect x="460" y="50" width="180" height="120" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>
      <text x="550" y="78" text-anchor="middle" font-size="13" font-weight="500" fill="#712B13">AWS SAM</text>
      <text x="550" y="102" text-anchor="middle" font-size="12" fill="#993C1D">サーバーレス特化</text>
      <text x="550" y="124" text-anchor="middle" font-size="12" fill="#993C1D">Lambda/API GWを簡単定義</text>
      <text x="550" y="146" text-anchor="middle" font-size="11" fill="#993C1D">CFnの拡張</text>
      <rect x="40" y="190" width="600" height="68" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="340" y="216" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">Terraform（サードパーティ）との違い</text>
      <text x="60" y="242" font-size="12" fill="#085041">CloudFormation：AWS専用・無料・AWSと深く統合</text>
      <text x="60" y="262" font-size="12" fill="#085041">Terraform：マルチクラウド対応・HashiCorp製・より柔軟</text>
      <rect x="40" y="276" width="600" height="44" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="296" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">SAA頻出：「インフラをコードで管理・環境を再現したい」→ CloudFormation</text>
      <text x="340" y="314" text-anchor="middle" font-size="12" fill="#633806">ドリフト検出：手動でリソースを変更した場合にCFnテンプレートとの差分を検出できる</text>
    </svg>
  </div>
</div>

<script>
  function cfnTab(t: string) {
    document.querySelectorAll('[id^="cfn-"]').forEach(el => el.classList.remove('active'));
    document.getElementById('cfn-' + t)?.classList.add('active');
    document.querySelectorAll('.cfn-btn').forEach(el => el.classList.remove('active'));
    (event?.target as HTMLElement)?.classList.add('active');
  }
  (window as any).cfnTab = cfnTab;
</script>