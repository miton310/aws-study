---
---
<div>
  <style>
    .as-btn{cursor:pointer;font-size:12px;padding:4px 12px;border-radius:6px;border:1px solid #e5e7eb;background:#f9fafb;color:#111827;font-family:inherit;}
    .dark .as-btn{border-color:#374151;background:#1f2937;color:#f9fafb;}
    .as-btn.active{background:#534AB7;color:#fff;border-color:#534AB7;}
    .as-panel{display:none;}
    .as-panel.active{display:block;}
  </style>

  <div style="display:flex;gap:6px;margin:0 0 10px;flex-wrap:wrap">
    <button class="as-btn active" onclick="asTab('overview')">Auto Scalingとは</button>
    <button class="as-btn" onclick="asTab('policy')">スケーリングポリシー</button>
    <button class="as-btn" onclick="asTab('elb')">ELBとの連携</button>
    <button class="as-btn" onclick="asTab('lifecycle')">ライフサイクルフック</button>
    <button class="as-btn" onclick="asTab('pattern')">頻出パターン</button>
  </div>

  <div id="as-overview" class="as-panel active">
    <svg width="100%" viewBox="0 0 680 380">
      <defs><marker id="as-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">EC2 Auto Scaling：負荷に応じてEC2台数を自動調整</text>
      <text x="120" y="52" text-anchor="middle" font-size="12" fill="#085041">通常時</text>
      <rect x="40" y="62" width="160" height="100" rx="10" fill="none" stroke="#1D9E75" stroke-width="1.5" stroke-dasharray="5 3"/>
      <rect x="60"  y="80" width="120" height="36" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="120" y="102" text-anchor="middle" font-size="12" fill="#085041">EC2 × 2台</text>
      <text x="120" y="152" text-anchor="middle" font-size="11" fill="#085041">希望台数: 2</text>
      <text x="340" y="52" text-anchor="middle" font-size="12" fill="#993C1D">スパイク時（スケールアウト）</text>
      <rect x="220" y="62" width="240" height="100" rx="10" fill="none" stroke="#993C1D" stroke-width="1.5" stroke-dasharray="5 3"/>
      <rect x="234" y="80" width="100" height="36" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="284" y="102" text-anchor="middle" font-size="12" fill="#085041">EC2 × 4台</text>
      <line x1="200" y1="100" x2="220" y2="100" stroke="#993C1D" stroke-width="2" marker-end="url(#as-arr)"/>
      <text x="340" y="152" text-anchor="middle" font-size="11" fill="#993C1D">自動で台数増加</text>
      <text x="570" y="52" text-anchor="middle" font-size="12" fill="#185FA5">閑散時（スケールイン）</text>
      <rect x="490" y="62" width="160" height="100" rx="10" fill="none" stroke="#185FA5" stroke-width="1.5" stroke-dasharray="5 3"/>
      <rect x="510" y="80" width="120" height="36" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="570" y="102" text-anchor="middle" font-size="12" fill="#085041">EC2 × 1台</text>
      <line x1="460" y1="100" x2="490" y2="100" stroke="#185FA5" stroke-width="2" marker-end="url(#as-arr)"/>
      <text x="570" y="152" text-anchor="middle" font-size="11" fill="#185FA5">自動で台数削減</text>
      <text x="340" y="192" text-anchor="middle" font-size="13" font-weight="500" fill="currentColor">Auto Scalingグループの3つの設定値</text>
      <rect x="40"  y="208" width="180" height="68" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/><text x="130" y="234" text-anchor="middle" font-size="13" font-weight="500" fill="#0C447C">最小台数</text><text x="130" y="258" text-anchor="middle" font-size="12" fill="#185FA5">絶対に下回らない台数</text>
      <rect x="250" y="208" width="180" height="68" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/><text x="340" y="234" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489">希望台数</text><text x="340" y="258" text-anchor="middle" font-size="12" fill="#534AB7">通常時の目標台数</text>
      <rect x="460" y="208" width="180" height="68" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/><text x="550" y="234" text-anchor="middle" font-size="13" font-weight="500" fill="#712B13">最大台数</text><text x="550" y="258" text-anchor="middle" font-size="12" fill="#993C1D">絶対に超えない台数</text>
      <rect x="40" y="296" width="600" height="68" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="320" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">ALB + Auto Scaling + マルチAZ = SAA最頻出の高可用性構成</text>
      <text x="340" y="344" text-anchor="middle" font-size="12" fill="#633806">例: 最小1・希望2・最大10 → 負荷に応じて1〜10台の間で自動調整</text>
    </svg>
  </div>

  <div id="as-policy" class="as-panel">
    <div class="as-policy-grid">
      <div class="as-policy-card as-policy-target">
        <div class="as-policy-title">ターゲット追跡スケーリング</div>
        <div class="as-policy-desc">「CPU使用率を50%に保つ」</div>
        <div class="as-policy-note">自動で台数を調整・最もシンプル・推奨</div>
      </div>
      <div class="as-policy-card as-policy-step">
        <div class="as-policy-title">ステップスケーリング</div>
        <div class="as-policy-desc">「CPU70%超→2台追加、90%超→5台追加」</div>
        <div class="as-policy-note">段階的に細かく制御</div>
      </div>
      <div class="as-policy-card as-policy-simple">
        <div class="as-policy-title">シンプルスケーリング</div>
        <div class="as-policy-desc">アラーム発火で固定台数を追加/削除</div>
        <div class="as-policy-note">クールダウン期間後に再評価</div>
      </div>
      <div class="as-policy-card as-policy-schedule">
        <div class="as-policy-title">スケジュールスケーリング</div>
        <div class="as-policy-desc">「毎朝9時に5台、夜22時に2台」</div>
        <div class="as-policy-note">予測できる負荷パターン向け</div>
      </div>
      <div class="as-policy-card as-policy-predictive">
        <div class="as-policy-title">予測スケーリング</div>
        <div class="as-policy-desc">過去のトラフィックから将来の負荷を予測</div>
        <div class="as-policy-note">機械学習で事前にスケールアウト・スケジュールの自動版</div>
      </div>
    </div>
    <div class="as-policy-summary">
      <div class="as-policy-summary-title">SAA頻出の使い分け</div>
      <div class="as-policy-summary-desc">「メトリクスを維持」→ ターゲット追跡　「夜間は台数削減」→ スケジュール　「過去パターンから予測」→ 予測スケーリング</div>
    </div>

    <!-- スケールアウト時の起動順序 -->
    <div class="as-launch">
      <div class="as-launch-title">スケールアウト時の起動順序</div>
      <div class="as-launch-steps">
        <div class="as-launch-step">
          <div class="as-launch-step-num">1</div>
          <div class="as-launch-step-content">
            <div class="as-launch-step-title">AZ間のバランス調整</div>
            <div class="as-launch-step-desc">インスタンス数が最も少ないAZを選択</div>
          </div>
        </div>
        <div class="as-launch-arrow">↓</div>
        <div class="as-launch-step">
          <div class="as-launch-step-num">2</div>
          <div class="as-launch-step-content">
            <div class="as-launch-step-title">サブネットの選択</div>
            <div class="as-launch-step-desc">そのAZ内で設定されたサブネットから選択</div>
          </div>
        </div>
        <div class="as-launch-arrow">↓</div>
        <div class="as-launch-step">
          <div class="as-launch-step-num">3</div>
          <div class="as-launch-step-content">
            <div class="as-launch-step-title">起動テンプレートに基づき起動</div>
            <div class="as-launch-step-desc">AMI・インスタンスタイプ・SG等の設定を適用</div>
          </div>
        </div>
      </div>
      <div class="as-launch-note">
        <strong>ポイント：</strong>複数AZに分散配置することで高可用性を確保
      </div>
    </div>

    <!-- 終了ポリシー -->
    <div class="as-termination">
      <div class="as-termination-title">デフォルト終了ポリシー：スケールイン時の削除順序</div>
      <div class="as-termination-steps">
        <div class="as-termination-step">
          <div class="as-termination-step-num">1</div>
          <div class="as-termination-step-content">
            <div class="as-termination-step-title">AZ間のバランス調整</div>
            <div class="as-termination-step-desc">インスタンス数が最も多いAZから選択</div>
          </div>
        </div>
        <div class="as-termination-arrow">↓</div>
        <div class="as-termination-step">
          <div class="as-termination-step-num">2</div>
          <div class="as-termination-step-content">
            <div class="as-termination-step-title">最も古い起動設定/テンプレート</div>
            <div class="as-termination-step-desc">古いバージョンの設定を使用しているインスタンスを優先</div>
          </div>
        </div>
        <div class="as-termination-arrow">↓</div>
        <div class="as-termination-step">
          <div class="as-termination-step-num">3</div>
          <div class="as-termination-step-content">
            <div class="as-termination-step-title">次の課金時間に最も近い</div>
            <div class="as-termination-step-desc">課金サイクルの終わりに近いインスタンスを優先（コスト最適化）</div>
          </div>
        </div>
        <div class="as-termination-arrow">↓</div>
        <div class="as-termination-step">
          <div class="as-termination-step-num">4</div>
          <div class="as-termination-step-content">
            <div class="as-termination-step-title">ランダム</div>
            <div class="as-termination-step-desc">上記で絞り込めない場合はランダムに選択</div>
          </div>
        </div>
      </div>
      <div class="as-termination-note">
        <strong>カスタム終了ポリシー：</strong>OldestInstance / NewestInstance / OldestLaunchConfiguration / ClosestToNextInstanceHour / Default
      </div>
    </div>
  </div>
  <style>
    .as-policy-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      max-width: 680px;
      margin: 0 auto 24px auto;
    }
    .as-policy-card {
      background: #fff;
      border-radius: 8px;
      border: 1px solid #e5e7eb;
      box-shadow: 0 1px 2px rgba(0,0,0,0.03);
      padding: 18px 16px 14px 16px;
      min-height: 110px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .as-policy-title {
      font-size: 15px;
      font-weight: 600;
      margin-bottom: 2px;
    }
    .as-policy-desc {
      font-size: 13px;
      color: #555;
    }
    .as-policy-note {
      font-size: 12px;
      color: #888;
    }
    .as-policy-target { border-left: 5px solid #0F6E56; }
    .as-policy-step { border-left: 5px solid #534AB7; }
    .as-policy-simple { border-left: 5px solid #993C1D; }
    .as-policy-schedule { border-left: 5px solid #185FA5; }
    .as-policy-predictive { border-left: 5px solid #854F0B; background: #fffbeb; }
    .dark .as-policy-predictive { background: rgba(133, 79, 11, 0.15); }
    /* スケールアウト起動順序 */
    .as-launch {
      max-width: 680px;
      margin: 20px auto 0;
      padding: 16px;
      background: #ecfdf5;
      border: 1px solid #10b981;
      border-radius: 8px;
    }
    .dark .as-launch {
      background: rgba(16, 185, 129, 0.1);
      border-color: #34d399;
    }
    .as-launch-title {
      font-size: 14px;
      font-weight: 600;
      text-align: center;
      margin-bottom: 16px;
      color: #065f46;
    }
    .dark .as-launch-title {
      color: #6ee7b7;
    }
    .as-launch-steps {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
    .as-launch-step {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      max-width: 420px;
      padding: 10px 14px;
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
    }
    .dark .as-launch-step {
      background: #1f2937;
      border-color: #374151;
    }
    .as-launch-step-num {
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #10b981;
      color: #fff;
      border-radius: 50%;
      font-size: 14px;
      font-weight: 600;
      flex-shrink: 0;
    }
    .as-launch-step-content {
      flex: 1;
    }
    .as-launch-step-title {
      font-size: 13px;
      font-weight: 600;
      color: #1f2937;
    }
    .dark .as-launch-step-title {
      color: #f3f4f6;
    }
    .as-launch-step-desc {
      font-size: 11px;
      color: #6b7280;
      margin-top: 2px;
    }
    .as-launch-arrow {
      color: #10b981;
      font-size: 16px;
    }
    .as-launch-note {
      margin-top: 12px;
      padding: 8px 12px;
      background: #d1fae5;
      border: 1px solid #10b981;
      border-radius: 6px;
      font-size: 11px;
      color: #065f46;
      text-align: center;
    }
    .dark .as-launch-note {
      background: rgba(16, 185, 129, 0.2);
      border-color: #34d399;
      color: #6ee7b7;
    }
    .as-policy-summary {
      background: #FAEEDA;
      border: 1px solid #854F0B;
      border-radius: 8px;
      padding: 14px 16px;
      max-width: 680px;
      margin: 0 auto;
      margin-bottom: 8px;
    }
    .as-policy-summary-title {
      font-size: 14px;
      font-weight: 500;
      color: #633806;
      margin-bottom: 4px;
      text-align: center;
    }
    .as-policy-summary-desc {
      font-size: 13px;
      color: #633806;
      text-align: center;
    }
    @media (max-width: 700px) {
      .as-policy-grid {
        grid-template-columns: 1fr;
      }
    }
    /* 終了ポリシー */
    .as-termination {
      max-width: 680px;
      margin: 20px auto 0;
      padding: 16px;
      background: #fef2f2;
      border: 1px solid #fca5a5;
      border-radius: 8px;
    }
    .dark .as-termination {
      background: rgba(252, 165, 165, 0.1);
      border-color: #f87171;
    }
    .as-termination-title {
      font-size: 14px;
      font-weight: 600;
      text-align: center;
      margin-bottom: 16px;
      color: #991b1b;
    }
    .dark .as-termination-title {
      color: #fca5a5;
    }
    .as-termination-steps {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
    .as-termination-step {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      max-width: 420px;
      padding: 10px 14px;
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
    }
    .dark .as-termination-step {
      background: #1f2937;
      border-color: #374151;
    }
    .as-termination-step-num {
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #dc2626;
      color: #fff;
      border-radius: 50%;
      font-size: 14px;
      font-weight: 600;
      flex-shrink: 0;
    }
    .as-termination-step-content {
      flex: 1;
    }
    .as-termination-step-title {
      font-size: 13px;
      font-weight: 600;
      color: #1f2937;
    }
    .dark .as-termination-step-title {
      color: #f3f4f6;
    }
    .as-termination-step-desc {
      font-size: 11px;
      color: #6b7280;
      margin-top: 2px;
    }
    .as-termination-arrow {
      color: #dc2626;
      font-size: 16px;
    }
    .as-termination-note {
      margin-top: 12px;
      padding: 8px 12px;
      background: #fef3c7;
      border: 1px solid #f59e0b;
      border-radius: 6px;
      font-size: 11px;
      color: #92400e;
      text-align: center;
    }
    .dark .as-termination-note {
      background: rgba(245, 158, 11, 0.15);
      border-color: #fbbf24;
      color: #fcd34d;
    }
    /* ヘルスチェック */
    .as-health {
      max-width: 680px;
      margin: 20px auto 0;
    }
    .as-health-title {
      font-size: 15px;
      font-weight: 600;
      text-align: center;
      margin-bottom: 16px;
      color: var(--text);
    }
    .as-health-types {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 16px;
    }
    @media (max-width: 500px) {
      .as-health-types {
        grid-template-columns: 1fr;
      }
    }
    .as-health-type {
      padding: 14px;
      border-radius: 8px;
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
    }
    .dark .as-health-type {
      background: #1e293b;
      border-color: #475569;
    }
    .as-health-type.as-health-type-elb {
      background: #ecfdf5;
      border-color: #10b981;
    }
    .dark .as-health-type.as-health-type-elb {
      background: rgba(16, 185, 129, 0.1);
      border-color: #34d399;
    }
    .as-health-type-title {
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 6px;
      color: #334155;
    }
    .dark .as-health-type-title {
      color: #e2e8f0;
    }
    .as-health-type-elb .as-health-type-title {
      color: #065f46;
    }
    .dark .as-health-type-elb .as-health-type-title {
      color: #6ee7b7;
    }
    .as-health-type-desc {
      font-size: 12px;
      color: #475569;
      margin-bottom: 4px;
    }
    .dark .as-health-type-desc {
      color: #94a3b8;
    }
    .as-health-type-note {
      font-size: 11px;
      color: #64748b;
      font-style: italic;
    }
    .as-health-grace {
      padding: 16px;
      background: #eff6ff;
      border: 1px solid #3b82f6;
      border-radius: 8px;
      margin-bottom: 16px;
    }
    .dark .as-health-grace {
      background: rgba(59, 130, 246, 0.1);
      border-color: #60a5fa;
    }
    .as-health-grace-title {
      font-size: 14px;
      font-weight: 600;
      text-align: center;
      margin-bottom: 12px;
      color: #1d4ed8;
    }
    .dark .as-health-grace-title {
      color: #93c5fd;
    }
    .as-health-grace-flow {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 12px;
    }
    .as-health-grace-step {
      padding: 8px 14px;
      background: #fff;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      font-size: 12px;
      text-align: center;
      color: #374151;
    }
    .dark .as-health-grace-step {
      background: #1f2937;
      border-color: #4b5563;
      color: #e5e7eb;
    }
    .as-health-grace-step.as-health-grace-wait {
      background: #fef3c7;
      border-color: #f59e0b;
      color: #92400e;
      font-weight: 600;
    }
    .dark .as-health-grace-step.as-health-grace-wait {
      background: rgba(245, 158, 11, 0.2);
      border-color: #fbbf24;
      color: #fcd34d;
    }
    .as-health-grace-arrow {
      color: #9ca3af;
      font-size: 16px;
    }
    .as-health-grace-desc {
      font-size: 12px;
      color: #1e40af;
      line-height: 1.6;
    }
    .dark .as-health-grace-desc {
      color: #bfdbfe;
    }
    .as-health-summary {
      padding: 14px 16px;
      background: #faeeda;
      border: 1px solid #854f0b;
      border-radius: 8px;
    }
    .dark .as-health-summary {
      background: rgba(133, 79, 11, 0.15);
      border-color: #b45309;
    }
    .as-health-summary-title {
      font-size: 14px;
      font-weight: 500;
      color: #633806;
      margin-bottom: 10px;
      text-align: center;
    }
    .dark .as-health-summary-title {
      color: #fcd34d;
    }
    .as-health-summary-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .as-health-summary-row {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      padding: 4px 0;
      border-bottom: 1px solid rgba(133, 79, 11, 0.2);
    }
    .as-health-summary-row:last-child {
      border-bottom: none;
    }
    .as-health-q {
