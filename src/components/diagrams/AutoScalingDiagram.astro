    .as-pattern-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .as-pattern-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 1px solid #854F0B22;
      padding: 6px 0;
      font-size: 13px;
    }
    .as-pattern-q {
      color: #633806;
      flex: 1 1 60%;
    }
    .as-pattern-a {
      color: #412402;
      font-weight: 500;
      flex: 1 1 40%;
      text-align: right;
    }
    .as-pattern-row:last-child {
      border-bottom: none;
    }
  </style>
</div>

<script>
  function asTab(t: string) {
    document.querySelectorAll('[id^="as-"]').forEach(el => el.classList.remove('active'));
    document.getElementById('as-' + t)?.classList.add('active');
    document.querySelectorAll('.as-btn').forEach(el => el.classList.remove('active'));
    (event?.target as HTMLElement)?.classList.add('active');
  }
  (window as any).asTab = asTab;
</script>