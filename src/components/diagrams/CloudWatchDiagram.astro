---
---
<div>
  <style>
    .cw-btn{cursor:pointer;font-size:12px;padding:4px 12px;border-radius:6px;border:1px solid #e5e7eb;background:#f9fafb;color:#111827;font-family:inherit;}
    .dark .cw-btn{border-color:#374151;background:#1f2937;color:#f9fafb;}
    .cw-btn.active{background:#534AB7;color:#fff;border-color:#534AB7;}
    .cw-panel{display:none;}
    .cw-panel.active{display:block;}
  </style>

  <div style="display:flex;gap:6px;margin:0 0 10px;flex-wrap:wrap">
    <button class="cw-btn active" onclick="cwTab('overview')">全体構造</button>
    <button class="cw-btn" onclick="cwTab('metrics')">メトリクス・アラーム</button>
    <button class="cw-btn" onclick="cwTab('logs')">ログ</button>
    <button class="cw-btn" onclick="cwTab('pattern')">頻出パターン</button>
  </div>

  <div id="cw-overview" class="cw-panel active">
    <svg width="100%" viewBox="0 0 680 380">
      <defs><marker id="cw-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">Amazon CloudWatch：AWSの統合監視サービス</text>
      <rect x="220" y="44" width="240" height="56" rx="8" fill="#EAF3DE" stroke="#3B6D11" stroke-width="0.5"/>
      <text x="340" y="68" text-anchor="middle" font-size="13" font-weight="500" fill="#27500A">Amazon CloudWatch</text>
      <text x="340" y="90" text-anchor="middle" font-size="11" fill="#3B6D11">メトリクス / ログ / アラーム / イベント</text>
      <rect x="40"  y="50" width="110" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="95"  y="68" text-anchor="middle" font-size="12" fill="#085041">EC2</text><text x="95" y="84" text-anchor="middle" font-size="11" fill="#085041">CPU・ネットワーク</text>
      <rect x="40"  y="110" width="110" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="95"  y="128" text-anchor="middle" font-size="12" fill="#085041">RDS</text><text x="95" y="144" text-anchor="middle" font-size="11" fill="#085041">接続数・I/O</text>
      <rect x="40"  y="170" width="110" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="95"  y="188" text-anchor="middle" font-size="12" fill="#085041">Lambda</text><text x="95" y="204" text-anchor="middle" font-size="11" fill="#085041">実行時間・エラー</text>
      <rect x="40"  y="230" width="110" height="44" rx="6" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="95"  y="248" text-anchor="middle" font-size="12" fill="#085041">ALB</text><text x="95" y="264" text-anchor="middle" font-size="11" fill="#085041">リクエスト数</text>
      <line x1="150" y1="72"  x2="220" y2="72"  stroke="#1D9E75" stroke-width="1.5" marker-end="url(#cw-arr)"/>
      <line x1="150" y1="132" x2="220" y2="82"  stroke="#1D9E75" stroke-width="1.5" marker-end="url(#cw-arr)"/>
      <line x1="150" y1="192" x2="220" y2="88"  stroke="#1D9E75" stroke-width="1.5" marker-end="url(#cw-arr)"/>
      <line x1="150" y1="252" x2="220" y2="94"  stroke="#1D9E75" stroke-width="1.5" marker-end="url(#cw-arr)"/>
      <rect x="530" y="44"  width="120" height="44" rx="6" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/><text x="590" y="62" text-anchor="middle" font-size="12" fill="#633806">アラーム</text><text x="590" y="78" text-anchor="middle" font-size="11" fill="#854F0B">閾値超えで通知</text>
      <rect x="530" y="104" width="120" height="44" rx="6" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/><text x="590" y="122" text-anchor="middle" font-size="12" fill="#712B13">Auto Scaling</text><text x="590" y="138" text-anchor="middle" font-size="11" fill="#993C1D">台数を自動調整</text>
      <rect x="530" y="164" width="120" height="44" rx="6" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/><text x="590" y="182" text-anchor="middle" font-size="12" fill="#3C3489">SNS通知</text><text x="590" y="198" text-anchor="middle" font-size="11" fill="#534AB7">メール・Slack</text>
      <rect x="530" y="224" width="120" height="44" rx="6" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/><text x="590" y="242" text-anchor="middle" font-size="12" fill="#0C447C">Lambda実行</text><text x="590" y="258" text-anchor="middle" font-size="11" fill="#185FA5">自動修復など</text>
      <line x1="460" y1="72"  x2="530" y2="66"  stroke="#3B6D11" stroke-width="1.5" marker-end="url(#cw-arr)"/>
      <line x1="460" y1="82"  x2="530" y2="126" stroke="#3B6D11" stroke-width="1.5" marker-end="url(#cw-arr)"/>
      <line x1="460" y1="88"  x2="530" y2="186" stroke="#3B6D11" stroke-width="1.5" marker-end="url(#cw-arr)"/>
      <line x1="460" y1="94"  x2="530" y2="246" stroke="#3B6D11" stroke-width="1.5" marker-end="url(#cw-arr)"/>
      <rect x="40" y="296" width="600" height="60" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="320" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">SAA最重要：EC2のメモリ・ディスク使用率はデフォルトでは取得できない</text>
      <text x="340" y="344" text-anchor="middle" font-size="12" fill="#633806">→ CloudWatch Agent をインストールして手動で送信する必要がある</text>
    </svg>
  </div>

  <div id="cw-metrics" class="cw-panel">
    <svg width="100%" viewBox="0 0 680 360">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">メトリクスとアラーム</text>
      <rect x="40"  y="50" width="270" height="100" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/>
      <text x="175" y="78" text-anchor="middle" font-size="13" font-weight="500" fill="#0C447C">標準メトリクス（自動収集）</text>
      <text x="175" y="102" text-anchor="middle" font-size="12" fill="#185FA5">EC2: CPU使用率・ネットワーク</text>
      <text x="175" y="124" text-anchor="middle" font-size="12" fill="#185FA5">無料・デフォルトで有効</text>
      <rect x="370" y="50" width="270" height="100" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
      <text x="505" y="78" text-anchor="middle" font-size="13" font-weight="500" fill="#3C3489">カスタムメトリクス（手動送信）</text>
      <text x="505" y="102" text-anchor="middle" font-size="12" fill="#534AB7">EC2: メモリ・ディスク使用量</text>
      <text x="505" y="124" text-anchor="middle" font-size="12" fill="#534AB7">CloudWatch Agentで収集</text>
      <text x="340" y="178" text-anchor="middle" font-size="13" font-weight="500" fill="currentColor">アラームの3つの状態</text>
      <rect x="40"  y="194" width="180" height="56" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/><text x="130" y="218" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">OK</text><text x="130" y="238" text-anchor="middle" font-size="12" fill="#085041">閾値内・正常</text>
      <rect x="250" y="194" width="180" height="56" rx="8" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/><text x="340" y="218" text-anchor="middle" font-size="13" font-weight="500" fill="#791F1F">ALARM</text><text x="340" y="238" text-anchor="middle" font-size="12" fill="#A32D2D">閾値超え・アクション実行</text>
      <rect x="460" y="194" width="180" height="56" rx="8" fill="#F1EFE8" stroke="#D3D1C7" stroke-width="0.5"/><text x="550" y="218" text-anchor="middle" font-size="13" font-weight="500" fill="#444441">INSUFFICIENT_DATA</text><text x="550" y="238" text-anchor="middle" font-size="12" fill="#5F5E5A">データ不足・起動直後</text>
      <rect x="40" y="270" width="600" height="68" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="294" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">SAA頻出ポイント</text>
      <text x="60" y="318" font-size="12" fill="#633806">EC2のメモリ・ディスク使用率はデフォルトでは取得できない → CloudWatch Agentが必要</text>
    </svg>
  </div>

  <div id="cw-logs" class="cw-panel">
    <svg width="100%" viewBox="0 0 680 340">
      <defs><marker id="cw-arr2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">CloudWatch Logs：ログの収集・分析・保管</text>
      <rect x="40"  y="50" width="150" height="56" rx="8" fill="#EAF3DE" stroke="#3B6D11" stroke-width="0.5"/>
      <text x="115" y="74" text-anchor="middle" font-size="13" font-weight="500" fill="#27500A">ロググループ</text>
      <text x="115" y="96" text-anchor="middle" font-size="11" fill="#3B6D11">サービス単位</text>
      <line x1="190" y1="78" x2="228" y2="78" stroke="#3B6D11" stroke-width="1.5" marker-end="url(#cw-arr2)"/>
      <rect x="230" y="50" width="150" height="56" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="305" y="74" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">ログストリーム</text>
      <text x="305" y="96" text-anchor="middle" font-size="11" fill="#085041">インスタンス単位</text>
      <line x1="380" y1="78" x2="418" y2="78" stroke="#085041" stroke-width="1.5" marker-end="url(#cw-arr2)"/>
      <rect x="420" y="50" width="220" height="56" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
      <text x="530" y="74" text-anchor="middle" font-size="13" font-weight="500" fill="#085041">ログイベント</text>
      <text x="530" y="96" text-anchor="middle" font-size="11" fill="#085041">個々のログ行</text>
      <rect x="40"  y="130" width="190" height="68" rx="6" fill="#EAF3DE" stroke="#3B6D11" stroke-width="0.5"/>
      <text x="135" y="154" text-anchor="middle" font-size="12" font-weight="500" fill="#27500A">メトリクスフィルター</text>
      <text x="135" y="176" text-anchor="middle" font-size="11" fill="#3B6D11">ログからメトリクスを生成</text>
      <text x="135" y="192" text-anchor="middle" font-size="11" fill="#3B6D11">エラー数をカウントなど</text>
      <rect x="250" y="130" width="190" height="68" rx="6" fill="#EAF3DE" stroke="#3B6D11" stroke-width="0.5"/>
      <text x="345" y="154" text-anchor="middle" font-size="12" font-weight="500" fill="#27500A">Logs Insights</text>
      <text x="345" y="176" text-anchor="middle" font-size="11" fill="#3B6D11">SQLライクなクエリで分析</text>
      <text x="345" y="192" text-anchor="middle" font-size="11" fill="#3B6D11">大量ログを高速検索</text>
      <rect x="460" y="130" width="190" height="68" rx="6" fill="#EAF3DE" stroke="#3B6D11" stroke-width="0.5"/>
      <text x="555" y="154" text-anchor="middle" font-size="12" font-weight="500" fill="#27500A">保持期間設定</text>
      <text x="555" y="176" text-anchor="middle" font-size="11" fill="#3B6D11">1日〜無期限</text>
      <text x="555" y="192" text-anchor="middle" font-size="11" fill="#3B6D11">コスト最適化に重要</text>
      <rect x="40" y="222" width="600" height="96" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="340" y="246" text-anchor="middle" font-size="13" font-weight="500" fill="#633806">ログの出力先・SAA頻出</text>
      <text x="60" y="270" font-size="12" fill="#633806">「VPC Flow Logs → CloudWatch Logs → 不審な通信を検知」</text>
      <text x="60" y="292" font-size="12" fill="#633806">「Lambdaのエラーログを分析したい」→ Logs Insights</text>
      <text x="60" y="314" font-size="12" fill="#633806">「AWSの操作履歴を記録・監査したい」→ CloudTrail（CloudWatchではない）</text>
    </svg>
  </div>

  <div id="cw-pattern" class="cw-panel">
    <svg width="100%" viewBox="0 0 680 340">
      <text x="340" y="26" text-anchor="middle" font-size="14" font-weight="500" fill="currentColor">SAA頻出パターン</text>
      <rect x="40" y="44" width="600" height="276" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
      <text x="60" y="74"  font-size="12" fill="#633806">「EC2のCPU高騰時にAuto Scalingで台数を増やしたい」</text><text x="520" y="74"  font-size="12" font-weight="500" fill="#412402">→ アラーム + AS</text>
      <line x1="40" y1="86" x2="640" y2="86" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="108" font-size="12" fill="#633806">「EC2のメモリ使用率を監視したい」</text><text x="520" y="108" font-size="12" font-weight="500" fill="#412402">→ CloudWatch Agent</text>
      <line x1="40" y1="120" x2="640" y2="120" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="142" font-size="12" fill="#633806">「障害発生時にメールで通知したい」</text><text x="520" y="142" font-size="12" font-weight="500" fill="#412402">→ アラーム + SNS</text>
      <line x1="40" y1="154" x2="640" y2="154" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="176" font-size="12" fill="#633806">「Lambdaのエラーログを分析したい」</text><text x="520" y="176" font-size="12" font-weight="500" fill="#412402">→ Logs Insights</text>
      <line x1="40" y1="188" x2="640" y2="188" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="210" font-size="12" fill="#633806">「ログからエラー件数をグラフ化したい」</text><text x="520" y="210" font-size="12" font-weight="500" fill="#412402">→ メトリクスフィルター</text>
      <line x1="40" y1="222" x2="640" y2="222" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="244" font-size="12" fill="#633806">「毎日決まった時間にLambdaを実行したい」</text><text x="520" y="244" font-size="12" font-weight="500" fill="#412402">→ EventBridge</text>
      <line x1="40" y1="256" x2="640" y2="256" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="278" font-size="12" fill="#633806">「AWSの操作履歴を記録・監査したい」</text><text x="520" y="278" font-size="12" font-weight="500" fill="#412402">→ CloudTrail</text>
      <line x1="40" y1="290" x2="640" y2="290" stroke="#854F0B" stroke-width="0.5" opacity="0.4"/>
      <text x="60" y="312" font-size="12" fill="#633806">「アプリのパフォーマンスをトレースしたい」</text><text x="520" y="312" font-size="12" font-weight="500" fill="#412402">→ AWS X-Ray</text>
    </svg>
  </div>
</div>

<script>
  function cwTab(t: string) {
    document.querySelectorAll('[id^="cw-"]').forEach(el => el.classList.remove('active'));
    document.getElementById('cw-' + t)?.classList.add('active');
    document.querySelectorAll('.cw-btn').forEach(el => el.classList.remove('active'));
    (event?.target as HTMLElement)?.classList.add('active');
  }
  (window as any).cwTab = cwTab;
</script>